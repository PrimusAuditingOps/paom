<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="create_assignation_ticket_view_form" model="ir.ui.view">
        <field name="name">create.assignation.ticket.view.form</field>
        <field name="model">create.assignation.ticket</field>
        <field name="arch" type="xml">
            <form string="Create Assignation Ticket">
                <group>
                    <field name="subject" placeholder="Subject..." required="True"/>
                </group>
                <field name="body" options="{'style-inline': true}"/>
                <group col="4">
                    <field name="attachment_ids" widget="many2many_binary" string="Attach a file" nolabel="1" colspan="2"/>
                    <!-- <field name="template_id" options="{'no_create': True}" context="{'default_model': model, 'default_body_html': body, 'default_subject': subject}"/> -->
                </group>
                <footer>
                    <button string="Send" name="create_ticket" type="object" class="btn-primary"/>
                    <button string="Cancel" class="btn-secondary" special="cancel"/>
                </footer>
            </form>
        </field>
    </record>

</odoo>