<?xml version="1.0" encoding="utf-8"?>
<odoo noupdate="1">
    <record model="ir.rule" id="pao_season_filter_read_rule">
        <field name="name">PAO Season Filter: propios o compartidos</field>
        <field name="model_id" ref="model_pao_season_filter"/>
        <field name="global" eval="True"/>
        <field name="perm_read" eval="True"/>
        <field name="perm_write" eval="False"/>
        <field name="perm_create" eval="False"/>
        <field name="perm_unlink" eval="False"/>
        <field name="domain_force">['|', ('user_id', '=', user.id), ('is_shared', '=', True)]</field>
    </record>
    <record model="ir.rule" id="pao_season_filter_write_rule">
        <field name="name">PAO Season Filter: solo el propietario modifica</field>
        <field name="model_id" ref="model_pao_season_filter"/>
        <field name="global" eval="True"/>
        <field name="perm_read" eval="False"/>
        <field name="perm_write" eval="True"/>
        <field name="perm_create" eval="True"/>
        <field name="perm_unlink" eval="True"/>
        <field name="domain_force">[('user_id', '=', user.id)]</field>
    </record>
</odoo>
