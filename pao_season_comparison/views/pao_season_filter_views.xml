<odoo>

  <record id="pao_season_filter_view_tree" model="ir.ui.view">
    <field name="name">pao.season.filter.view.tree</field>
    <field name="model">pao.season.filter</field>
    <field name="arch" type="xml">
      <tree string="Filtros de los comparativos">
        <field name="name"/>
        <field name="report_type"/>
        <field name="user_id"/>
        <field name="is_shared"/>
      </tree>
    </field>
  </record>

  <record id="pao_season_filter_view_form" model="ir.ui.view">
    <field name="name">pao.season.filter.view.form</field>
    <field name="model">pao.season.filter</field>
    <field name="arch" type="xml">
      <form string="Filtro del comparativo">
        <sheet>
          <group>
            <field name="name"/>
            <field name="report_type"/>
            <field name="user_id" readonly="1"/>
            <field name="is_shared"/>
            <field name="model_name" invisible="1"/>
          </group>
          <field name="domain" widget="domain" options="{'model': 'model_name'}"/>
        </sheet>
      </form>
    </field>
  </record>

  <record id="action_pao_season_filter_billing" model="ir.actions.act_window">
    <field name="name">Filtros del Comparativo de Facturación</field>
    <field name="res_model">pao.season.filter</field>
    <field name="view_mode">tree,form</field>
    <field name="domain">[('report_type', '=', 'billing')]</field>
    <field name="context">{'default_report_type': 'billing'}</field>
  </record>

  <record id="action_pao_season_filter_coordination" model="ir.actions.act_window">
    <field name="name">Filtros del Comparativo de Coordinación</field>
    <field name="res_model">pao.season.filter</field>
    <field name="view_mode">tree,form</field>
    <field name="domain">[('report_type', '=', 'coordination')]</field>
    <field name="context">{'default_report_type': 'coordination'}</field>
  </record>

  <menuitem id="pao_season_filter_billing_menu"
            name="Filtros del Comparativo de Facturación"
            parent="sale.menu_sales_config"
            action="action_pao_season_filter_billing"
            groups="sales_team.group_sale_manager"
            sequence="91"/>

  <menuitem id="pao_season_filter_coordination_menu"
            name="Filtros del Comparativo de Coordinación"
            parent="purchase.menu_purchase_config"
            action="action_pao_season_filter_coordination"
            groups="purchase.group_purchase_manager"
            sequence="96"/>

</odoo>
