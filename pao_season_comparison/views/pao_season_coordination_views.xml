<odoo>

  <record id="pao_season_coordination_wizard_view_form" model="ir.ui.view">
    <field name="name">pao.season.coordination.wizard.view.form</field>
    <field name="model">pao.season.coordination.wizard</field>
    <field name="arch" type="xml">
      <form string="Comparativo de Coordinación por Temporada">
        <sheet>
          <div class="oe_title">
            <h1>Comparativo de Coordinación por Temporada</h1>
          </div>
          <group>
            <group string="Temporadas a comparar">
              <field name="year_a" widget="char"/>
              <field name="season_a_range" string="Periodo"/>
              <field name="year_b" widget="char"/>
              <field name="season_b_range" string="Periodo"/>
            </group>
            <group string="Filtros (opcional)">
              <field name="scheme_ids" widget="many2many_tags" options="{'no_create': True}"/>
              <field name="coordinator_ids" widget="many2many_tags" options="{'no_create': True}" domain="[('share', '=', False)]"/>
            </group>
          </group>
          <div class="d-flex flex-wrap gap-2 mb-3">
            <button string="Ver reporte en pantalla" type="object" name="action_generate_report" class="btn-primary"/>
            <button string="Ver en lista dinámica" type="object" name="action_open_list" class="btn-primary"/>
            <button string="Descargar Excel" type="object" name="action_export_excel" class="btn-secondary"/>
          </div>
          <field name="report_html" widget="html" options="{'sanitize': false}" invisible="not report_html"/>
        </sheet>
      </form>
    </field>
  </record>

  <record id="action_pao_season_coordination_wizard" model="ir.actions.act_window">
    <field name="name">Comparativo de Coordinación por Temporada</field>
    <field name="res_model">pao.season.coordination.wizard</field>
    <field name="view_mode">form</field>
    <field name="target">current</field>
  </record>

  <record id="pao_season_coordination_line_view_tree" model="ir.ui.view">
    <field name="name">pao.season.coordination.line.view.tree</field>
    <field name="model">pao.season.coordination.line</field>
    <field name="arch" type="xml">
      <tree string="Coordinación por Temporada" create="false" edit="false" delete="false">
        <field name="coordinator_id"/>
        <field name="scheme_id"/>
        <field name="partner_id"/>
        <field name="group_id" optional="show"/>
        <field name="promotor_id" optional="show"/>
        <field name="region_id" optional="hide"/>
        <field name="status" widget="badge" decoration-danger="status == 'lost'" decoration-success="status == 'new'" decoration-info="status == 'kept'"/>
        <field name="qty_a" sum="Total"/>
        <field name="qty_b" sum="Total"/>
        <field name="var_qty" widget="percentage" decoration-danger="var_qty &lt; 0" decoration-success="var_qty &gt; 0"/>
        <field name="diff_qty" optional="show" sum="Total"/>
        <field name="m09_a" optional="hide"/><field name="m09_b" optional="hide"/>
        <field name="m10_a" optional="hide"/><field name="m10_b" optional="hide"/>
        <field name="m11_a" optional="hide"/><field name="m11_b" optional="hide"/>
        <field name="m12_a" optional="hide"/><field name="m12_b" optional="hide"/>
        <field name="m01_a" optional="hide"/><field name="m01_b" optional="hide"/>
        <field name="m02_a" optional="hide"/><field name="m02_b" optional="hide"/>
        <field name="m03_a" optional="hide"/><field name="m03_b" optional="hide"/>
        <field name="m04_a" optional="hide"/><field name="m04_b" optional="hide"/>
        <field name="m05_a" optional="hide"/><field name="m05_b" optional="hide"/>
        <field name="m06_a" optional="hide"/><field name="m06_b" optional="hide"/>
        <field name="m07_a" optional="hide"/><field name="m07_b" optional="hide"/>
        <field name="m08_a" optional="hide"/><field name="m08_b" optional="hide"/>
      </tree>
    </field>
  </record>

  <record id="pao_season_coordination_line_view_search" model="ir.ui.view">
    <field name="name">pao.season.coordination.line.view.search</field>
    <field name="model">pao.season.coordination.line</field>
    <field name="arch" type="xml">
      <search string="Coordinación por Temporada">
        <field name="coordinator_id"/>
        <field name="partner_id"/>
        <field name="scheme_id"/>
        <field name="group_id"/>
        <field name="promotor_id"/>
        <field name="region_id"/>
        <filter name="lost" string="Dejaron de coordinar" domain="[('status', '=', 'lost')]"/>
        <filter name="new" string="Nuevos coordinados" domain="[('status', '=', 'new')]"/>
        <filter name="kept" string="Siguen coordinando" domain="[('status', '=', 'kept')]"/>
        <separator/>
        <filter name="decreased" string="Bajaron en cantidad" domain="[('diff_qty', '&lt;', 0)]"/>
        <filter name="increased" string="Subieron en cantidad" domain="[('diff_qty', '&gt;', 0)]"/>
        <group expand="0" string="Agrupar por">
          <filter name="group_coordinator" string="Coordinador" context="{'group_by': 'coordinator_id'}"/>
          <filter name="group_scheme" string="Esquema" context="{'group_by': 'scheme_id'}"/>
          <filter name="group_partner" string="Cliente" context="{'group_by': 'partner_id'}"/>
          <filter name="group_group" string="Grupo" context="{'group_by': 'group_id'}"/>
          <filter name="group_promotor" string="Promotor" context="{'group_by': 'promotor_id'}"/>
          <filter name="group_region" string="Región" context="{'group_by': 'region_id'}"/>
          <filter name="group_status" string="Estatus" context="{'group_by': 'status'}"/>
        </group>
      </search>
    </field>
  </record>

  <record id="pao_season_coordination_line_view_pivot" model="ir.ui.view">
    <field name="name">pao.season.coordination.line.view.pivot</field>
    <field name="model">pao.season.coordination.line</field>
    <field name="arch" type="xml">
      <pivot string="Coordinación por Temporada">
        <field name="coordinator_id" type="row"/>
        <field name="qty_a" type="measure"/>
        <field name="qty_b" type="measure"/>
        <field name="diff_qty" type="measure"/>
      </pivot>
    </field>
  </record>

  <menuitem id="pao_season_coordination_menu"
            name="Comparativo de Coordinación por Temporada"
            parent="purchase.purchase_report_main"
            action="action_pao_season_coordination_wizard"
            groups="purchase.group_purchase_manager"
            sequence="95"/>

</odoo>
