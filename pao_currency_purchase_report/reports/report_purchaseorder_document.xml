<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <template id="report_purchaseorder_document_currency" inherit_id= "purchase.report_purchaseorder_document">
        <xpath expr="//table/tbody" position="inside">
            <t t-if="o.country_code == 'MX'">
                <tr class="bg-200 font-weight-bold o_line_section">
                    <td colspan="99" name="td_currency_label"><strong>ALL PRICES SHOWN 
                    IN<![CDATA[&nbsp;]]></strong><strong><span style="font-weight: bold;" t-field="o.currency_id.currency_unit_label"/></strong></td>
                </tr>
            </t>
        </xpath>
    </template>
</odoo>