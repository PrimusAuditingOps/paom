<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- ── Secuencia ENA ─────────────────────────────────────────────────── -->
    <record id="seq_ena_solicitud" model="ir.sequence">
        <field name="name">Evaluación No Anunciada</field>
        <field name="code">ena.solicitud</field>
        <field name="prefix">ENA/%(year)s/</field>
        <field name="padding">4</field>
        <field name="number_next">1</field>
        <field name="number_increment">1</field>
        <field name="company_id" eval="False"/>
    </record>

</odoo>
