<?xml version="1.0" encoding="utf-8"?>
<odoo>

<!-- ══════════════════════════════════════════════════════════════
     VISTA FORMULARIO
══════════════════════════════════════════════════════════════ -->
<record id="view_ena_solicitud_form" model="ir.ui.view">
    <field name="name">ena.solicitud.form</field>
    <field name="model">ena.solicitud</field>
    <field name="arch" type="xml">
        <form string="Evaluación No Anunciada">
            <header>
               

                <button name="action_enviar_notificacion"
                        string="Enviar Notificación"
                        type="object"
                        class="btn-primary"
                        invisible="stage not in ('asignada') or not puede_enviar_notificacion or stage in ('no_realizada')"
                        groups="pao_globalgap_ena.group_ena_coordinadora"/>
                <field name="puede_enviar_notificacion" invisible="1"/>



                <button name="%(pao_globalgap_ena.action_ena_lost_reason_wizard)d"
                        string="No se Realizará"
                        type="action"
                        class="btn-danger"
                        invisible="stage in ('realizada','no_realizada','candidato')"
                        groups="pao_globalgap_ena.group_ena_coordinadora"
                        context="{'default_ena_id': id}"/>



                <button name="action_restore" string="Restaurar"
                type="object" class="btn-primary" invisible="stage not in ('no_realizada')"
                groups="pao_globalgap_ena.group_ena_admin"/>

                <field name="stage" widget="statusbar"
                       statusbar_visible="candidato,asignada,notificada,programada,realizada"/>
            </header>

            <sheet>
                <!-- Alertas visuales -->
                <div class="alert alert-danger" role="alert" invisible="alerta_ventana != 'vencido'">
                    <strong>⚠ Ventana vencida:</strong>
                    La fecha de vencimiento del certificado ya pasó y la ENA no se ha programado.
                </div>
                <div class="alert alert-warning" role="alert" invisible="alerta_ventana != 'proximo'">
                    <strong>⚠ Ventana próxima a vencer:</strong>
                    Quedan menos de 30 días para que venza el certificado. Por favor contacte al productor.
                </div>
                <div class="alert alert-info" role="alert" invisible="stage != 'asignada' or puede_enviar_notificacion">
                    <strong>Ventana aún no abre:</strong>
                    Podrá enviar la notificación al productor a partir del <field name="inicio_ventana" readonly="1"/>.
                </div>

                
                
                <group>
                    <group string="Productor">
                            <field name="organization_id" options="{'no_create': True}" readonly="stage != 'candidato'"/>
                            <field name="justificacion" readonly="stage != 'candidato'" groups="pao_globalgap_ena.group_ena_calidad"/>
                    </group>
                    <group string="Fechas clave">
                        <field name="alerta_ventana" widget="badge" decoration-danger="alerta_ventana in ('vencido', 'proximo')" decoration-warning="alerta_ventana == 'atrasada'" decoration-success="alerta_ventana == 'ok'"/>
                        <field name="fecha_vencimiento" readonly="stage != 'candidato'"/>
                        <field name="inicio_ventana" readonly="1"/>
                        <field name="dias_para_vencer" readonly="1"/>
                        <field name="fecha_notificacion" readonly="1" invisible="not notificacion_enviada"/>
                        <field name="notificacion_enviada" invisible="1" readonly="1"/>
                        
                    </group>
                   
                </group>
                 <group invisible="1" string="Identificación">
                        <field name="anio" options="{'format': False}" readonly="stage != 'candidato'" groups="pao_globalgap_ena.group_ena_admin"/>
                        <field name="consecutivo" readonly="1"/>
                        <field name="coordinadora_id" readonly="stage not in ('candidato','por_contactar')" groups="pao_globalgap_ena.group_ena_calidad"/>
                    </group>

                <notebook>
                    
                    <!-- ── Pestaña: Datos del productor (llena CALIDAD) ── -->
                    <page string="Datos del productor" name="datos_productor">
                        <group>
                            <group string="Información del cultivo">
                                <field name="opcion" readonly="1"/>
                                <field name="shipper" groups="pao_globalgap_ena.group_ena_calidad"/>
                               
                                <field name="num_sitios" readonly="1"/>
                                <field name="num_phu" readonly="1"/>
                            </group>
                            <group string="Resultados de auditoría de certificación">
                                <field name="obligaciones_mayores" readonly="stage != 'candidato'" groups="pao_globalgap_ena.group_ena_calidad"/>
                                <field name="obligaciones_menores" readonly="stage != 'candidato'" groups="pao_globalgap_ena.group_ena_calidad"/>
                                <field name="sanciones_quejas" readonly="stage != 'candidato'" groups="pao_globalgap_ena.group_ena_calidad"/>
                                <field name="auditor_finca" readonly="stage != 'candidato'" groups="pao_globalgap_ena.group_ena_calidad"/>
                                <field name="sanciones_falta_atencion" readonly="stage not in ('candidato','por_contactar')" groups="pao_globalgap_ena.group_ena_calidad"/>
                            </group>
                        </group>
                       
                    </page>
                    <page string="Producto">
                        <field name="product_ids" widget="many2many">
                            <tree string="Producto">
                                <field name="product_id"/>
                                <field name="harvest_estimated_start_date"/>
                                <field name="harvest_estimated_end_date"/>
                                <field name="uncovered_production_area"/>

                                <field name="covered_production_area"/>
                                
                            </tree>
                        </field>
                    </page>

                    <!-- ── Pestaña: Seguimiento (llena COORDINADORA) ── -->
                    <page string="Seguimiento y programación" name="seguimiento">
                        <group>
                            <group string="Auditoría no anunciada">
                                <field name="coordinadora_id" required="stage not in ('candidato')"/>
                                <field name="purchase_order_id"/>
                                <field name="ac_audit_status"/>
                                
                                <field name="auditor_id"/>
                                <field name="audit_start_date"/>
                                <field name="audit_end_date"/>
                                <field name="lost_reason_id" readonly="1" invisible="stage != 'no_realizada'"/>
                                <field name="comments" readonly="1" invisible="stage != 'no_realizada'"/>
                                
                            </group>
                        </group>
                        
                    </page>
                </notebook>
            </sheet>


            <!-- Chatter -->
            <div class="oe_chatter">
                <field name="message_follower_ids"/>
                <field name="activity_ids"/>
                <field name="message_ids"/>
            </div>
        </form>
    </field>
</record>
<record id="view_ena_lost_reason_form" model="ir.ui.view">
    <field name="name">ena.lost.reason.form</field>
    <field name="model">ena.lost.reason</field>
    <field name="arch" type="xml">
        <form string="Motivos de no realización">
            <header>
            </header>
            <sheet>
                <group>
                    <field name="name"/>
                </group>
            </sheet>
        </form>
    </field>
</record>

<!-- ══════════════════════════════════════════════════════════════
     VISTA LISTA
══════════════════════════════════════════════════════════════ -->
<record id="view_ena_solicitud_tree" model="ir.ui.view">
    <field name="name">ena.solicitud.tree</field>
    <field name="model">ena.solicitud</field>
    <field name="arch" type="xml">
        <tree string="Auditorías No Anunciadas"
              decoration-success="stage == 'realizada'"
              decoration-warning="stage == 'no_realizada'"
              decoration-danger="alerta_ventana == 'vencido'"
              decoration-muted="stage == 'candidato'">
            <field name="consecutivo" string="#"/>
            <field name="name" string="Folio"/>
            <field name="organization_id"/>
            <field name="shipper"/>
            <field name="product_ids" widget="many2many_tags"/>
            <field name="coordinadora_id"/>
            <field name="inicio_ventana"/>
            <field name="fecha_vencimiento"/>
            <field name="dias_para_vencer" string="Días restantes"/>
            <field name="stage" widget="badge"
                   decoration-success="stage in ('realizada','programada')"
                   decoration-warning="stage == 'no_realizada'"
                   decoration-info="stage in ('notificada')"
                   decoration-muted="stage == 'candidato'"/>
            <field name="alerta_ventana" widget="badge"
                   decoration-danger="alerta_ventana in ('vencido', 'proximo')"
                   decoration-warning="alerta_ventana == 'atrasada'"
                   decoration-success="alerta_ventana == 'ok'"
                   optional="show"/>
            <field name="fecha_real_ena" optional="show"/>
            <field name="color" column_invisible="True"/>
            <field name="anio" column_invisible="True"/>
        </tree>
    </field>
</record>
<record id="view_ena_lost_reason_tree" model="ir.ui.view">
    <field name="name">ena.lost.reason.tree</field>
    <field name="model">ena.lost.reason</field>
    <field name="arch" type="xml">
        <tree string="Motivos de no realización">
            <field name="name"/>
        </tree>
    </field>
</record>
<!-- ══════════════════════════════════════════════════════════════
     VISTA KANBAN
══════════════════════════════════════════════════════════════ -->
<record id="view_ena_solicitud_kanban" model="ir.ui.view">
    <field name="name">ena.solicitud.kanban</field>
    <field name="model">ena.solicitud</field>
    <field name="arch" type="xml">
        <kanban default_group_by="stage"
                group_expand="1" 
                records_draggable="false" 
                class="o_kanban_small_column">
                <field name="color"/>
                <field name="stage"/>
                <field name="alerta_ventana"/>
                <field name="organization_id"/>
                <field name="coordinadora_id"/>
                <field name="inicio_ventana"/>
                <field name="fecha_vencimiento"/>
                <field name="dias_para_vencer"/>
                <field name="product_ids"/>
                <field name="shipper"/>
                <field name="opcion"/>
                <field name="notificacion_enviada"/>
                <templates>
                    <t t-name="kanban-box">
                        <div t-attf-class="oe_kanban_card oe_kanban_global_click                         #{ record.alerta_ventana.raw_value == 'vencido' ? 'border-danger' : '' }                         #{ record.alerta_ventana.raw_value == 'proximo' ? 'border-warning' : '' }                         #{ record.stage.raw_value == 'realizada' ? 'border-success' : '' }                         #{ record.stage.raw_value == 'no_realizada' ? 'border-secondary' : '' }">
    
                            <!-- Encabezado -->
                            <div class="oe_kanban_content">
                                <div class="o_kanban_record_top">
                                    <div class="o_kanban_record_headings">
                                        <strong class="o_kanban_record_title">
                                            <field name="organization_id"/>
                                        </strong>
                                        <small class="text-muted">
                                            <field name="shipper"/>
                                        </small>
                                    </div>
                                    <div class="o_kanban_record_top_right">
                                        <field name="alerta_ventana" widget="badge" decoration-danger="alerta_ventana in ('vencido', 'proximo')" decoration-warning="alerta_ventana == 'atrasada'" decoration-success="alerta_ventana == 'ok'"/>
                                    </div>
                                </div>
    
                                <!-- Cuerpo -->
                                <div class="o_kanban_record_body mt-1">
                                    <span class="badge bg-light text-dark me-1">
                                        <field name="opcion"/>
                                    </span>
                                    <div class="mt-1" t-if="record.coordinadora_id.raw_value">
                                        <i class="fa fa-user-o me-1"/>
                                        <field name="coordinadora_id"/>
                                    </div>
                                </div>
    
                                <!-- Pie: fechas y alertas -->
                                <div class="o_kanban_record_bottom mt-2">
                                    <div class="oe_kanban_bottom_left small">
                                        <span t-if="record.alerta_ventana.raw_value == 'vencido'" class="badge bg-danger">Vencida</span>
                                        <span t-elif="record.alerta_ventana.raw_value == 'proximo'" class="badge bg-warning text-dark">
                                            ⚠ <t t-esc="record.dias_para_vencer.raw_value"/> días
                                        </span>
                                        <span t-else="" class="text-muted">
                                            Vence: <field name="fecha_vencimiento"/>
                                        </span>
                                    </div>
                                    <div class="oe_kanban_bottom_right">
                                        <span t-if="record.notificacion_enviada.raw_value" class="badge bg-info text-white">✉ Notificado</span>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </t>
                </templates>
        </kanban>
    </field>
</record>

<!-- ══════════════════════════════════════════════════════════════
     VISTA BÚSQUEDA
══════════════════════════════════════════════════════════════ -->
<record id="view_ena_solicitud_search" model="ir.ui.view">
    <field name="name">ena.solicitud.search</field>
    <field name="model">ena.solicitud</field>
    <field name="arch" type="xml">
        <search string="Buscar Auditorías no anunciadas">
            <field name="organization_id" string="Productor"/>
            <field name="shipper"/>
            <field name="coordinadora_id"/>
            <field name="justificacion"/>
            <field name="product_ids"/>
            <separator/>
            <filter string="Mis Auditorías no anunciadas asignadas"
                    name="mis_enas"
                    domain="[('coordinadora_id','=',uid)]"/>
            <filter string="Sin coordinadora"
                    name="sin_coordinadora"
                    domain="[('coordinadora_id','=',False)]"/>
            <separator/>
            <filter string="Ventana vencida"
                    name="vencido"
                    domain="[('alerta_ventana','=','vencido')]"/>
            <filter string="Próximas a vencer (30 días)"
                    name="proximo"
                    domain="[('alerta_ventana','=','proximo')]"/>
            <separator/>
            <filter string="Candidatos" name="candidato" domain="[('stage','=','candidato')]"/>
            <filter string="En seguimiento" name="seguimiento" domain="[('stage','in',('asignada','notificada'))]"/>
            <filter string="Programadas" name="programada" domain="[('stage','=','programada')]"/>
            <filter string="Realizadas" name="realizada" domain="[('stage','=','realizada')]"/>
            <filter string="No realizadas" name="no_realizada" domain="[('stage','=','no_realizada')]"/>
            <separator/>
            <filter string="Año en curso"
                    name="anio_actual"
                    domain="[('anio','=', context_today().year)]"/>
            <group expand="0" string="Agrupar por">
                <filter string="Etapa" name="group_stage" context="{'group_by':'stage'}"/>
                <filter string="Coordinadora" name="group_coord" context="{'group_by':'coordinadora_id'}"/>
                <filter string="Alerta de ventana" name="group_alerta" context="{'group_by':'alerta_ventana'}"/>
                <filter string="Mes de vencimiento" name="group_venc" context="{'group_by':'fecha_vencimiento:month'}"/>
            </group>
        </search>
    </field>
</record>

<!-- ══════════════════════════════════════════════════════════════
     ACCIÓN PRINCIPAL
══════════════════════════════════════════════════════════════ -->
<record id="action_ena_solicitud" model="ir.actions.act_window">
    <field name="name">Auditorías No Anunciadas</field>
    <field name="res_model">ena.solicitud</field>
    <field name="view_mode">kanban,tree,form</field>
    <field name="search_view_id" ref="view_ena_solicitud_search"/>
    <field name="context">{
        'search_default_anio_actual': 1
    }</field>
    <field name="help" type="html">
        <p class="o_view_nocontent_smiling_face">
            No hay Auditorías No Anunciadas registradas aún.
        </p>
        <p>
            Use el botón <strong>Importar desde Excel</strong> para cargar
            los productores candidatos del archivo FAA-07, o cree uno manualmente.
        </p>
    </field>
</record>
<record id="action_ena_lost_reason" model="ir.actions.act_window">
    <field name="name">Motivos no realización</field>
    <field name="res_model">ena.lost.reason</field>
    <field name="view_mode">tree,form</field>
</record>



</odoo>
