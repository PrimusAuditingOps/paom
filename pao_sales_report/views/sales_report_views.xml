<?xml version="1.0" encoding="utf-8" ?>
<odoo>

    <record id="sale_report_audit_data_view_tree" model="ir.ui.view">
        <field name="name">sale.report.audit.data.view.tree</field>
        <field name="model">sale.report</field>
        <field name="type">tree</field>
        <field name="inherit_id" ref="sale.sale_report_view_tree"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='order_reference']" position="replace">
                <field name="sale_order_id" widget="many2one"/>
            </xpath>

            <xpath expr="//field[@name='product_id']" position="after">
                <field name="organization_id" optional="show"/>
                <field name="registration_number_id" optional="show"/>
                <field name="audit_date" optional="show"/>
                <field name="vendor_id" optional="show"/>
                <field name="coordinator_id" optional="show"/>
            </xpath>
        </field>
    </record>

</odoo>