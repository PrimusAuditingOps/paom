<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_move_form_inherit_reversed_line" model="ir.ui.view">
        <field name="name">account.move.form.reversed.line</field>
        <field name="model">account.move</field>
        <field name="inherit_id" ref="account.view_move_form"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='invoice_line_ids']/tree/field[@name='name']" position="after">
                <field name="reversed_line_id" optional="hide" column_invisible="not parent.reversed_entry_id" domain="[('move_id', '=', parent.reversed_entry_id)]"/>
            </xpath>
        </field>
    </record>


</odoo>