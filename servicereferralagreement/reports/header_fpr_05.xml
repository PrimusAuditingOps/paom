<?xml version="1.0" encoding="utf-8" ?>
<odoo>
    <template id="header_fpr_05">
        <div t-attf-class="header">
            <style>
                @font-face {
                    font-family: 'Playfair';
                    src: url('/servicereferralagreement/static/src/fonts/PlayfairDisplay.ttf') format('truetype');
                    font-style: normal;
                }
                p, ul
                {   
                font-family: 'Playfair' !important;
                }
                h3, h2, h1
                {
                font-family: 'Playfair' !important;
                color: black;
                }
            </style>
            <div class="row mb8">
                <div class="col-2">
                    <img src="/servicereferralagreement/static/src/img/logo.png" style="width:150px; height:60px" alt="Logo"/>
                </div>
                <div class="col-10 text-center" style="display: flex; align-items: center;font-family: 'Playfair' !important; font-size: 14px;">
                    <br/>
                    <h3><b>FPR-05 Contrato de Prestación de Servicios / <br/>Provision of services Contract</b></h3>
                </div>
            </div>
        </div>
        <div t-attf-class="footer o_boxed_footer">
            <style>
                @font-face {
                    font-family: 'MontserratLight';
                    src: url('/servicereferralagreement/static/src/fonts/Montserrat-Light.ttf') format('truetype');
                    font-style: normal;
                }
                p, ul
                {   
                font-family: 'MontserratLight' !important;
                }
                h3, h2, h1
                {
                font-family: 'MontserratLight' !important;
                color: black;
                }
            </style>
            <div class="text-center" style="font-family: 'MontserratLight' !important; font-size: 14px; color: black;">

                <div t-if="report_type == 'pdf'">
                    Página: <span class="page"/> / <span class="topage"/>
                    <br/>
                    Rev. 06, Según Ficha
                </div>
            </div>
        </div>
    </template>
</odoo>