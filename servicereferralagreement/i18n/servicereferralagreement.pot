msgid ""
"<b>CONSENT TO RELEASE INFORMATION - GFSI AND SCHEME OWNER.</b>\n"
"                        As part of its requirements for benchmarking Audit schemes to the GFSI standard, GFSI requires that all \n"
"                        contracting parties for GFSI benchmarked audits authorize the Certification Body to make all audit records \n"
"                        from Customer's audit available to the Scheme Owner (Azzule) and GFSI. By executing this Agreement, Customer \n"
"                        hereby consents to and authorizes Primus Auditing Ops to release all audit documents to the Scheme Owner and \n"
"                        GFSI for internal use purposes."
msgstr ""

#. module: servicereferralagreement
#: model_terms:ir.ui.view,arch_db:servicereferralagreement.sa_gfs
msgid ""
"<b>CONSENTIMIENTO PARA DAR INFORMACIÓN - GFSI Y DUEÑO DEL ESQUEMA.</b> \n"
"                                            Como parte de sus requisitos para evaluar los \n"
"                                            esquemas de auditoría con el estándar de GFSI, GFSI requirió \n"
"                                            que todas las partes involucradas en las auditorias evaluadas \n"
"                                            por GFSI autoricen al organismo de certificación a poner en \n"
"                                            disposición del dueño del esquema, Azzule y GFSI, todos los \n"
"                                            registros de auditoría del cliente. Al ejecutar este acuerdo, \n"
"                                            el cliente acepta y autoriza a Primus Auditing Ops a entregar \n"
"                                            todos los documentos de auditoría al dueño del Esquema y a GFSI \n"
"                                            para fines de uso interno."
msgstr ""

#. module: servicereferralagreement
#: model_terms:ir.ui.view,arch_db:servicereferralagreement.sa_haccp
msgid ""
"<b>CUARTA- PRECIO - “PAOMx”</b> se obliga a mantener inalterables los precios \n"
"                                        de los servicios indicados en la cláusula PRIMERA durante la vigencia de \n"
"                                        este acuerdo siempre y cuando se conserven las características de la organización \n"
"                                        a auditar (información del alcance de auditoría registrado en el documento \n"
"                                        Solicitud Estándar de Servicio de Auditoría). En caso de que dichas \n"
"                                        características varíen, <b>“EL CLIENTE\"</b> deberá comunicárselo a <b>“PAOMx”</b>, \n"
"                                        con el fin de generar un nuevo acuerdo de servicios."
msgstr ""

#. module: servicereferralagreement
#: model_terms:ir.ui.view,arch_db:servicereferralagreement.sa_add_ggap
msgid ""
"<b>CUARTA. -DOMICILIO Y NOTIFICACIONES. - “Las Partes”</b> señalan como sus domicilios los establecidos en el \n"
"                <b>Acuerdo de Servicios de Certificación (FAN-05)</b>. Los avisos o notificaciones deberán ser por escrito y se considerarán \n"
"                debidamente practicados si se entregan en persona o por correo certificado con acuse de recibo en dichas direcciones, debiéndose \n"
"                dirigir a las personas que las partes autoricen para tal efecto."
