<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="comisionpromotores_view_form_abc" model="ir.ui.view">
        <field name="name">comisionpromotores.promotor.view.form.abc</field>
        <field name="model">comisionpromotores.promotor</field>
        <field name="inherit_id" ref="comisionpromotores.comisionpromotores_view_form"/>
        <field name="arch" type="xml">
            <field name="scheme_ids" position="after">
                <field name="company_id" invisible="1"/>
                <field name="categoria_abc_id" invisible="company_id != 1"/>
            </field>
        </field>
    </record>

    <record id="comisionpromotores_promotores_view_tree_abc" model="ir.ui.view">
        <field name="name">comisionpromotores.promotores.view.tree.abc</field>
        <field name="model">comisionpromotores.promotor</field>
        <field name="inherit_id" ref="comisionpromotores.comisionpromotores_promotores_view_tree"/>
        <field name="arch" type="xml">
            <field name="porcentaje" position="after">
                <field name="company_id" column_invisible="1"/>
                <field name="categoria_abc_id" optional="show" invisible="company_id != 1"/>
            </field>
        </field>
    </record>
</odoo>
