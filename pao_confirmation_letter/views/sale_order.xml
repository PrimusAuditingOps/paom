<?xml version="1.0" encoding="utf-8" ?>
<odoo>
  
    <record id="sale_order_pao_confirmation_letter_view_form" model="ir.ui.view">
        <field name="name">sale.order.pao.confirmation.letter.view.form</field>
        <field name="model">sale.order</field>
        <field name="type">form</field>
        <field name="inherit_id" ref="sale.view_order_form"/>
        <field name="arch" type="xml">
            <div name="button_box" position="inside">
                <button name="action_so_pao_confirmation_letter_view" type="object" class="oe_stat_button" icon="fa-file-o" invisible="pao_confirmation_letter_count == 0">
                    <div class="o_field_widget o_stat_info">
                        <span class="o_stat_value"><field name="pao_confirmation_letter_count"/></span>
                        <span class="o_stat_text">Letters of Confirmation</span>
                    </div>
                </button>
            </div>
        </field>
    </record>

</odoo>