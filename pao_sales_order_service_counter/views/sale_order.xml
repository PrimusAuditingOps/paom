<?xml version="1.0" encoding="utf-8" ?>
<odoo>
    <record id="pao_sale_order_total_services_view_form" model="ir.ui.view">
        <field name="name">pao.sale.order.total_services.view.form</field>
        <field name="model">sale.order</field>
        <field name="type">form</field>
        <field name="inherit_id" ref="sale.view_order_form"/>
        <field name="arch" type="xml">
            <div name="so_button_below_order_lines" position="after">
             	<div class="float-start d-flex gap-1 mb-2 ms-1" name="so_pao_service_counter">
                    <span><b>Total Service Lines:</b></span><field name="pao_service_counter" readonly="1"/>
                </div>
            </div>
            
        </field>
    </record>
</odoo>