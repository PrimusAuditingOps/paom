<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">
        <template id="fans_request_signature_mail">
            <table border="0" cellpadding="0" style="background-color: white; padding: 0px; border-collapse:separate;">
                <tr>
                    <td valign="top">
                        <p style="font-size:12pt;font-family:Tahoma,sans-serif;color:#000000;line-height:1.0;">
                            Estimado/a <t t-esc="record.capturist_id.name"/>
                            <br/><br/>
                            A través de este correo le hacemos llegar la solicitud de firma para el registro de aplicación de  <t t-esc="record.organization_id.name"/>
                            <br/><br/>
                        </p>  
                    </td>
                </tr>
                <tr>
                    <td valign="top">
                        <div style="margin:16px auto; text-align:center;">
                            <a t-att-href="link"
                                style="padding: 8px 16px 8px 16px; border-radius: 3px; background-color:#875A7B; text-align:center; text-decoration:none; color: #FFFFFF;">
                                Sign
                            </a>
                        </div>
                    </td>
                </tr>
            </table>  
        </template>

        <template id="fans_reminder_request_signature_mail">
            <table border="0" cellpadding="0" style="background-color: white; padding: 0px; border-collapse:separate;">
                <tr>
                    <td valign="top">
                        <p style="font-size:12pt;font-family:Tahoma,sans-serif;color:#000000;line-height:1.0;">
                            Estimado/a <t t-esc="record.capturist_id.name"/>
                            <br/><br/>
                            A través de este correo le hacemos llegar la solicitud de firma para el registro de aplicación de  <span style="color:blue; font-weight: bold;"><t t-esc="record.organization_id.name"/></span>
                            la cual debe ser firmada previo a su fecha de auditoría.
                            <br/><br/>
                            Recuerde la falta de firma constituye un incumplimiento contractual que podría afectar la emisión del certificado.
                            <br/><br/>
                            Agradecemos su pronta gestión para formalizar la firma y evitar así retrasos en el proceso de certificación.
                            <br/><br/>
                        </p>  
                    </td>
                </tr>
                <tr>
                    <td valign="top">
                        <div style="margin:16px auto; text-align:center;">
                            <a t-att-href="link"
                                style="padding: 8px 16px 8px 16px; border-radius: 3px; background-color:#875A7B; text-align:center; text-decoration:none; color: #FFFFFF;">
                                Firmar
                            </a>
                        </div>
                    </td>
                </tr>
            </table>  
        </template>

    </data>
</odoo>