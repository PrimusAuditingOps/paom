<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <template id="report_journal_book">
        <t t-call="web.html_container">
            <!-- Repeated on every page (company data, title and page number). -->
            <div class="header" style="font-family: 'Courier New', Courier, monospace; font-size: 9pt;">
                <table style="width: 100%;">
                    <tr>
                        <td style="width: 35%; vertical-align: top; line-height: 1.2;">
                            <div>PRIMUS CHILE S.P.A.</div>
                            <div>RUT: 76.037.995-6</div>
                            <div>AUDITORÍAS DE INOCUIDAD ALIMENTARIA</div>
                            <div>Y ACTIVIDADES DE APOYO A LA AGRICULTURA</div>
                            <div>AVENIDA LIBERTAD No. 798 OFICINA 902</div>
                            <div>VIÑA DEL MAR, CHILE</div>
                            <div>13.229.025-3 KATHERINE A. LEGUA SEPULVEDA</div>
                        </td>
                        <td style="width: 45%; vertical-align: middle; text-align: center; font-weight: bold; font-size: 12pt;">
                            <t t-out="title"/>
                        </td>
                        <td style="width: 20%; vertical-align: top; text-align: right;">
                            PAGINA: <span class="page"/>
                        </td>
                    </tr>
                </table>
            </div>

            <div class="article">
                <style>
                    .o_cl_journal_book { width: 100%; border-collapse: collapse; font-family: 'Courier New', Courier, monospace; font-size: 8pt; }
                    .o_cl_journal_book thead { display: table-header-group; }
                    .o_cl_journal_book tr { page-break-inside: avoid; }
                    .o_cl_journal_book th { border: 1px solid #000; padding: 3px 4px; text-align: center; font-weight: bold; }
                    .o_cl_journal_book td { border-left: 1px solid #000; border-right: 1px solid #000; padding: 1px 4px; vertical-align: top; }
                    .o_cl_journal_book .o_num { text-align: right; white-space: nowrap; }
                    .o_cl_journal_book .o_nowrap { white-space: nowrap; }
                    .o_cl_journal_book .o_previous td { padding-bottom: 8px; }
                    .o_cl_journal_book .o_total td { border-top: 1px solid #000; font-weight: bold; }
                    .o_cl_journal_book tbody tr:last-child td { border-bottom: 1px solid #000; }
                </style>
                <table class="o_cl_journal_book">
                    <thead>
                        <tr>
                            <th style="width: 8%;">FECHA</th>
                            <th style="width: 10%;">COMPROBANTE</th>
                            <th style="width: 27%;">GLOSA</th>
                            <th style="width: 11%;">DEBE</th>
                            <th style="width: 11%;">HABER</th>
                            <th style="width: 8%;">C.CUENTA</th>
                            <th style="width: 17%;">CUENTA</th>
                            <th style="width: 8%;">CC.</th>
                        </tr>
                    </thead>
                    <tbody>
                        <tr class="o_previous">
                            <td/>
                            <td/>
                            <td>ACUMULACIONES ANTERIORES</td>
                            <td class="o_num" t-out="fmt_amount(previous_debit)"/>
                            <td class="o_num" t-out="fmt_amount(previous_credit)"/>
                            <td/>
                            <td/>
                            <td/>
                        </tr>
                        <tr t-foreach="docs" t-as="line">
                            <td class="o_nowrap" t-out="fmt_date(line.date)"/>
                            <!-- Comprobante: pending definition, left blank on purpose. -->
                            <td/>
                            <td t-out="line.name"/>
                            <td class="o_num" t-out="fmt_amount(line.debit)"/>
                            <td class="o_num" t-out="fmt_amount(line.credit)"/>
                            <td class="o_nowrap" t-out="line.account_id.code"/>
                            <td t-out="line.account_id.name"/>
                            <td t-out="cost_center(line)"/>
                        </tr>
                        <tr class="o_total">
                            <td/>
                            <td/>
                            <td>TOTAL DEL MES</td>
                            <td class="o_num" t-out="fmt_amount(month_debit)"/>
                            <td class="o_num" t-out="fmt_amount(month_credit)"/>
                            <td/>
                            <td/>
                            <td/>
                        </tr>
                        <tr class="o_total">
                            <td/>
                            <td/>
                            <td>TOTAL ACUMULADO</td>
                            <td class="o_num" t-out="fmt_amount(previous_debit + month_debit)"/>
                            <td class="o_num" t-out="fmt_amount(previous_credit + month_credit)"/>
                            <td/>
                            <td/>
                            <td/>
                        </tr>
                    </tbody>
                </table>
            </div>
        </t>
    </template>
</odoo>
