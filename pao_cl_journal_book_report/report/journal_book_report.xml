<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="paperformat_journal_book" model="report.paperformat">
        <field name="name">Libro diario (Carta horizontal)</field>
        <field name="format">Letter</field>
        <field name="orientation">Landscape</field>
        <field name="margin_top">46</field>
        <field name="margin_bottom">12</field>
        <field name="margin_left">8</field>
        <field name="margin_right">8</field>
        <field name="header_line" eval="False"/>
        <field name="header_spacing">40</field>
        <field name="dpi">90</field>
    </record>

    <!-- The report itself (no longer in the gear menu: the folio dialog below prints it). -->
    <record id="action_report_journal_book" model="ir.actions.report">
        <field name="name">Reporte: Libro diario</field>
        <field name="model">account.move.line</field>
        <field name="report_type">qweb-pdf</field>
        <field name="report_name">pao_cl_journal_book_report.report_journal_book</field>
        <field name="report_file">pao_cl_journal_book_report.report_journal_book</field>
        <field name="print_report_name">'Libro diario'</field>
        <field name="paperformat_id" ref="paperformat_journal_book"/>
        <field name="binding_model_id" eval="False"/>
    </record>

    <!-- Gear (Print) menu of the journal items list: asks for the optional folio, then prints. -->
    <record id="action_print_journal_book" model="ir.actions.act_window">
        <field name="name">Reporte: Libro diario</field>
        <field name="res_model">pao.cl.report.folio.wizard</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
        <field name="context">{'default_report_xmlid': 'pao_cl_journal_book_report.action_report_journal_book'}</field>
        <field name="binding_model_id" ref="account.model_account_move_line"/>
        <field name="binding_type">report</field>
        <field name="binding_view_types">list</field>
    </record>
</odoo>
