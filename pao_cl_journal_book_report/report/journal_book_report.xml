<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="paperformat_journal_book" model="report.paperformat">
        <field name="name">Libro diario (Carta horizontal)</field>
        <field name="format">Letter</field>
        <field name="orientation">Landscape</field>
        <field name="margin_top">42</field>
        <field name="margin_bottom">12</field>
        <field name="margin_left">8</field>
        <field name="margin_right">8</field>
        <field name="header_line" eval="False"/>
        <field name="header_spacing">36</field>
        <field name="dpi">90</field>
    </record>

    <!-- Shows up under the gear (Print) menu of the journal items list view. -->
    <record id="action_report_journal_book" model="ir.actions.report">
        <field name="name">Reporte: Libro diario</field>
        <field name="model">account.move.line</field>
        <field name="report_type">qweb-pdf</field>
        <field name="report_name">pao_cl_journal_book_report.report_journal_book</field>
        <field name="report_file">pao_cl_journal_book_report.report_journal_book</field>
        <field name="print_report_name">'Libro diario'</field>
        <field name="paperformat_id" ref="paperformat_journal_book"/>
        <field name="binding_model_id" ref="account.model_account_move_line"/>
        <field name="binding_type">report</field>
        <field name="binding_view_types">list</field>
    </record>
</odoo>
