<?xml version="1.0" encoding="utf-8" ?>
<odoo>
    <record id="view_purchase_order_form_select_organization" model="ir.ui.view">
        <field name="name">purchase.order.form.select.organization</field>
        <field name="model">purchase.order</field>
        <field name="inherit_id" ref="purchase.purchase_order_form"/>
        <field name="arch" type="xml">

            <xpath expr="//field[@name='picking_type_id']" position="after">
               <button name="action_open_select_organization_wizard" type="object" string="Filter Organization" class="oe_highlight" invisible="state not in ['draft', 'sent'] or country_code != 'CL' ">
                Filter Organization 
                <i class="fa fa-filter me-1"/>
                </button>
            </xpath>

        </field>
    </record>
</odoo>