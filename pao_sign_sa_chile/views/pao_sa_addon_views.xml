<?xml version="1.0" encoding="utf-8" ?>
<odoo>
    <record id="pao_sa_addon_view_tree" model="ir.ui.view">
        <field name="name">pao.sa.addon.tree</field>
        <field name="model">pao.sa.addon</field>
        <field name="arch" type="xml">
            <tree editable="bottom">
                <field name="sequence" widget="handle"/>
                <field name="name"/>
                <field name="company_id" groups="base.group_multi_company" options="{'no_create': True}"/>
                <field name="active" column_invisible="True"/>
            </tree>
        </field>
    </record>

    <record id="pao_sa_addon_view_search" model="ir.ui.view">
        <field name="name">pao.sa.addon.search</field>
        <field name="model">pao.sa.addon</field>
        <field name="arch" type="xml">
            <search>
                <field name="name"/>
                <filter string="Archived" name="inactive" domain="[('active', '=', False)]"/>
            </search>
        </field>
    </record>

    <record id="pao_sa_addon_action" model="ir.actions.act_window">
        <field name="name">SA Add-Ons</field>
        <field name="res_model">pao.sa.addon</field>
        <field name="view_mode">tree</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">Create an SA add-on</p>
        </field>
    </record>

    <menuitem id="menu_pao_sa_addon"
              name="SA Add-Ons"
              parent="sale.menu_sale_config"
              action="pao_sa_addon_action"
              sequence="61"
              groups="sales_team.group_sale_manager"/>
</odoo>
