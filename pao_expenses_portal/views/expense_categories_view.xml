<?xml version="1.0" encoding="utf-8" ?>
<odoo>
    <record id="hr_expense_categories_tree_view_inherit" model="ir.ui.view">
        <field name="name">hr.expense.categories.tree.view.inherit</field>
        <field name="model">product.product</field>
        <field name="type">tree</field>
        <field name="inherit_id" ref="hr_expense.product_product_expense_categories_tree_view"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='supplier_taxes_id']" position="after">
                <field name="category_for_auditors" optional="show"/>
            </xpath>
        </field>
    </record>

    <record id="hr_expense_categories_search_view_inherit" model="ir.ui.view">
        <field name="name">hr.expense.categories.search.view.inherit</field>
        <field name="model">product.product</field>
        <field name="inherit_id" ref="product.product_search_form_view"/>
        <field name="arch" type="xml">
            <xpath expr="//search" position="inside">
                <separator/>
                <filter name="category_auditors" string="Category available for auditors" domain="[('category_for_auditors', '=', True)]"/>
                <filter name="category_internal" string="Category available for employees" domain="[('category_for_auditors', '=', False)]"/>
            </xpath>
        </field>
    </record>
</odoo>