<?xml version="1.0" encoding="utf-8" ?>
<odoo>
    <record id="hr_expense_sheet_tree_view_inherit" model="ir.ui.view">
        <field name="name">hr.expense.sheet.tree.view.inherit</field>
        <field name="model">hr.expense.sheet</field>
        <field name="type">tree</field>
        <field name="inherit_id" ref="hr_expense.view_hr_expense_sheet_tree"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='company_id']" position="attributes">
                <attribute name="groups"></attribute>
            </xpath>
            <xpath expr="//field[@name='employee_id']" position="after">
                <field name="partner_id" widget="many2one_avatar_user"/>
                <field name="purchase_order"/>
            </xpath>
        </field>
    </record>

    <record id="hr_expense_sheet_form_view_inherit" model="ir.ui.view">
        <field name="name">hr.expense.sheet.form.view.inherit</field>
        <field name="model">hr.expense.sheet</field>
        <field name="type">form</field>
        <field name="inherit_id" ref="hr_expense.view_hr_expense_sheet_form"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='employee_id']" position="after">
                <field name="from_external_auditor" invisible="1"/>
                <field name="country_code" invisible="1"/>
                <field name="partner_id" widget="many2one_avatar_user" readonly="state != 'draft'" invisible="not partner_id"/>
                <field name="purchase_order" readonly="state != 'draft'" invisible="not purchase_order"/>
            </xpath>
            <xpath expr="//button[@name='action_submit_sheet']" position="attributes">
                <attribute name="invisible">state != 'draft' or from_external_auditor</attribute>
            </xpath>
            <xpath expr="//button[@name='action_sheet_move_create']" position="attributes">
                <attribute name="invisible">state != 'approve' or from_external_auditor</attribute>
            </xpath>
            <xpath expr="//field[@name='date']" position="after">
                <field name="end_date" optional="hide"/>
            </xpath>
        </field>
    </record>




    <record id="hr_expense.action_hr_expense_sheet_my_all" model="ir.actions.act_window">
        <field name="domain">[('state', '!=', 'cancel'), ('from_external_auditor', '=', False)]</field>
    </record>

    <record id="hr_expense.action_hr_expense_sheet_all" model="ir.actions.act_window">
        <field name="domain">[('from_external_auditor', '=', False)]</field>
    </record>

    <record id="action_expense_sheet_external_auditor" model="ir.actions.act_window">
        <field name="name">External Auditor Expense Reports</field>
        <field name="res_model">hr.expense.sheet</field>
        <field name="view_mode">tree,form,kanban,pivot,graph</field>
        <field name="domain">[('from_external_auditor', '=', True)]</field>
    </record>

    <menuitem id="menu_expense_sheet_external_auditor"
            name="External Auditor Expense Reports"
            parent="hr_expense.menu_hr_expense_reports"
            action="action_expense_sheet_external_auditor"/>

</odoo>