<?xml version="1.0" encoding="utf-8" ?>
<odoo>
    <record id="hr_expense_tree_view_inherit" model="ir.ui.view">
        <field name="name">hr.expense.tree.view.inherit</field>
        <field name="model">hr.expense</field>
        <field name="type">tree</field>
        <field name="inherit_id" ref="hr_expense.view_my_expenses_tree"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='employee_id']" position="after">
                <field name="partner_id"/>
            </xpath>
        </field>
    </record>

    <record id="hr_expense_form_view_inherit" model="ir.ui.view">
        <field name="name">hr.expense.form.view.inherit</field>
        <field name="model">hr.expense</field>
        <field name="type">form</field>
        <field name="inherit_id" ref="hr_expense.hr_expense_view_form"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='employee_id']" position="after">
                <field name="country_code" invisible="1"/>
                <field name="partner_id" invisible="country_code != 'MX' and not partner_id" readonly="state != 'draft'"/>
            </xpath>
            <xpath expr="//field[@name='date']" position="attributes">
                <attribute name="required">True</attribute>
                <attribute name="readonly">not is_editable</attribute>
            </xpath>

            <xpath expr="//field[@name='product_id']" position="attributes">
                <attribute name="domain">
                    (company_id and ['|', ('company_id', '=', False), ('company_id', 'parent_of', [company_id])]
                    or ['&amp;', ('company_id', '=', False), ('company_id', 'parent_of', [])])
                    + [('can_be_expensed', '=', True), ('category_for_auditors', '=', False)]
                </attribute>
            </xpath>

            <xpath expr="//field[@name='price_unit']" position="before">
                <label for="product_id" string="Auditor Categories" groups="pao.auditor_expenses_available"/>
                <div groups="pao.auditor_expenses_available">
                    <field name="product_id" readonly="not is_editable" domain="(company_id and ['|', ('company_id', '=', False), ('company_id', 'parent_of', [company_id])] or ['&amp;', ('company_id', '=', False), ('company_id', 'parent_of', [])]) + [('can_be_expensed', '=', True), ('category_for_auditors', '=', True)]"/>
                </div>
            </xpath>
        </field>
    </record>


    <record id="hr_expense.hr_expense_actions_my_all" model="ir.actions.act_window">
        <field name="domain">[('from_external_auditor', '=', False)]</field>
    </record>

