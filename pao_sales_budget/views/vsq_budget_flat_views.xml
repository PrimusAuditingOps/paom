<odoo>
  <record id="view_vsq_budget_flat_tree" model="ir.ui.view">
    <field name="name">vsq.budget.flat.tree</field>
    <field name="model">vsq.budget.flat</field>
    <field name="arch" type="xml">
      <tree>
        <field name="name"/>
        <field name="company_id"/>
        <field name="year"/>
      </tree>
    </field>
  </record>

  <record id="view_vsq_budget_flat_form" model="ir.ui.view">
    <field name="name">vsq.budget.flat.form</field>
    <field name="model">vsq.budget.flat</field>
    <field name="arch" type="xml">
      <form string="Presupuesto (Flat 12 cols)">
        <sheet>
          <group>
            <field name="name"/>
            <field name="company_id"/>
            <field name="year"/>
          </group>
          <group>
            <field name="line_ids" widget="one2many_list">
              <tree editable="top">
                <field name="group_id"/>
                <field name="partner_category_id"/>
                <field name="partner_id"/>
                <field name="product_id"/>
                <field name="product_type"/>
                <field name="price_unit"/>
                <field name="m01"/>
                <field name="m02"/>
                <field name="m03"/>
                <field name="m04"/>
                <field name="m05"/>
                <field name="m06"/>
                <field name="m07"/>
                <field name="m08"/>
                <field name="m09"/>
                <field name="m10"/>
                <field name="m11"/>
                <field name="m12"/>
                <field name="total"/>
              </tree>
            </field>
          </group>
        </sheet>
      </form>
    </field>
  </record>

  <record id="action_vsq_budget_flat" model="ir.actions.act_window">
    <field name="name">Presupuestos (Flat)</field>
    <field name="res_model">vsq.budget.flat</field>
    <field name="view_mode">tree,form</field>
    <field name="view_id" ref="view_vsq_budget_flat_tree"/>
  </record>

  <menuitem id="menu_vsq_budget_flat" name="Flat (12 cols)" parent="menu_vsq_budget_root" action="action_vsq_budget_flat"/>
</odoo>