<?xml version="1.0" encoding="utf-8" ?>
<odoo>
    <record id="pao_sales_budget_comisionpromotores_view_form" model="ir.ui.view">
        <field name="name">pao.sales.budget.comisionpromotores.view.form</field>
        <field name="model">comisionpromotores.promotor</field>
        <field name="type">form</field>
        <field name="inherit_id" ref="comisionpromotores.comisionpromotores_view_form"/>
        <field name="arch" type="xml">
            <field name="porcentaje" position="after">
                <field name="pao_include_in_budget"/>  
            </field>
            
        </field>
    </record>

    <record id="pao_sales_budget_comisionpromotores_view_tree" model="ir.ui.view">
        <field name="name">pao.sales.budget.comisionpromotores.view.tree</field>
        <field name="model">comisionpromotores.promotor</field>
        <field name="type">tree</field>
        <field name="inherit_id" ref="comisionpromotores.comisionpromotores_promotores_view_tree"/>
            <field name="arch" type="xml">
                <field name="porcentaje" position="after">
                    <field name="pao_include_in_budget"/>
                </field>
            </field>
    </record>
</odoo>