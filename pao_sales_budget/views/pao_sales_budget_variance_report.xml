<odoo>

  <record id="pao_sales_budget_variance_report_view_search" model="ir.ui.view">
    <field name="name">pao.sales.budget.variance.report.view.search</field>
    <field name="model">pao.sales.budget.variance.report</field>
    <field name="arch" type="xml">
        <search>
            <field name="region_id"/>
            <field name="customer_category"/>
            <field name="customer_name"/>
            <field name="product_id"/>
            <field name="month"/>

            <filter name="filter_unbudgeted" string="Sin Presupuesto" domain="[('budgeted_qty', '=', 0), ('actual_qty', '&gt;', 0)]"/>
            <filter name="filter_below_budget" string="Debajo del Presupuesto" domain="[('variance_pct', '&lt;', 0)]"/>
            <filter name="filter_above_budget" string="Arriba del Presupuesto" domain="[('variance_pct', '&gt;', 0)]"/>

            <group expand="1" string="Group By">
                <filter name="group_by_region" string="Región" context="{'group_by': 'region_id'}"/>
                <filter name="group_by_customer_category" string="Categoría de Cliente" context="{'group_by': 'customer_category'}"/>
                <filter name="group_by_customer_name" string="Nombre de Cliente" context="{'group_by': 'customer_name'}"/>
                <filter name="group_by_product" string="Producto" context="{'group_by': 'product_id'}"/>
                <filter name="group_by_month" string="Mes" context="{'group_by': 'month'}"/>
            </group>
        </search>
    </field>
  </record>

  <record id="pao_sales_budget_variance_report_view_tree" model="ir.ui.view">
    <field name="name">pao.sales.budget.variance.report.view.tree</field>
    <field name="model">pao.sales.budget.variance.report</field>
    <field name="arch" type="xml">
      <tree string="Presupuestado vs Real" create="false" edit="false"
            decoration-info="budgeted_qty == 0 and actual_qty &gt; 0"
            decoration-danger="budgeted_qty != 0 and variance_pct &lt; -0.0001"
            decoration-warning="budgeted_qty != 0 and variance_pct &gt; 0.0001"
            decoration-success="budgeted_qty != 0 and variance_pct &gt;= -0.0001 and variance_pct &lt;= 0.0001">
        <field name="region_id"/>
        <field name="customer_category"/>
        <field name="customer_name"/>
        <field name="product_id"/>
        <field name="month"/>
        <field name="budgeted_qty" sum="Total"/>
        <field name="actual_qty" sum="Total"/>
        <field name="variance_qty" sum="Total"/>
        <field name="variance_pct" widget="percentage"/>
      </tree>
    </field>
  </record>

  <record id="pao_sales_budget_variance_report_view_pivot" model="ir.ui.view">
    <field name="name">pao.sales.budget.variance.report.view.pivot</field>
    <field name="model">pao.sales.budget.variance.report</field>
    <field name="arch" type="xml">
      <pivot string="Presupuestado vs Real" sample="1">
        <field name="region_id" type="row"/>
        <field name="customer_category" type="row"/>
        <field name="customer_name" type="row"/>
        <field name="product_id" type="row"/>
        <field name="month" type="col"/>
        <field name="budgeted_qty" type="measure"/>
        <field name="actual_qty" type="measure"/>
        <field name="variance_qty" type="measure"/>
      </pivot>
    </field>
  </record>

  <record id="action_pao_sales_budget_variance_report" model="ir.actions.act_window">
    <field name="name">Presupuestado vs Real</field>
    <field name="res_model">pao.sales.budget.variance.report</field>
    <field name="view_mode">pivot,tree</field>
  </record>

</odoo>
