<?xml version="1.0" encoding="utf-8" ?>
<odoo>
    <record id="pao_sales_budget_crm_team_view_form" model="ir.ui.view">
        <field name="name">pao.sales.budget.crm.team.view.form</field>
        <field name="model">crm.team</field>
        <field name="type">form</field>
        <field name="inherit_id" ref="sales_team.crm_team_view_form"/>
        <field name="arch" type="xml">
            <xpath expr="//div[@name='options_active']" position="inside">
                <span name="Budget" groups="crm.group_use_lead">
                    <field name="pao_include_in_budget"/>
                    <label for="pao_include_in_budget" string="Include in Budget"/>
                </span>
            </xpath>
            
        </field>
    </record>

    <record id="pao_sales_budget_crm_team_view_tree" model="ir.ui.view">
        <field name="name">pao.sales.budget.crm.team.view.tree</field>
        <field name="model">account.move</field>
        <field name="type">tree</field>
        <field name="inherit_id" ref="sales_team.crm_team_view_tree"/>
            <field name="arch" type="xml">
                <field name="name" position="after">
                    <field name="pao_include_in_budget"/>
                </field>
            </field>
    </record>
</odoo>