<odoo>

  <record id="pao_sales_budget_line_view_search" model="ir.ui.view">
    <field name="name">pao.sales.budget.line.view.search</field>
    <field name="model">pao.sales.budget.line</field>
    <field name="arch" type="xml">
        <search>
            <field name="region_id"/>
            <field name="customer_category"/>
            <field name="customer_name"/>
            <field name="product_id"/>

           
        </search>
    </field>
  </record>

  <record id="pao_sales_budget_line_view_tree" model="ir.ui.view">
    <field name="name">pao.sales.budget.line.view.tree</field>
    <field name="model">pao.sales.budget.line</field>
    <field name="arch" type="xml">
      <tree string="Sales Budget Line" editable="top">
        <field name="region_id"/>
        <field name="customer_category"/>
        <field name="customer_name"/>
        <field name="product_id"/>
         <field name="currency_id" optional="hide"/>
        <field name="price_unit" sum="Total" options="{'currency_field': 'currency_id'}"/>
        <field name="m09" sum="Total"/>
        <field name="m09_amount" optional="hide" sum="Total"/>
        <field name="m10" sum="Total"/>
        <field name="m10_amount" optional="hide" sum="Total"/>
        <field name="m11" sum="Total"/>
        <field name="m11_amount" optional="hide" sum="Total"/>
        <field name="m12" sum="Total"/>
        <field name="m12_amount" optional="hide" sum="Total"/>
        <field name="m01" sum="Total"/>
        <field name="m01_amount" optional="hide" sum="Total"/>
        <field name="m02" sum="Total"/>
        <field name="m02_amount" optional="hide" sum="Total"/>
        <field name="m03" sum="Total"/>
        <field name="m03_amount" optional="hide" sum="Total"/>
        <field name="m04" sum="Total"/>
        <field name="m04_amount" optional="hide" sum="Total"/>
        <field name="m05" sum="Total"/>
        <field name="m05_amount" optional="hide" sum="Total"/>
        <field name="m06" sum="Total"/>
        <field name="m06_amount" optional="hide" sum="Total"/>
        <field name="m07" sum="Total"/>
        <field name="m07_amount" optional="hide" sum="Total"/>
        <field name="m08" sum="Total"/>
        <field name="m08_amount" optional="hide" sum="Total"/>
        <field name="total_quantity" sum="Total"/>
        <field name="total_amount" sum="Total"/>
        
      </tree>
    </field>
  </record>

  <record id="pao_sales_budget_line_view_pivot" model="ir.ui.view">
        <field name="name">pao.sales.budget.line.view.pivot</field>
        <field name="model">pao.sales.budget.line</field>
        <field name="arch" type="xml">
            <pivot string="Sales Budget Line" sample="1">
                <field name="pao_sales_budget_scheme_id" type="col"/>
                <field name="m09" type="measure"/>
                <field name="m10" type="measure"/>
                <field name="m11" type="measure"/>
                <field name="m12" type="measure"/>
                <field name="m01" type="measure"/>
                <field name="m02" type="measure"/>
                <field name="m03" type="measure"/>
                <field name="m04" type="measure"/>
                <field name="m05" type="measure"/>
                <field name="m06" type="measure"/>
                <field name="m07" type="measure"/>
                <field name="m08" type="measure"/>
            </pivot>
        </field>
  </record>

  <record id="action_pao_sales_budget_line" model="ir.actions.act_window">
    <field name="name">Sales Budget Line</field>
    <field name="res_model">pao.sales.budget.line</field>
    <field name="view_mode">tree</field>
    <field name="view_id" ref="pao_sales_budget_line_view_tree"/>
  </record>
</odoo>