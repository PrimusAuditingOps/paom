<odoo>

  <record id="pao_sales_budget_line_view_search" model="ir.ui.view">
    <field name="name">pao.sales.budget.line.view.search</field>
    <field name="model">pao.sales.budget.line</field>
    <field name="arch" type="xml">
        <search>
            <field name="region_id"/>
            <field name="customer_category"/>
            <field name="customer_name"/>
            <field name="product_id"/>

            <!-- filtro que aplica la agrupación por defecto -->
            <filter name="group_by_region_category_customer"
                    string="Default Group"
                    context="{'group_by': 'region_id','customer_category','customer_name'}"
                    default="True"/>
        </search>
    </field>
  </record>

  <record id="pao_sales_budget_line_view_tree" model="ir.ui.view">
    <field name="name">pao.sales.budget.line.view.tree</field>
    <field name="model">pao.sales.budget.line</field>
    <field name="arch" type="xml">
      <tree string="Sales Budget Line" editable="top">
        <field name="region_id"/>
        <field name="customer_category"/>
        <field name="customer_name"/>
        <field name="product_id"/>
        <field name="price_unit"/>
        <field name="m01"/>
        <field name="m02"/>
        <field name="m03"/>
        <field name="m04"/>
        <field name="m05"/>
        <field name="m06"/>
        <field name="m07"/>
        <field name="m08"/>
        <field name="m09"/>
        <field name="m10"/>
        <field name="m11"/>
        <field name="m12"/>
        <field name="total_quantity"/>
        <field name="total_amount"/>
        
      </tree>
    </field>
  </record>
  <record id="action_pao_sales_budget_line" model="ir.actions.act_window">
    <field name="name">Sales Budget Line</field>
    <field name="res_model">pao.sales.budget.line</field>
    <field name="view_mode">tree</field>
    <field name="view_id" ref="pao_sales_budget_line_view_tree"/>
  </record>
</odoo>