<odoo>
  <record id="view_vsq_budget_tree" model="ir.ui.view">
    <field name="name">vsq.budget.tree</field>
    <field name="model">vsq.budget</field>
    <field name="arch" type="xml">
      <tree>
        <field name="name"/>
        <field name="company_id"/>
        <field name="year"/>
      </tree>
    </field>
  </record>

  <record id="view_vsq_budget_form" model="ir.ui.view">
    <field name="name">vsq.budget.form</field>
    <field name="model">vsq.budget</field>
    <field name="arch" type="xml">
      <form string="Presupuesto (Normalized)" create="true" edit="true" delete="true">
        <sheet>
          <group>
            <field name="name"/>
            <field name="company_id"/>
            <field name="year"/>
          </group>
          <group>
            <field name="line_ids" widget="one2many_list">
              <tree editable="top">
                <field name="group_id"/>
                <field name="partner_category_id"/>
                <field name="partner_id"/>
                <field name="product_id"/>
                <field name="product_type"/>
                <field name="price_unit"/>
                <field name="month"/>
                <field name="qty"/>
                <field name="amount"/>
              </tree>
            </field>
          </group>
        </sheet>
      </form>
    </field>
  </record>

  <record id="action_vsq_budget" model="ir.actions.act_window">
    <field name="name">Presupuestos (Normalized)</field>
    <field name="res_model">vsq.budget</field>
    <field name="view_mode">tree,form</field>
    <field name="view_id" ref="view_vsq_budget_tree"/>
  </record>

  <menuitem id="menu_vsq_budget_root" name="VSQ Presupuestos" sequence="90"/>
  <menuitem id="menu_vsq_budget_normal" name="Normalized" parent="menu_vsq_budget_root" action="action_vsq_budget"/>
</odoo>