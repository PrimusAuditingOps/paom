<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="pao_sale_combo_add_view_form" model="ir.ui.view">
        <field name="name">pao.sale.combo.add.form</field>
        <field name="model">pao.sale.combo.add</field>
        <field name="arch" type="xml">
            <form>
                <field name="order_id" invisible="1"/>
                <field name="company_id" invisible="1"/>
                <field name="in_pricelist" invisible="1"/>
                <group>
                    <field name="combo_id" options="{'no_create': True, 'no_open': True}"/>
                    <field name="pricelist_id" readonly="1"/>
                </group>
                <div class="alert alert-warning" role="alert" invisible="not combo_id or in_pricelist">This combo has no prices in the pricelist of the quotation: its products will be added with a unit price of 0.</div>
                <field name="combo_product_ids" invisible="not combo_id" readonly="1">
                    <tree>
                        <field name="display_name" string="Product"/>
                    </tree>
                </field>
                <footer>
                    <button name="action_add" type="object" string="Add" class="btn-primary" data-hotkey="q"/>
                    <button string="Cancel" special="cancel" class="btn-secondary" data-hotkey="x"/>
                </footer>
            </form>
        </field>
    </record>
</odoo>
