<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- "Add a combo" next to "Add a product" in the quotation template lines, only for the Chilean company. -->
    <record id="sale_order_template_view_form_pao_sale_combo" model="ir.ui.view">
        <field name="name">sale.order.template.form.pao.sale.combo</field>
        <field name="model">sale.order.template</field>
        <field name="inherit_id" ref="sale_management.sale_order_template_view_form"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='sale_order_template_line_ids']" position="before">
                <field name="pao_combo_enabled" invisible="1"/>
            </xpath>
            <xpath expr="//field[@name='sale_order_template_line_ids']/tree/control/create[@name='add_product_control']" position="after">
                <button name="action_pao_add_combo"
                        string="Add a combo"
                        type="object"
                        class="px-4 btn-link"
                        context="{'template_id': parent.id}"
                        invisible="not parent.pao_combo_enabled"/>
            </xpath>
            <xpath expr="//field[@name='sale_order_template_line_ids']/tree/field[@name='product_id']" position="after">
                <field name="pao_combo_id" optional="hide" column_invisible="not parent.pao_combo_enabled" force_save="1"/>
            </xpath>
        </field>
    </record>
</odoo>
