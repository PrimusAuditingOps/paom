<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="pao_sale_combo_view_tree" model="ir.ui.view">
        <field name="name">pao.sale.combo.tree</field>
        <field name="model">pao.sale.combo</field>
        <field name="arch" type="xml">
            <tree>
                <field name="sequence" widget="handle"/>
                <field name="name"/>
                <field name="product_count"/>
                <field name="company_id" groups="base.group_multi_company" optional="show"/>
            </tree>
        </field>
    </record>

    <record id="pao_sale_combo_view_form" model="ir.ui.view">
        <field name="name">pao.sale.combo.form</field>
        <field name="model">pao.sale.combo</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <widget name="web_ribbon" title="Archived" bg_color="text-bg-danger" invisible="active"/>
                    <div class="oe_title">
                        <label for="name"/>
                        <h1><field name="name" placeholder="e.g. GLOBALG.A.P. Option 1 + Nurture"/></h1>
                    </div>
                    <group>
                        <group>
                            <field name="company_id" groups="base.group_multi_company" options="{'no_create': True}"/>
                            <field name="company_id" invisible="1" groups="!base.group_multi_company"/>
                            <field name="active" invisible="1"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Products" name="products">
                            <field name="line_ids">
                                <tree editable="bottom">
                                    <field name="sequence" widget="handle"/>
                                    <field name="company_id" column_invisible="True"/>
                                    <field name="product_id" options="{'no_create': True}"/>
                                </tree>
                            </field>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <record id="pao_sale_combo_view_search" model="ir.ui.view">
        <field name="name">pao.sale.combo.search</field>
        <field name="model">pao.sale.combo</field>
        <field name="arch" type="xml">
            <search>
                <field name="name"/>
                <field name="line_ids" string="Product" filter_domain="[('line_ids.product_id', 'ilike', self)]"/>
                <filter string="Archived" name="inactive" domain="[('active', '=', False)]"/>
            </search>
        </field>
    </record>

    <record id="pao_sale_combo_action" model="ir.actions.act_window">
        <field name="name">Combos</field>
        <field name="res_model">pao.sale.combo</field>
        <field name="view_mode">tree,form</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">Create a combo</p>
            <p>Group the products sold together, price them in the pricelists and add them to quotations in one click.</p>
        </field>
    </record>

</odoo>
