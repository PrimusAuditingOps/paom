<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">
        <record id="pao_sale_combo_company_rule" model="ir.rule">
            <field name="name">Sale Combo: multi-company</field>
            <field name="model_id" ref="model_pao_sale_combo"/>
            <field name="domain_force">[('company_id', 'in', company_ids)]</field>
        </record>
        <record id="pao_pricelist_combo_company_rule" model="ir.rule">
            <field name="name">Pricelist Combo: multi-company</field>
            <field name="model_id" ref="model_pao_pricelist_combo"/>
            <field name="domain_force">['|', ('company_id', '=', False), ('company_id', 'in', company_ids)]</field>
        </record>
    </data>
</odoo>
