<?xml version="1.0" encoding="utf-8"?>
<odoo>
    
    <!-- 1. Añadir botón en "My Account" (/my/home) -->
    <template id="portal_my_home_osp_final" name="Show OSP in Portal" inherit_id="portal.portal_my_home" priority="10">
        <xpath expr="//div[hasclass('o_portal_docs')]" position="inside">
            <t t-call="portal.portal_docs_entry">
                <t t-set="title">Organic System Plan (OSP)</t>
                <t t-set="url" t-value="'/my/osp'"/>
                <t t-set="placeholder_count" t-value="'osp_count'"/>
                <t t-set="text">Manage your applications and plans</t>
            </t>
        </xpath>
    </template>

    <!-- 2. Pantalla Principal de la Lista de OSP (/my/osp) -->
    <template id="portal_my_osps" name="My OSPs">
        <t t-call="portal.portal_layout">
            <t t-set="breadcrumbs_searchbar" t-value="True"/>
            <t t-call="portal.portal_searchbar">
                <t t-set="title">Organic System Plans</t>
            </t>

            <!-- Encabezado y Botón Nuevo -->
            <div class="d-flex justify-content-between align-items-center mb-4 mt-3">
                <div>
                    <h3 class="mb-0">Organic System Plans</h3>
                    <p class="text-muted">Manage your facility applications and plans</p>
                </div>
                <button type="button" class="btn btn-success" data-bs-toggle="modal" data-bs-target="#newOspModal">
                    <i class="fa fa-plus-circle me-1"></i> New Form
                </button>
            </div>

            <!-- Tabla de Registros -->
            <div t-if="not osps" class="alert alert-info">
                No hay planes de manejo orgánico creados todavía. Haz clic en "New Form" para empezar.
            </div>
            
            <div t-if="osps" class="card shadow-sm rounded-3">
                <div class="table-responsive">
                    <table class="table table-hover align-middle mb-0 text-center">
                        <thead class="bg-light">
                            <tr>
                                <th>Service Required</th>
                                <th>Type</th>
                                <th>Organization Name</th>
                                <th>DBA Name</th>
                                <th>City</th>
                                <th>State</th>
                                <th>Country</th>
                                <th>Status</th>
                                <th>Created Date</th>
                                <th>Action</th>
                            </tr>
                        </thead>
                        <tbody>
                            <t t-foreach="osps" t-as="osp">
                                <tr>
                                    <td><span class="text-success fw-bold"><t t-esc="osp.service_id.name"/></span></td>
                                    <td><span class="badge bg-light text-primary border"><t t-esc="osp.form_template_id.name"/></span></td>
                                    <td class="fw-bold text-dark"><t t-esc="osp.organization_name or 'N/A'"/></td>
                                    <td><t t-esc="osp.dba_name or ''"/></td>
                                    <td><t t-esc="osp.city or ''"/></td>
                                    <td><t t-esc="osp.state_id.name or ''"/></td>
                                    <td><t t-esc="osp.country_id.name or ''"/></td>
                                    <td>
                                        <span t-if="osp.state == 'draft'" class="badge rounded-pill bg-secondary">Draft</span>
                                        <span t-if="osp.state == 'submitted'" class="badge rounded-pill bg-success">Submitted</span>
                                    </td>
                                    <td><span t-field="osp.create_date" t-options='{"widget": "date"}'/></td>
                                    
                                    <!-- Botones de Acción -->
                                    <td>
                                        <div class="d-flex justify-content-center gap-2">
                                            <a t-attf-href="/my/osp/duplicate/#{osp.id}" class="text-decoration-none" title="Duplicate">
                                                <i class="fa fa-copy text-purple" style="color: purple;"></i> <span style="color: purple;">Duplicate</span>
                                            </a>
                                            <a t-attf-href="/my/osp/form/#{osp.id}" class="text-decoration-none text-success" title="Open">
                                                Open <i class="fa fa-chevron-right"></i>
                                            </a>
                                            <a t-if="osp.state == 'draft'" t-attf-href="/my/osp/delete/#{osp.id}" class="text-decoration-none text-danger" title="Delete" onclick="return confirm('¿Estás seguro de eliminar este borrador?');">
                                                <i class="fa fa-trash-o"></i>
                                            </a>
                                        </div>
                                    </td>
                                </tr>
                            </t>
                        </tbody>
                    </table>
                </div>
            </div>

            <!-- MODAL "NEW FORM" INTERACTIVO -->
            <div class="modal fade" id="newOspModal" tabindex="-1" aria-labelledby="newOspModalLabel" aria-hidden="true">
                <div class="modal-dialog modal-dialog-centered">
                    <div class="modal-content">
                        <div class="modal-header border-0">
                            <h5 class="modal-title fw-bold" id="newOspModalLabel">Select Service Required</h5>
                            <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                        </div>
                        <div class="modal-body">
                            
                            <!-- PASO 1: Elegir Servicio -->
                            <div id="step1_service">
                                <div class="list-group">
                                    <t t-foreach="services" t-as="srv">
                                        <button type="button" class="list-group-item list-group-item-action d-flex justify-content-between align-items-center btn-select-service" t-att-data-id="srv.id">
                                            <t t-esc="srv.name"/>
                                            <i class="fa fa-chevron-right text-muted"></i>
                                        </button>
                                    </t>
                                </div>
                            </div>

                            <!-- PASO 2: Elegir Formulario -->
                            <div id="step2_template" style="display: none;">
                                <h5 class="fw-bold mb-3">Select Form Type</h5>
                                <form action="/my/osp/create" method="POST">
                                    <input type="hidden" name="csrf_token" t-att-value="request.csrf_token()"/>
                                    <input type="hidden" name="service_id" id="input_service_id"/>
                                    
                                    <div class="list-group" id="template_list">
                                        <t t-foreach="templates" t-as="tmp">
                                            <button type="submit" name="template_id" t-att-value="tmp.id" class="list-group-item list-group-item-action d-flex justify-content-between align-items-center template-option" t-att-data-service="tmp.service_id.id">
                                                <t t-esc="tmp.name"/>
                                                <i class="fa fa-chevron-right text-muted"></i>
                                            </button>
                                        </t>
                                    </div>
                                    <button type="button" class="btn btn-link mt-2 text-muted" id="btn_back_service">
                                        <i class="fa fa-arrow-left me-1"></i> Back
                                    </button>
                                </form>
                            </div>

                        </div>
                    </div>
                </div>
            </div>

            <!-- JAVASCRIPT DEL MODAL -->
            <script type="text/javascript">
                document.addEventListener("DOMContentLoaded", function() {
                    const step1 = document.getElementById('step1_service');
                    const step2 = document.getElementById('step2_template');
                    const modalTitle = document.getElementById('newOspModalLabel');
                    const inputServiceId = document.getElementById('input_service_id');
                    const templateOptions = document.querySelectorAll('.template-option');
                    
                    // Al seleccionar servicio...
                    document.querySelectorAll('.btn-select-service').forEach(btn => {
                        btn.addEventListener('click', function() {
                            const serviceId = this.getAttribute('data-id');
                            inputServiceId.value = serviceId;
                            
                            // Ocultar formularios que no sean de este servicio
                            templateOptions.forEach(opt => {
                                if(opt.getAttribute('data-service') === serviceId) {
                                    opt.style.display = 'flex';
                                } else {
                                    opt.style.display = 'none';
                                }
                            });

                            // Cambiar de vista
                            step1.style.display = 'none';
                            step2.style.display = 'block';
                            modalTitle.style.display = 'none'; // Ocultamos el título principal
                        });
                    });

                    // Botón atrás
                    document.getElementById('btn_back_service').addEventListener('click', function() {
                        step2.style.display = 'none';
                        step1.style.display = 'block';
                        modalTitle.style.display = 'block';
                    });
                });
            </script>
        </t>
    </template>

    <!-- 3. PANTALLA TEMPORAL DEL FORMULARIO (En lo que hacemos los PDFs) -->
    <template id="portal_osp_form_placeholder" name="Formulario OSP">
        <t t-call="portal.portal_layout">
            <div class="container mt-5 text-center">
                <i class="fa fa-wrench fa-5x text-muted mb-3"></i>
                <h2>Cargando Formulario: <t t-esc="osp.form_template_id.name"/></h2>
                <p class="text-muted">La versión web de este formulario está en construcción.</p>
                <a href="/my/osp" class="btn btn-primary mt-3">Volver a mi lista</a>
            </div>
        </t>
    </template>

</odoo>