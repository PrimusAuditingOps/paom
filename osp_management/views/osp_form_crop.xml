<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <template id="portal_osp_form_crop" name="OSP Crop Form">
        <t t-call="portal.portal_layout">
            <t t-set="data" t-value="osp.form_data or {}"/>
            
            <div class="container-fluid py-4">
                
                <!-- ENCABEZADO -->
                <div class="d-flex justify-content-between align-items-center mb-4">
                    <div>
                        <a href="/my/osp" class="text-decoration-none text-muted mb-2 d-inline-block"><i class="fa fa-arrow-left"></i> Back to list</a>
                        <h3 class="fw-bold mb-0 text-success"><i class="fa fa-leaf"></i> Crop</h3>
                        <p class="text-muted small mb-0">ORGANIC SYSTEM PLAN | Org-007 Rev.9</p>
                    </div>
                    <div>
                        <span id="save_status" class="text-muted me-3" style="display: none;">Saving...</span>
                        <!-- Quitamos el onclick y ponemos un ID -->
                        <button type="button" class="btn btn-outline-success me-2" id="btn_save_progress">
                            <i class="fa fa-save"></i> Save progress
                        </button>
                    </div>
                </div>

                <div class="row">
                    <!-- BARRA LATERAL -->
                    <div class="col-md-3 mb-4">
                        <div class="list-group shadow-sm sticky-top" style="top: 20px; z-index: 1;">
                            <a href="#sec1" class="list-group-item list-group-item-action active fw-bold" data-bs-toggle="list">1: General Information</a>
                            <a href="#sec4" class="list-group-item list-group-item-action fw-bold" data-bs-toggle="list">4: Crops &amp; Fields</a>
                            <a href="#sec18" class="list-group-item list-group-item-action fw-bold" data-bs-toggle="list">18: Affirmation (Firma)</a>
                        </div>
                    </div>

                    <!-- CONTENIDO -->
                    <div class="col-md-9">
                        <div class="tab-content bg-white p-4 rounded-3 shadow-sm">
                            
                            <!-- SECCIÓN 1 -->
                            <div class="tab-pane fade show active" id="sec1">
                                <h4 class="fw-bold mb-4">SECTION 1: General Information</h4>
                                
                                <div class="mb-4">
                                    <label class="fw-bold">Choose one:</label>
                                    <div class="form-check">
                                        <input class="form-check-input osp-input" type="radio" name="1_applicant_type" id="1_new" value="First time" t-att-checked="data.get('1_applicant_type') == 'First time'"/>
                                        <label class="form-check-label" for="1_new">First time applicant.</label>
                                    </div>
                                    <div class="form-check">
                                        <input class="form-check-input osp-input" type="radio" name="1_applicant_type" id="1_update" value="Update" t-att-checked="data.get('1_applicant_type') == 'Update'"/>
                                        <label class="form-check-label" for="1_update">This is an update of an Organic System Plan already submitted.</label>
                                    </div>
                                </div>

                                <div class="row mb-3">
                                    <div class="col-md-6">
                                        <label class="form-label fw-bold">1a. Organization Name:</label>
                                        <input type="text" class="form-control osp-input" name="1a_org_name" t-att-value="data.get('1a_org_name')"/>
                                    </div>
                                    <div class="col-md-6">
                                        <label class="form-label fw-bold">1b. dba Name (if applicable):</label>
                                        <input type="text" class="form-control osp-input" name="1b_dba_name" t-att-value="data.get('1b_dba_name')"/>
                                    </div>
                                </div>
                            </div>

                            <!-- SECCIÓN 4 (TABLA DINÁMICA) -->
                            <div class="tab-pane fade" id="sec4">
                                <h4 class="fw-bold mb-4">SECTION 4: Crops &amp; Fields</h4>
                                <p>4g. Complete the following table with the information for each location (sites):</p>
                                
                                <div class="table-responsive border rounded mb-3">
                                    <table class="table table-borderless table-hover mb-0">
                                        <thead class="bg-light text-muted small">
                                            <tr>
                                                <th>SITE ID/NAME</th>
                                                <th>SITE ADDRESS</th>
                                                <th>CITY, STATE</th>
                                                <th>ZIP</th>
                                                <th>ACTION</th>
                                            </tr>
                                        </thead>
                                        <tbody id="sites_tbody">
                                            <!-- JS llenará esto -->
                                        </tbody>
                                    </table>
                                </div>
                                <!-- Quitamos el onclick y ponemos un ID -->
                                <button type="button" class="btn btn-sm btn-outline-success" id="btn_add_site">
                                    <i class="fa fa-plus"></i> Add Site
                                </button>
                                
                                <input type="hidden" class="osp-input" name="4g_sites_json" id="4g_sites_json" t-att-value="data.get('4g_sites_json', '[]')"/>
                            </div>

                            <!-- SECCIÓN 18 (FIRMA) -->
                            <div class="tab-pane fade" id="sec18">
                                <h4 class="fw-bold mb-4">SECTION 18: Affirmation</h4>
                                <div class="alert alert-light border border-success rounded-3 mb-4">
                                    <h5 class="text-success fw-bold">*electronic signature is accepted*</h5>
                                    
                                    <div class="mb-3 mt-3">
                                        <label class="form-label fw-bold">Name: <span class="text-danger">*</span></label>
                                        <input type="text" class="form-control osp-input" name="18_name" id="req_name" t-att-value="data.get('18_name')"/>
                                    </div>
                                    <div class="mb-3">
                                        <label class="form-label fw-bold">Signature: <span class="text-danger">*</span></label>
                                        <input type="text" class="form-control osp-input" name="18_signature" id="req_sign" t-att-value="data.get('18_signature')"/>
                                    </div>
                                    <div class="mb-3">
                                        <label class="form-label fw-bold">Date: <span class="text-danger">*</span></label>
                                        <input type="date" class="form-control osp-input" name="18_date" id="req_date" t-att-value="data.get('18_date')"/>
                                    </div>
                                </div>

                                <!-- Quitamos el onclick y ponemos un ID -->
                                <button type="button" class="btn btn-success btn-lg w-100 fw-bold" id="btn_submit_osp">
                                    Submit Organic System Plan
                                </button>
                            </div>

                        </div>
                    </div>
                </div>
            </div>

            <!-- JAVASCRIPT NATIVO CERRADO -->
            <script type="text/javascript">
                document.addEventListener("DOMContentLoaded", function() {
                    const ospId = <t t-esc="osp.id"/>;
                    
                    // --- TABLA DINÁMICA ---
                    const sitesTbody = document.getElementById('sites_tbody');
                    const sitesJsonInput = document.getElementById('4g_sites_json');
                    let sitesData = [];
                    
                    try {
                        sitesData = JSON.parse(sitesJsonInput.value || '[]');
                    } catch(e) { sitesData = []; }

                    function renderSitesTable() {
                        sitesTbody.innerHTML = '';
                        if(sitesData.length === 0) {
                            sitesData.push({id: '', address: '', city: '', zip: ''});
                        }
                        
                        sitesData.forEach((site, index) => {
                            const tr = document.createElement('tr');
                            tr.innerHTML = `
                                <td><input type="text" class="form-control border-0 bg-transparent site-input" data-index="${index}" data-field="id" value="${site.id || ''}" placeholder="ID..."/></td>
                                <td><input type="text" class="form-control border-0 bg-transparent site-input" data-index="${index}" data-field="address" value="${site.address || ''}" placeholder="Address..."/></td>
                                <td><input type="text" class="form-control border-0 bg-transparent site-input" data-index="${index}" data-field="city" value="${site.city || ''}" placeholder="City..."/></td>
                                <td><input type="text" class="form-control border-0 bg-transparent site-input" data-index="${index}" data-field="zip" value="${site.zip || ''}" placeholder="Zip..."/></td>
                                <td><button type="button" class="btn btn-sm text-danger btn-delete-site" data-index="${index}"><i class="fa fa-trash"></i></button></td>
                            `;
                            sitesTbody.appendChild(tr);
                        });
                        sitesJsonInput.value = JSON.stringify(sitesData);
                        bindTableEvents(); // Asignar eventos cada vez que se redibuja
                    }

                    // Enlazamos eventos a los inputs y botones de la tabla dibujada
                    function bindTableEvents() {
                        document.querySelectorAll('.site-input').forEach(input => {
                            input.addEventListener('change', function() {
                                const idx = this.getAttribute('data-index');
                                const fld = this.getAttribute('data-field');
                                sitesData[idx][fld] = this.value;
                                sitesJsonInput.value = JSON.stringify(sitesData);
                            });
                        });
                        document.querySelectorAll('.btn-delete-site').forEach(btn => {
                            btn.addEventListener('click', function() {
                                const idx = this.getAttribute('data-index');
                                sitesData.splice(idx, 1);
                                renderSitesTable();
                            });
                        });
                    }

                    // Botón Add Site
                    document.getElementById('btn_add_site').addEventListener('click', function() {
                        sitesData.push({id: '', address: '', city: '', zip: ''});
                        renderSitesTable();
                    });

                    // --- GUARDADO GENERAL ---
                    function gatherFormData() {
                        let data = {};
                        document.querySelectorAll('.osp-input').forEach(el => {
                            if(el.type === 'radio' || el.type === 'checkbox') {
                                if(el.checked) data[el.name] = el.value;
                            } else {
                                data[el.name] = el.value;
                            }
                        });
                        return data;
                    }

                    function saveForm(isSubmit) {
                        const statusText = document.getElementById('save_status');
                        statusText.style.display = 'inline';
                        statusText.innerText = 'Saving...';
                        
                        const finalData = gatherFormData();

                        fetch(`/my/osp/save/${ospId}`, {
                            method: 'POST',
                            headers: { 'Content-Type': 'application/json' },
                            body: JSON.stringify({
                                jsonrpc: "2.0",
                                method: "call",
                                params: {
                                    form_data: finalData,
                                    is_submit: isSubmit
                                }
                            })
                        }).then(res => res.json())
                          .then(data => {
                              if(data.result &amp;&amp; data.result.success) {
                                  statusText.innerText = 'Saved!';
                                  setTimeout(() => statusText.style.display = 'none', 2000);
                                  if(isSubmit) window.location.href = '/my/osp';
                              } else {
                                  statusText.innerText = 'Error al guardar';
                                  statusText.classList.replace('text-muted', 'text-danger');
                              }
                          });
                    }

                    // Botón Guardar Borrador
                    document.getElementById('btn_save_progress').addEventListener('click', function() {
                        saveForm(false);
                    });

                    // Botón Enviar (Submit)
                    document.getElementById('btn_submit_osp').addEventListener('click', function() {
                        if(!document.getElementById('req_name').value || !document.getElementById('req_sign').value || !document.getElementById('req_date').value) {
                            alert("Please complete the electronic signature fields before submitting.");
                            return;
                        }
                        if(confirm("Are you sure you want to submit your Organic System Plan? You will not be able to edit it after submission.")) {
                            saveForm(true);
                        }
                    });

                    // Arrancar la vista
                    renderSitesTable();
                });
            </script>
        </t>
    </template>
</odoo>