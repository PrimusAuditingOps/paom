<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Expone osp_portal_only en la ficha de Usuario, en su PROPIA pestaña
         dentro del notebook — en vez de insertarse justo después del campo
         "login" (como en el primer intento). Ese punto era demasiado
         "concurrido": el usuario tiene otros módulos que también modifican
         esa misma zona de la ficha de Usuario, y la inserción ahí
         desalineaba el anclaje de esos otros módulos, causando errores de
         build que apuntaban a un módulo distinto (difícil de diagnosticar).
         Agregar una pestaña nueva al notebook es aditivo puro — no toca
         ninguna estructura existente de la que otro módulo pueda depender,
         así que es mucho más seguro sin cambiar el comportamiento esperado.
         Solo tiene sentido para usuarios de portal (share = True) — la
         pestaña completa queda oculta para un usuario interno. -->
    <record id="view_users_form_osp_portal_only" model="ir.ui.view">
        <field name="name">res.users.form.osp.portal.only</field>
        <field name="model">res.users</field>
        <field name="inherit_id" ref="base.view_users_form"/>
        <field name="arch" type="xml">
            <xpath expr="//notebook" position="inside">
                <page string="OSP Management" name="osp_management" invisible="not share">
                    <group>
                        <field name="osp_portal_only"/>
                    </group>
                </page>
            </xpath>
        </field>
    </record>
</odoo>
