<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="0">
        <record id="module_category_osp" model="ir.module.category">
            <field name="name">OSP Management</field>
            <field name="description">Access management for the OSP forms.</field>
            <field name="sequence">15</field>
        </record>

        <record id="group_osp_administrator" model="res.groups">
            <field name="name">OSP Administrator</field>
            <field name="category_id" ref="osp_management.module_category_osp"/>
            <field name="implied_ids" eval="[(4, ref('base.group_user'))]"/>
            <field name="users" eval="[(4, ref('base.user_root')), (4, ref('base.user_admin'))]"/>
        </record>

        <record id="group_osp_user" model="res.groups">
            <field name="name">OSP User</field>
            <field name="category_id" ref="osp_management.module_category_osp"/>
            <field name="implied_ids" eval="[(4, ref('base.group_user'))]"/>            
        </record>

        <!-- Usuario de portal "multicliente" (ej. quien llena OSP de varias empresas con el
             mismo correo). Se asigna a mano desde Ajustes > Técnico > Grupos (o desde el
             usuario). NO implica ningún grupo interno: sigue siendo un usuario de portal. El
             acceso a sus OSP va por osp.request.filled_by_id, no por su partner. -->
        <record id="group_osp_multiclient" model="res.groups">
            <field name="name">Multi-client Portal User</field>
            <field name="category_id" ref="osp_management.module_category_osp"/>
        </record>

        <!-- Multicliente: ve y edita los OSP que ELLA llenó (filled_by_id), sin importar a qué
             contacto/cliente apunten. Se suma (OR) a la regla del partner propio de abajo. -->
        <record id="osp_request_multiclient_rule" model="ir.rule">
            <field name="name">Multi-client portal: OSP Requests filled by the user</field>
            <field name="model_id" ref="model_osp_request"/>
            <field name="domain_force">[('filled_by_id', '=', user.id)]</field>
            <field name="groups" eval="[(4, ref('osp_management.group_osp_multiclient'))]"/>
            <field name="perm_read" eval="1"/>
            <field name="perm_write" eval="1"/>
            <field name="perm_create" eval="1"/>
            <field name="perm_unlink" eval="1"/>
        </record>

        <!-- Usuarios de portal propios de un cliente: además de sus OSP, ven y editan los OSP
             que un usuario multicliente llenó para SU empresa (no los de sus compañeros). -->
        <record id="osp_request_portal_customer_rule" model="ir.rule">
            <field name="name">Portal: OSP Requests filled for my company by multi-client users</field>
            <field name="model_id" ref="model_osp_request"/>
            <field name="domain_force">[('filled_by_multiclient', '=', True), ('customer_company_id', '=', user.partner_id.commercial_partner_id.id)]</field>
            <field name="groups" eval="[(4, ref('base.group_portal'))]"/>
            <field name="perm_read" eval="1"/>
            <field name="perm_write" eval="1"/>
            <field name="perm_create" eval="0"/>
            <field name="perm_unlink" eval="0"/>
        </record>

        <!-- Regla: El usuario de portal solo puede ver y editar sus propios formularios -->
        <record id="osp_request_portal_rule" model="ir.rule">
            <field name="name">Portal: User's own OSP Requests</field>
            <field name="model_id" ref="model_osp_request"/>
            <field name="domain_force">[('partner_id', '=', user.partner_id.id)]</field>
            <field name="groups" eval="[(4, ref('base.group_portal'))]"/>
            <field name="perm_read" eval="1"/>
            <field name="perm_write" eval="1"/>
            <field name="perm_create" eval="1"/>
            <field name="perm_unlink" eval="1"/>
        </record>

        <!-- Regla estándar de multi-compañía (mismo patrón que sale.order,
             account.move, etc.): un Administrador de OSP solo ve registros
             de sus "Compañías permitidas" (Ajustes > Usuarios). Un
             company_id vacío (registros creados antes de que este campo
             existiera) queda visible para cualquier compañía — convención
             nativa de Odoo, no hace falta backfill manual. No se aplica al
             grupo de portal: su propia regla (arriba) ya es más estricta
             (por partner_id), la de compañía sería redundante ahí. Se
             aplica tanto a OSP Administrator como a OSP User — ambos
             grupos solo difieren en el menú de Configuración, no en el
             alcance de datos que pueden ver. -->
        <record id="osp_request_company_rule" model="ir.rule">
            <field name="name">Multi-Company: OSP Requests</field>
            <field name="model_id" ref="model_osp_request"/>
            <field name="domain_force">['|', ('company_id', '=', False), ('company_id', 'in', company_ids)]</field>
            <field name="groups" eval="[(4, ref('osp_management.group_osp_administrator')), (4, ref('osp_management.group_osp_user'))]"/>
            <field name="perm_read" eval="1"/>
            <field name="perm_write" eval="1"/>
            <field name="perm_create" eval="1"/>
            <field name="perm_unlink" eval="1"/>
        </record>
    </data>
</odoo>