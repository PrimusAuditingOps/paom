<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="module_category_pao_site_plot_survey" model="ir.module.category">
        <field name="name">Site Plot Survey</field>
        <field name="description">Site/plot polygon capture and Calidad review</field>
        <field name="sequence">20</field>
    </record>

    <record id="group_salesperson_sites" model="res.groups">
        <field name="name">Site Plot Survey / Salesperson</field>
        <field name="category_id" ref="module_category_pao_site_plot_survey"/>
        <field name="implied_ids" eval="[(4, ref('sales_team.group_sale_salesman'))]"/>
        <field name="comment">Draws/edits site polygons, imports KML/Excel, sets the final quantity per service.</field>
    </record>

    <record id="group_calidad" model="res.groups">
        <field name="name">Site Plot Survey / Calidad</field>
        <field name="category_id" ref="module_category_pao_site_plot_survey"/>
        <field name="comment">Reviews site polygons and proposes the estimated quantity per service.</field>
    </record>
</odoo>
