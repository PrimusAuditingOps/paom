<?xml version="1.0" encoding="utf-8" ?>
<odoo>
    <record id="pao_reviewer_certifier_agreement_view_form" model="ir.ui.view">
        <field name="name">pao.reviewer.certifier.agreement.view.form</field>
        <field name="model">pao.reviewer.certifier.agreement</field>
        <field name="arch" type="xml">
            <form string="Agreements Form">
                <header>
                    <field name="document_status" invisible="1"/>
                    <button name="action_cancel" type="object" string="Cancel" invisible="document_status != 'sent'"/>
                    <field name="document_status" statusbar_visible="sent,done" widget="statusbar"/>
                </header>
                <sheet>
                    <group col="2">
                        <field name="signer_id" readonly="1"/>
                        <field name="document_type" readonly="1"/>
                        <field name="attachment_datas" invisible="1"/>
                        <field name="attachment_name" invisible="1"/>
                        <field name="attachment_id" invisible="1"/>
                        <field name="attachment_datas" filename="attachment_name" invisible="document_status != 'done'" readonly="1"/>
                    </group>
                </sheet>
                 <div class="oe_chatter">
                    <field name="message_follower_ids" groups="base.group_user"/>
                    <field name="message_ids"/>
                </div>
            </form>
        </field>
    </record>
    <record id="pao_reviewer_certifier_agreement_view_tree" model="ir.ui.view">
        <field name="name">pao.reviewer.certifier.agreement.view.tree</field>
        <field name="model">pao.reviewer.certifier.agreement</field>
        <field name="arch" type="xml">
            <tree string="Agreements Tree">
                <field name="title"/>
                <field name="document_status" decoration-success="document_status == 'done'" decoration-warning="document_status == 'cancel'" decoration-info="document_status == 'sent'" widget="badge"/>
                <field name="purchase_order_id" widget="many2one" column_invisible="not context.get('display_sale_order',False)"/>
            </tree>
        </field>
    </record>
    <record id="pao_reviewer_certifier_agreement_action" model="ir.actions.act_window">
        <field name="name">Reviewer and Certifier Agreements</field>
        <field name="res_model">pao.reviewer.certifier.agreement</field>
        <field name="view_mode">tree,form</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">Create Reviewer or Certifier Agreement
            </p>
        </field>
    </record>
</odoo>