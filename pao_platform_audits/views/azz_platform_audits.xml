<?xml version="1.0" encoding="utf-8" ?>
<odoo>
    <record id="pao_azz_platform_audits_view_form" model="ir.ui.view">
        <field name="name">pao.azz.platform.audits.view.form</field>
        <field name="model">pao.azz.platform.audits</field>
        <field name="arch" type="xml">
            <form string="Azz Platform Audits">
                <header>
                     <field name="state" widget="statusbar" statusbar_visible="not_found,needs_validation,found"/>
                </header>
                <sheet>
                   <group string="Audit Platform Information">
                        <group>
                            <field name="app_id"/>
                        </group>
                        <group>
                            <field name="audit_id"/>
                        </group>
                        <group>
                            <field name="audit_date"/>
                        </group>
                        <group>
                            <field name="status"/>
                        </group>
                        <group>
                            <field name="audit_template"/>
                        </group>
                        <group>
                            <field name="template_version"/>
                        </group>
                        <group>
                            <field name="organization"/>
                        </group>
                        <group>
                            <field name="entities"/>
                        </group>
                        <group>
                            <field name="coordinator"/>
                        </group>
                        <group>
                            <field name="auditor"/>
                        </group>
                        
                        <group>
                            <field name="country"/>
                        </group>
                        <group>
                            <field name="state"/>
                        </group>
                        <group>
                            <field name="city"/>
                        </group>
                        <group>
                            <field name="plc"/>
                        </group>
                    
                    </group>
                    
                    
                    <group string="Audit Odoo Information">
                        
                        
                        <group>
                            <label for="order_id" string="Sales Order"/>
                            <field nolabel="1" name="order_id"/>
                        </group>
                        <group>
                             <label for="order_state" string="Sales Order State"/>
                            <field nolabel="1" name="order_state"/>
                        </group>
                        
                        <group>
                            <label for="pruchase_id" string="Purchase Order"/>
                            <field nolabel="1" name="pruchase_id"/>
                        </group>
                        <group>
                            <label for="purchase_state" string="Purchase Order State"/>
                            <field nolabel="1" name="purchase_state"/>
                        </group>
                        
                        <group>
                            <field name="sale_order_line_name"/>
                        </group>
                        <group>
                            <field name="pruchase_partner_id"/>
                        </group>
                        <group>
                            <field name="organization_id"/>
                        </group>
                        <group>
                            <field name="registration_number_id"/>
                        </group>
                        <group>
                            <field name="coordinator_id"/>
                        </group>
                        
                        <group>
                            <field name="pruchase_country"/>
                        </group>
                        <group>
                            <field name="pruchase_id_state"/>
                        </group>
                        
                        <group>
                            <field name="pruchase_id_city"/>
                        </group>
                    
                    </group>
                </sheet>
                <div class="oe_chatter">
                    <field name="message_follower_ids" groups="base.group_user"/>
                    <field name="message_ids"/>
                </div>
            </form>
        </field>
    </record>

    <record id="pao_azz_platform_audits_view_tree" model="ir.ui.view">
        <field name="name">pao.azz.platform.audits.view.tree</field>
        <field name="model">pao.azz.platform.audits</field>
        <field name="arch" type="xml">

            <tree string="Azz Platform Audits">
                <field name="order_id"/>
                <field name="sale_order_line_id"/>
                <field name="order_state"/>
                <field name="pruchase_id"/>
                <field name="purchase_order_line_id"/>
                <field name="purchase_state"/>
                <field name="audit_id"/>
                <field name="app_id"/>
                <field name="audit_date"/>
                <field name="status"/>
                <field name="audit_template_id"/>
                <field name="audit_template_version_id"/>
                <field name="audit_template"/>
                <field name="template_version"/>
                <field name="registration_number_id"/>
                <field name="organization_id"/>
                <field name="organization"/>
                <field name="plc"/>
                <field name="auditor"/>
                <field name="coordinator"/>    
            </tree>
        </field>
    </record>


    <record id="pao_azz_platform_audits_action" model="ir.actions.act_window">
        <field name="name">Azz Audits</field>
        <field name="res_model">pao.azz.platform.audits</field>
        <field name="view_mode">tree,form</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">Create first Azz Audits
            </p>
        </field>
    </record>

    <menuitem id="pao_azz_platform_audits_finance"
            name="Azz Audits"
            parent="account.menu_finance_receivables"
            action="pao_azz_platform_audits_action"
            sequence="120"/>

</odoo>