<?xml version="1.0" encoding="utf-8" ?>
<odoo>

    <record id="sale_report_platform_audit_view_tree" model="ir.ui.view">
        <field name="name">sale.report.platform.audit.view.tree</field>
        <field name="model">sale.report</field>
        <field name="type">tree</field>
        <field name="inherit_id" ref="sale.sale_report_view_tree"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='product_id']" position="after">
                <field name="pao_platform_audit_ids" widget="many2many_tags" optional="hide"/>
            </xpath>
        </field>
    </record>

</odoo>