<?xml version="1.0" encoding="utf-8" ?>
<odoo>
  <record id="pao_azz_platform_audits_wizard_form" model="ir.ui.view">
    <field name="name">pao.azz.platform.audits.wizard.form</field>
    <field name="model">pao.azz.platform.audits.wizard</field>
    <field name="arch" type="xml">
      <form string="Import File">
        <sheet>
          <group>
            <field name="file" filename="file_name" />
            <field name="sheet_name" />
          </group>
          <footer>
            <button string="Upload" type="object" name="action_process_file" class="btn-primary"/>
            <button string="Cancel" class="btn-secondary" special="cancel"/>
          </footer>
        </sheet>
      </form>
    </field>
  </record>

  <record id="action_import_azz_platform_audits_wizard" model="ir.actions.act_window">
    <field name="name">Import File</field>
    <field name="res_model">pao.azz.platform.audits.wizard</field>
    <field name="view_mode">form</field>
    <field name="target">new</field>
    <field name="view_id" ref="pao_azz_platform_audits_wizard_form"/>
  </record>
</odoo>