<?xml version="1.0" encoding="utf-8" ?>
<odoo>
    <record id="pao_account_move_custom_exchange_rate_view" model="ir.ui.view">
        <field name="name">pao.account.move.custom.exchange.rate.view</field>
        <field name="model">account.move</field>
        <field name="inherit_id" ref="account.view_move_form"/>
        <field name="arch" type="xml">
            <field name="tax_cash_basis_origin_move_id" position="after">
                <field name="auto_exchange_rate_lines_value" style="width:80px"/>
                <button name="update_exchange_rate_lines_action" type="object" string="Apply" class="btn-primary"/>
            </field>

        </field>
    </record>
</odoo>