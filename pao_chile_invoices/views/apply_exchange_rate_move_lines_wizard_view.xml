<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="apply_exchange_rate_move_lines_wizard_form" model="ir.ui.view">
        <field name="name">apply.exchange.rate.move.lines.wizard.form</field>
        <field name="model">apply.exchange.rate.move.lines.wizard</field>
        <field name="arch" type="xml">
            <form>
                <group col="2">
                    <field name="move_id" invisible="1"/>
                    <field name="available_currency_ids" invisible="1"/>
                    <field name="filtered_line_ids" invisible="1"/>
                    <field name="exchange_rate_lines_value" invisible="context.get('undo_action') == True"/>
                    <field name="currency_id" invisible="manual_selection" options="{'no_quick_create': True, 'no_create_edit' : True}"/>
                    <field name="manual_selection"/>
                    <field name="available_line_ids" invisible="not manual_selection" widget="many2many_tags" options="{'no_quick_create': True, 'no_create_edit' : True}"/>
                </group>
                <footer>
                    <button string="Apply" name="apply_exchange_rate_lines_action" invisible="context.get('undo_action') == True" type="object" class="btn-primary"/>
                    <button string="Undo" name="undo_exchange_rate_lines_action" invisible="context.get('undo_action') == False" type="object" class="btn-primary"/>
                    <button string="Cancel" class="btn-secondary" special="cancel"/>
                </footer>
            </form>
        </field>
    </record>
</odoo>