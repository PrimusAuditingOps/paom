<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- Portal content of Chile quotations: the same format as the PDF (see sale.order._get_name_portal_content_view). -->
    <template id="sale_order_portal_content_chile" name="Sales Order Portal Content (Chile)">
        <t t-set="doc" t-value="sale_order.with_context(lang=sale_order._pao_quote_lang())"/>
        <t t-set="config" t-value="doc._pao_get_quote_config()"/>
        <t t-set="logo" t-value="config.logo or doc.company_id.sudo().logo"/>
        <div id="introduction" class="bg-white border p-4">
            <t t-call="pao_sale_quote_chile.pao_quote_styles"/>
            <img t-if="logo" t-att-src="image_data_uri(logo)" style="max-height: 70px;" class="mb-3" alt="Logo"/>
            <div class="o_pao_quote" t-out="doc._pao_render_quote_format()"/>
        </div>
    </template>

    <!-- The order total mixes alternatives and base currencies, so the portal does not show it for Chile quotations. -->
    <template id="sale_order_portal_template_chile" inherit_id="sale.sale_order_portal_template">
        <xpath expr="//h2[@data-id='total_amount']" position="attributes">
            <attribute name="t-if">not sale_order.pao_use_chile_format</attribute>
        </xpath>
        <xpath expr="//b[@data-id='amount_undiscounted']/ancestor::div[1]" position="attributes">
            <attribute name="t-if" add="and not sale_order.pao_use_chile_format" separator=" "/>
        </xpath>
        <xpath expr="//b[@data-id='total_amount']/parent::li" position="attributes">
            <attribute name="t-if">not sale_order.pao_use_chile_format</attribute>
        </xpath>
    </template>

</odoo>
