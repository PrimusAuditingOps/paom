<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Letter paper with room for the logo header and the black footer band.
         Assign it to the Chilean company: Settings > Companies > Document Layout > Paper format. -->
    <record id="paperformat_pao_quote_chile" model="report.paperformat">
        <field name="name">PAO Chile - Carta</field>
        <field name="default" eval="False"/>
        <field name="format">Letter</field>
        <field name="page_height">0</field>
        <field name="page_width">0</field>
        <field name="orientation">Portrait</field>
        <field name="margin_top">35</field>
        <field name="margin_bottom">32</field>
        <field name="margin_left">15</field>
        <field name="margin_right">15</field>
        <field name="header_line" eval="False"/>
        <field name="header_spacing">30</field>
        <field name="dpi">90</field>
    </record>
</odoo>
