<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="pao_quote_config_view_tree" model="ir.ui.view">
        <field name="name">pao.quote.config.tree</field>
        <field name="model">pao.quote.config</field>
        <field name="arch" type="xml">
            <tree>
                <field name="name"/>
                <field name="company_id" groups="base.group_multi_company"/>
            </tree>
        </field>
    </record>

    <record id="pao_quote_config_view_form" model="ir.ui.view">
        <field name="name">pao.quote.config.form</field>
        <field name="model">pao.quote.config</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <widget name="web_ribbon" title="Archived" bg_color="text-bg-danger" invisible="active"/>
                    <field name="logo" widget="image" class="oe_avatar"/>
                    <div class="oe_title">
                        <label for="name"/>
                        <h1><field name="name"/></h1>
                    </div>
                    <group>
                        <group>
                            <field name="company_id" options="{'no_create': True}"/>
                            <field name="signature_image" widget="image" options="{'size': [0, 90]}"/>
                            <field name="active" invisible="1"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Default Format" name="default_format">
                            <div class="text-muted mb-2">Placeholders: [[NUMERO]], [[CLIENTE]], [[CONTACTO]], [[EMAIL]], [[TELEFONO]], [[FECHA]], [[SALUDO]], [[TABLAS]] (tables built from the order lines) and [[FIRMA]] (signature image).</div>
                            <field name="default_format_template" options="{'codeview': true}"/>
                        </page>
                        <page string="Footer" name="footer">
                            <group>
                                <field name="footer_address"/>
                                <field name="footer_offices"/>
                                <field name="footer_email"/>
                                <field name="footer_phone"/>
                                <field name="footer_website"/>
                            </group>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <record id="pao_quote_config_action" model="ir.actions.act_window">
        <field name="name">Chile Quotation Format</field>
        <field name="res_model">pao.quote.config</field>
        <field name="view_mode">tree,form</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">Create the Chile quotation format of a company</p>
            <p>Quotations and orders of the companies listed here are printed with the regional format.</p>
        </field>
    </record>

</odoo>
