<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="pao_quote_config_view_tree" model="ir.ui.view">
        <field name="name">pao.quote.config.tree</field>
        <field name="model">pao.quote.config</field>
        <field name="arch" type="xml">
            <tree>
                <field name="name"/>
                <field name="company_id" groups="base.group_multi_company"/>
                <field name="title"/>
            </tree>
        </field>
    </record>

    <record id="pao_quote_config_view_form" model="ir.ui.view">
        <field name="name">pao.quote.config.form</field>
        <field name="model">pao.quote.config</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <widget name="web_ribbon" title="Archived" bg_color="text-bg-danger" invisible="active"/>
                    <field name="logo" widget="image" class="oe_avatar"/>
                    <div class="oe_title">
                        <label for="name"/>
                        <h1><field name="name"/></h1>
                    </div>
                    <group>
                        <group>
                            <field name="company_id" options="{'no_create': True}"/>
                            <field name="title"/>
                            <field name="active" invisible="1"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Introduction" name="intro">
                            <group>
                                <field name="intro_long"/>
                                <field name="intro_short"/>
                            </group>
                        </page>
                        <page string="Closing and Signature" name="closing">
                            <group>
                                <field name="billing_title"/>
                                <field name="closing"/>
                                <field name="signature_image" widget="image" options="{'size': [0, 90]}"/>
                                <field name="signature_text"/>
                                <field name="additional_title"/>
                            </group>
                        </page>
                        <page string="Footer" name="footer">
                            <group>
                                <field name="footer_address"/>
                                <field name="footer_offices"/>
                                <field name="footer_email"/>
                                <field name="footer_phone"/>
                                <field name="footer_website"/>
                            </group>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <record id="pao_quote_config_action" model="ir.actions.act_window">
        <field name="name">Quotation Format</field>
        <field name="res_model">pao.quote.config</field>
        <field name="view_mode">tree,form</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">Create the Chile quotation format of a company</p>
            <p>Quotations of the companies listed here are printed with the regional format.</p>
        </field>
    </record>

</odoo>
