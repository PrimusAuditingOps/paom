<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- ============================================================ -->
    <!-- Categories                                                   -->
    <!-- ============================================================ -->
    <record id="pao_quote_category_view_tree" model="ir.ui.view">
        <field name="name">pao.quote.category.tree</field>
        <field name="model">pao.quote.category</field>
        <field name="arch" type="xml">
            <tree editable="bottom">
                <field name="sequence" widget="handle"/>
                <field name="name"/>
                <field name="company_id" groups="base.group_multi_company" optional="show"/>
                <field name="active" column_invisible="True"/>
            </tree>
        </field>
    </record>

    <record id="pao_quote_category_action" model="ir.actions.act_window">
        <field name="name">Quotation Categories</field>
        <field name="res_model">pao.quote.category</field>
        <field name="view_mode">tree</field>
    </record>

    <!-- ============================================================ -->
    <!-- Schemes                                                      -->
    <!-- ============================================================ -->
    <record id="pao_quote_scheme_view_tree" model="ir.ui.view">
        <field name="name">pao.quote.scheme.tree</field>
        <field name="model">pao.quote.scheme</field>
        <field name="arch" type="xml">
            <tree>
                <field name="sequence" widget="handle"/>
                <field name="name"/>
                <field name="use_long_intro"/>
                <field name="company_id" groups="base.group_multi_company" optional="show"/>
            </tree>
        </field>
    </record>

    <record id="pao_quote_scheme_view_form" model="ir.ui.view">
        <field name="name">pao.quote.scheme.form</field>
        <field name="model">pao.quote.scheme</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <widget name="web_ribbon" title="Archived" bg_color="text-bg-danger" invisible="active"/>
                    <div class="oe_title">
                        <label for="name"/>
                        <h1><field name="name"/></h1>
                    </div>
                    <group>
                        <group>
                            <field name="use_long_intro"/>
                            <field name="company_id" groups="base.group_multi_company" options="{'no_create': True}"/>
                            <field name="active" invisible="1"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Information Blocks" name="blocks">
                            <field name="block_ids">
                                <tree>
                                    <field name="sequence" widget="handle"/>
                                    <field name="name"/>
                                    <field name="position"/>
                                    <field name="audience"/>
                                </tree>
                            </field>
                        </page>
                        <page string="Products" name="products">
                            <field name="product_tmpl_ids" readonly="1">
                                <tree>
                                    <field name="name"/>
                                    <field name="pao_quote_name"/>
                                    <field name="pao_quote_table_id"/>
                                    <field name="pao_quote_combine"/>
                                </tree>
                            </field>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <record id="pao_quote_scheme_action" model="ir.actions.act_window">
        <field name="name">Audit Schemes</field>
        <field name="res_model">pao.quote.scheme</field>
        <field name="view_mode">tree,form</field>
    </record>

    <!-- ============================================================ -->
    <!-- Table formats                                                -->
    <!-- ============================================================ -->
    <record id="pao_quote_table_view_tree" model="ir.ui.view">
        <field name="name">pao.quote.table.tree</field>
        <field name="model">pao.quote.table</field>
        <field name="arch" type="xml">
            <tree>
                <field name="sequence" widget="handle"/>
                <field name="name"/>
                <field name="category_id"/>
                <field name="style"/>
                <field name="header_label" optional="show"/>
                <field name="footer_label" optional="hide"/>
                <field name="company_id" groups="base.group_multi_company" optional="show"/>
            </tree>
        </field>
    </record>

    <record id="pao_quote_table_view_form" model="ir.ui.view">
        <field name="name">pao.quote.table.form</field>
        <field name="model">pao.quote.table</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <widget name="web_ribbon" title="Archived" bg_color="text-bg-danger" invisible="active"/>
                    <div class="oe_title">
                        <label for="name"/>
                        <h1><field name="name"/></h1>
                    </div>
                    <group>
                        <group string="Table">
                            <field name="category_id"/>
                            <field name="style"/>
                            <field name="header_label"/>
                            <field name="price_label"/>
                            <field name="band_label"/>
                            <field name="footer_label"/>
                        </group>
                        <group string="Total">
                            <field name="show_total"/>
                            <field name="total_label" invisible="not show_total"/>
                            <field name="company_id" groups="base.group_multi_company" options="{'no_create': True}"/>
                            <field name="active" invisible="1"/>
                        </group>
                    </group>
                    <group string="Notes below the table">
                        <field name="notes"/>
                        <field name="notes_after"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="pao_quote_table_action" model="ir.actions.act_window">
        <field name="name">Table Formats</field>
        <field name="res_model">pao.quote.table</field>
        <field name="view_mode">tree,form</field>
    </record>

    <!-- ============================================================ -->
    <!-- Information blocks                                           -->
    <!-- ============================================================ -->
    <record id="pao_quote_block_view_tree" model="ir.ui.view">
        <field name="name">pao.quote.block.tree</field>
        <field name="model">pao.quote.block</field>
        <field name="arch" type="xml">
            <tree>
                <field name="sequence" widget="handle"/>
                <field name="name"/>
                <field name="position"/>
                <field name="apply_always"/>
                <field name="scheme_ids" widget="many2many_tags"/>
                <field name="audience"/>
                <field name="company_id" groups="base.group_multi_company" optional="show"/>
            </tree>
        </field>
    </record>

    <record id="pao_quote_block_view_form" model="ir.ui.view">
        <field name="name">pao.quote.block.form</field>
        <field name="model">pao.quote.block</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <widget name="web_ribbon" title="Archived" bg_color="text-bg-danger" invisible="active"/>
                    <div class="oe_title">
                        <label for="name"/>
                        <h1><field name="name"/></h1>
                    </div>
                    <group>
                        <group>
                            <field name="position"/>
                            <field name="show_title"/>
                            <field name="sequence"/>
                        </group>
                        <group>
                            <field name="apply_always"/>
                            <field name="scheme_ids" widget="many2many_tags" invisible="apply_always"/>
                            <field name="audience"/>
                            <field name="company_id" groups="base.group_multi_company" options="{'no_create': True}"/>
                            <field name="active" invisible="1"/>
                        </group>
                    </group>
                    <field name="content"/>
                </sheet>
            </form>
        </field>
    </record>

    <record id="pao_quote_block_view_search" model="ir.ui.view">
        <field name="name">pao.quote.block.search</field>
        <field name="model">pao.quote.block</field>
        <field name="arch" type="xml">
            <search>
                <field name="name"/>
                <field name="scheme_ids"/>
                <filter string="Billing" name="billing" domain="[('position', '=', 'billing')]"/>
                <filter string="Additional Information" name="additional" domain="[('position', '=', 'additional')]"/>
                <filter string="Annex" name="annex" domain="[('position', '=', 'annex')]"/>
                <separator/>
                <filter string="Archived" name="inactive" domain="[('active', '=', False)]"/>
                <group expand="0" string="Group By">
                    <filter string="Position" name="group_position" context="{'group_by': 'position'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="pao_quote_block_action" model="ir.actions.act_window">
        <field name="name">Information Blocks</field>
        <field name="res_model">pao.quote.block</field>
        <field name="view_mode">tree,form</field>
        <field name="context">{'search_default_group_position': 1}</field>
    </record>

</odoo>
