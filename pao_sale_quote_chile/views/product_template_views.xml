<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="product_template_form_view_pao_quote_chile" model="ir.ui.view">
        <field name="name">product.template.form.pao.quote.chile</field>
        <field name="model">product.template</field>
        <field name="inherit_id" ref="product.product_template_form_view"/>
        <field name="arch" type="xml">
            <xpath expr="//notebook" position="inside">
                <page string="Chile Quotation" name="pao_quote_chile" invisible="not sale_ok">
                    <group>
                        <group>
                            <field name="pao_quote_scheme_id"/>
                            <field name="pao_quote_table_id"/>
                            <field name="pao_quote_combine"/>
                        </group>
                        <group>
                            <field name="pao_quote_name"/>
                        </group>
                    </group>
                    <group string="Footnote">
                        <field name="pao_quote_note" nolabel="1" colspan="2"/>
                    </group>
                </page>
            </xpath>
        </field>
    </record>
</odoo>
