<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="pao_quote_rate_view_tree" model="ir.ui.view">
        <field name="name">pao.quote.rate.tree</field>
        <field name="model">pao.quote.rate</field>
        <field name="arch" type="xml">
            <tree>
                <field name="sequence" widget="handle"/>
                <field name="name"/>
                <field name="template_ids" widget="many2many_tags" optional="show"/>
                <field name="company_id" groups="base.group_multi_company" optional="show"/>
            </tree>
        </field>
    </record>

    <record id="pao_quote_rate_view_form" model="ir.ui.view">
        <field name="name">pao.quote.rate.form</field>
        <field name="model">pao.quote.rate</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <widget name="web_ribbon" title="Archived" bg_color="text-bg-danger" invisible="active"/>
                    <div class="oe_title">
                        <label for="name"/>
                        <h1><field name="name"/></h1>
                    </div>
                    <group>
                        <group>
                            <field name="company_id" groups="base.group_multi_company" options="{'no_create': True}"/>
                            <field name="active" invisible="1"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Format" name="content">
                            <div class="text-muted mb-2">Placeholders: [[NUMERO]], [[CLIENTE]], [[CONTACTO]], [[EMAIL]], [[TELEFONO]], [[PAIS]], [[FECHA]], [[SALUDO]] and [[FIRMA]] (signature image).</div>
                            <field name="content" nolabel="1" options="{'codeview': true}"/>
                        </page>
                        <page string="Quotation Templates" name="templates">
                            <field name="template_ids" readonly="1">
                                <tree>
                                    <field name="name"/>
                                </tree>
                            </field>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <record id="pao_quote_rate_view_search" model="ir.ui.view">
        <field name="name">pao.quote.rate.search</field>
        <field name="model">pao.quote.rate</field>
        <field name="arch" type="xml">
            <search>
                <field name="name"/>
                <filter string="Archived" name="inactive" domain="[('active', '=', False)]"/>
            </search>
        </field>
    </record>

    <record id="pao_quote_rate_action" model="ir.actions.act_window">
        <field name="name">Quotation Rate Sheets</field>
        <field name="res_model">pao.quote.rate</field>
        <field name="view_mode">tree,form</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">Create a quotation rate sheet</p>
            <p>Rate sheets are linked to quotation templates and loaded in the quotations of the Chilean company.</p>
        </field>
    </record>

</odoo>
