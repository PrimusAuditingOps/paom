<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Only visible for companies with the Chile quotation format. -->
    <record id="view_order_form_pao_quote_chile" model="ir.ui.view">
        <field name="name">sale.order.form.pao.quote.chile</field>
        <field name="model">sale.order</field>
        <field name="inherit_id" ref="sale.view_order_form"/>
        <field name="arch" type="xml">
            <xpath expr="//notebook" position="inside">
                <page string="Quotation Format" name="pao_quote_format" invisible="not pao_use_chile_format">
                    <field name="pao_use_chile_format" invisible="1"/>
                    <div class="mb-2">
                        <button name="action_pao_generate_quote_format"
                                type="object"
                                string="Generate Format"
                                class="btn-secondary"
                                icon="fa-refresh"
                                invisible="pao_quote_format"/>
                        <button name="action_pao_generate_quote_format"
                                type="object"
                                string="Generate Format"
                                class="btn-secondary"
                                icon="fa-refresh"
                                invisible="not pao_quote_format"
                                confirm="The format will be loaded again from the rate sheet of the quotation template. Your manual changes will be lost. Continue?"/>
                        <span class="text-muted ms-2">Loaded from the rate sheet of the quotation template with the customer data; edit it freely afterwards.</span>
                    </div>
                    <field name="pao_quote_format" nolabel="1" options="{'codeview': true}"/>
                </page>
            </xpath>
        </field>
    </record>

    <record id="sale_order_template_view_form_pao_quote_chile" model="ir.ui.view">
        <field name="name">sale.order.template.form.pao.quote.chile</field>
        <field name="model">sale.order.template</field>
        <field name="inherit_id" ref="sale_management.sale_order_template_view_form"/>
        <field name="arch" type="xml">
            <xpath expr="//notebook[@name='main_book']" position="before">
                <group name="pao_quote_rate">
                    <group>
                        <field name="pao_quote_rate_id" options="{'no_quick_create': True}"/>
                    </group>
                </group>
            </xpath>
        </field>
    </record>
</odoo>
