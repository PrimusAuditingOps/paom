msgid ""
"<b>DÉCIMA CUARTA- CUMPLIMIENTO DE TIEMPOS- “PAOMx”</b> se compromete a emitir \n"
"                    los entregables finales del proceso de evaluación en un plazo no mayor a \n"
"                    10 días laborales."
msgstr ""

#. module: pao_sign_sa
#: model_terms:ir.ui.view,arch_db:pao_sign_sa.sa_globalgap_scheme
msgid ""
"<b>DÉCIMA CUARTA. -ALERTAS SANITARIAS. - \"El Cliente\"</b> \n"
"                    se obliga a notificar oportunamente a <b>\"PAOMX\"</b> cuando esté implicado en una alerta sanitaria, en una investigación por una entidad \n"
"                    competente o en una recuperación de producto contaminado (máximo dentro de los siguientes 3 días de presentarse) y las acciones \n"
"                    correctivas realizadas. <b>\"El Cliente\"</b> se obliga bajo los términos de este instrumento a cooperar y suministrar evidencias de \n"
"                    cumplimiento de las normas GLOBALG.A.P. relevantes a <b>“PAOMX”</b> sobre cualquier evento o reclamación que pudiera tener un impacto \n"
"                    sobre el estado de la Certificación/la Declaración GLOBALG.A.P. transmitido a <b>“PAOMX”</b> o la Secretaría de GLOBALG.A.P."
msgstr ""

#. module: pao_sign_sa
#: model_terms:ir.ui.view,arch_db:pao_sign_sa.sa_nop_lpo_scheme
msgid ""
"<b>DÉCIMA CUARTA. -ENTREGA DE DOCUMENTO DE CERTIFICACIÓN. -</b> \n"
"                    Una vez concluida la auditoría, <b>\"PAOMX\"</b> contará con  plazo de 45 días \n"
