#. module: pao_sign_sa
#: model_terms:ir.ui.view,arch_db:pao_sign_sa.sa_haccp_scheme
msgid ""
"<b>DÉCIMA-RESPONSABILIDAD LIMITAD -</b> sPor este medio se le comunica al \n"
"                    cliente que se libera a <b>“PAOMx”</b> y sus respectivos afiliados, de cualquier \n"
"                    pérdida o responsabilidad sufrida por el Cliente, como se define a \n"
"                    continuación, como consecuencia de los servicios prestados en virtud del \n"
"                    presente Acuerdo. Dicha liberación incluirá cualquier daño real, \n"
"                    accidentales, consecuentes u otros, más allá de las cantidades pagadas \n"
"                    a <b>“PAOMx”</b> por la auditoría realizada y / o facilitada por <b>“PAOMx”. “EL CLIENTE\"</b> \n"
"                    reconoce y acepta que la responsabilidad de <b>“PAOMx”</b> se limita únicamente \n"
"                    al trabajo de auditoría realizado por él, y las partes reconocen expresamente \n"
"                    que <b>“PAOMx”</b> no es responsable de los productos básicos del cliente, su \n"
"                    seguridad, o calidad."
msgstr ""

#. module: pao_sign_sa
#: model_terms:ir.ui.view,arch_db:pao_sign_sa.sa_globalgap_scheme
msgid ""
"<b>DÉCIMA. -ACCESO A PAOMX. - \"El Cliente\" </b>se obliga a facilitar los medios necesarios para la realización de la auditoría/inspección, \n"
"                    incluyendo el acceso a los documentos y registros, instalaciones, oficinas, áreas de almacenamiento de producto y al personal operativo \n"
"                    para los propósitos de la evaluación; sin costo para <b>\"PAOMX\"</b>. Adicionalmente, cuando le sea requerido por <b>\"PAOMX\"</b>, permitirá la participación \n"
"                    de observadores y la auditoría/inspección física completa de las instalaciones de los subcontratistas que intervengan en la producción o \n"
"                    manipulación de producto. <b>\"El Cliente\"</b> deberá asegurarse que el subcontratista permite, previa solicitud de PAOMX , el libre acceso que se \n"
"                    estipula en esta Cláusula."
msgstr ""

#. module: pao_sign_sa
#: model_terms:ir.ui.view,arch_db:pao_sign_sa.sa_nop_lpo_scheme
msgid ""
"<b>DÉCIMA. -ACCESO A PAOMX. - \"El Cliente\" </b>se obliga a permitir el acceso \n"
"                    y facilitar los medios necesarios para la realización de la auditoría/inspección, \n"
"                    incluyendo pero no limitado a: los documentos, ventas, bases de datos y registros \n"
"                    justificativos pertinentes, resultados de los programas de aseguramiento de \n"
"                    calidad, unidades de producción, instalaciones, oficinas, áreas de almacenamiento \n"
"                    y al personal operativo para los propósitos de la evaluación, así como, cualquier \n"
"                    información necesaria para efectos de la prestación del servicio; sin costo para \n"
"                    <b>\"PAOMX\"</b>. Adicionalmente, cuando le sea requerido por \"PAOMX\", permitirá la \n"
"                    participación de observadores y la auditoría/inspección física completa de las \n"
"                    instalaciones de los subcontratistas que intervengan en la producción o \n"
"                    manipulación de producto. <b>\"El Cliente\"</b> deberá asegurarse que el subcontratista \n"
"                    permite, previa solicitud, el libre acceso que se estipula en esta Cláusula.\n"
"                    <br/><br/>\n"
"                    <b>“Las Partes”</b> manifiestan y reconocen expresamente que, por virtud de este \n"
"                    Acuerdo, no adquieren vinculación laboral alguna entre ellas ni con el personal \n"
"                    asignado por cada una de ellas para la realización de los Servicios.\n"
"                    <br/><br/>\n"
"                    El personal operativo que para los propósitos de evaluación acceda a las \n"
"                    instalaciones de <b>\"El Cliente\"</b>, no será considerado en ningún caso como trabajador \n"
"                    de <b>\"El Cliente\"</b> para los efectos de las disposiciones laborales y de seguridad \n"
"                    social vigentes."
msgstr ""

#. module: pao_sign_sa
