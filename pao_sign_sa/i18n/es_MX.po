#. module: pao_sign_sa
#: model_terms:ir.ui.view,arch_db:pao_sign_sa.sa_lpo_ue_scheme
msgid ""
"<b>\"The Client\"</b> authorizes <b>\"PAOMX\"</b> to request the information it considers pertinent before granting the \n"
"                                    certification in case it has been previously certified by another certification body."
msgstr ""

#. module: pao_sign_sa
#: model_terms:ir.ui.view,arch_db:pao_sign_sa.sa_lpo_ue_scheme
msgid ""
"<b>\"The Client\"</b> authorizes <b>\"PAOMX\"</b> under the terms of this instrument, to transfer its file if there is a \n"
"                                    change of certification body or, in case of withdrawal from organic production, to keep the control file \n"
"                                    for five years."
msgstr ""

#. module: pao_sign_sa
#: model_terms:ir.ui.view,arch_db:pao_sign_sa.sa_lpo_ue_scheme
msgid ""
"<b>\"The Client\"</b> authorizes the exchange of information between certification bodies in case subcontractors are \n"
"                                    subject to controls by different certification bodies."
msgstr ""

#. module: pao_sign_sa
#: model_terms:ir.ui.view,arch_db:pao_sign_sa.sa_lpo_ue_scheme
msgid ""
"<b>\"The Client\"</b> undertakes to inform the purchasers of the products in writing without undue delay and to exchange \n"
"                                    relevant information with the supervisory authority or <b>\"PAOMX\"</b>, if a suspicion of non-compliance is proven, \n"
"                                    that such suspicion cannot be ruled out, or that a non-compliance affecting the integrity of the products in \n"
"                                    question is proven."
msgstr ""

#. module: pao_sign_sa
#: model_terms:ir.ui.view,arch_db:pao_sign_sa.sa_lpo_ue_scheme
msgid ""
"<b>\"The Client\"</b> undertakes, if required, to provide to importers, control authorities or control bodies of \n"
"                                    importers and national authorities of the Union and of those third countries, all the information necessary \n"
"                                    to identify the operators who are its suppliers and the control authorities or control bodies of those suppliers, \n"
"                                    to ensure the traceability of the organic or in-conversion product in question."
msgstr ""

#. module: pao_sign_sa
#: model_terms:ir.ui.view,arch_db:pao_sign_sa.sa_lpo_ue_scheme
