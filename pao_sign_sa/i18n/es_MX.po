#. module: pao_sign_sa
#: model_terms:ir.ui.view,arch_db:pao_sign_sa.sa_pgfs_scheme_usa
msgid ""
"<b>CONSENT TO RELEASE INFORMATION - GFSI AND SCHEME OWNER.</b> \n"
"                            As part of its requirements for benchmarking Audit schemes to the GFSI standard, GFSI requires \n"
"                            that all contracting parties for GFSI benchmarked audits authorize the Certification Body to \n"
"                            make all audit records from Customer's audit available to the Scheme Owner (Azzule) and GFSI. \n"
"                            By executing this Agreement, Customer hereby consents to and authorizes Primus Auditing Ops to \n"
"                            release all audit documents to the Scheme Owner and GFSI for internal use purposes."
msgstr ""

#. module: pao_sign_sa
#: model_terms:ir.ui.view,arch_db:pao_sign_sa.sa_pgfs_scheme_spanish
msgid ""
"<b>CONSENTIMIENTO PARA DAR INFORMACION - GFSI Y DUENO DEL ESQUEMA.</b> \n"
"                            Como parte de sus requisitos para evaluar los esquemas de auditoria con el estándar de GFSI, GFSI requirió que \n"
"                            todas las partes involucradas en las auditorias evaluadas por GFSI autoricen al organismo de certificación a \n"
"                            poner en disposición del dueno del esquema, Azzule y GFSI, todos los registros de auditoria del cliente. Al \n"
"                            ejecutar este acuerdo, el cliente acepta y autoriza a Primus Auditing Ops a entregar todos los documentos de \n"
"                            auditoria al dueno del Esquema y a GFSI para fines de uso interno."
msgstr ""

#. module: pao_sign_sa
#: model_terms:ir.ui.view,arch_db:pao_sign_sa.sa_pgfs_scheme
msgid ""
"<b>CONSENTIMIENTO PARA DAR INFORMACIÓN - GFSI Y DUEÑO DEL ESQUEMA.</b> \n"
"                            Como parte de sus requisitos para evaluar los \n"
"                            esquemas de auditoría con el estándar de GFSI, GFSI requirió \n"
"                            que todas las partes involucradas en las auditorias evaluadas \n"
"                            por GFSI autoricen al organismo de certificación a poner en \n"
"                            disposición del dueño del esquema, Azzule y GFSI, todos los \n"
"                            registros de auditoría del cliente. Al ejecutar este acuerdo, \n"
"                            el cliente acepta y autoriza a Primus Auditing Ops a entregar \n"
"                            todos los documentos de auditoría al dueño del Esquema y a GFSI \n"
"                            para fines de uso interno."
msgstr ""

#. module: pao_sign_sa
#: model_terms:ir.ui.view,arch_db:pao_sign_sa.sa_haccp_scheme
msgid ""
"<b>CUARTA- PRECIO - “PAOMx”</b> se obliga a mantener inalterables los precios \n"
"                    de los servicios indicados en la cláusula PRIMERA durante la vigencia de \n"
"                    este acuerdo siempre y cuando se conserven las características de la organización \n"
"                    a auditar (información del alcance de auditoría registrado en el documento \n"
"                    Solicitud Estándar de Servicio de Auditoría). En caso de que dichas \n"
"                    características varíen, <b>“EL CLIENTE\"</b> deberá comunicárselo a <b>“PAOMx”</b>, \n"
"                    con el fin de generar un nuevo acuerdo de servicios."
msgstr ""

#. module: pao_sign_sa
#: model_terms:ir.ui.view,arch_db:pao_sign_sa.sa_add_globalgap_scheme
msgid ""
"<b>CUARTA. -DOMICILIO Y NOTIFICACIONES. - “Las Partes”</b> señalan como sus domicilios los establecidos en el \n"
"                    <b>Acuerdo de Servicios de Certificación (FAN-05)</b>. Los avisos o notificaciones deberán ser por escrito y se considerarán \n"
"                    debidamente practicados si se entregan en persona o por correo certificado con acuse de recibo en dichas direcciones, debiéndose \n"
"                    dirigir a las personas que las partes autoricen para tal efecto."
msgstr ""

#. module: pao_sign_sa
#: model_terms:ir.ui.view,arch_db:pao_sign_sa.sa_nop_lpo_scheme
msgid ""
"<b>CUARTA. -PAGO. - \"PAOMX\"</b> tiene derecho a recibir el pago íntegro \n"
"                    por los servicios que preste, de conformidad con lo estipulado en el \n"
"                    clausulado de este acuerdo, por lo menos 48 horas antes de la fecha acordada \n"
"                    para la auditoría/inspección en sitio y/o las condiciones de crédito \n"
"                    previamente pactadas entre “Las partes”, lo que resulte aplicable."
msgstr ""

