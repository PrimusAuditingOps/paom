#: model_terms:ir.ui.view,arch_db:pao_sign_sa.sa_globalgap_cert008_scheme_spanish
msgid "<b>Teléfono - Fax: </b>"
msgstr ""

#. module: pao_sign_sa
#: model_terms:ir.ui.view,arch_db:pao_sign_sa.sa_pgfs_scheme_spanish
#: model_terms:ir.ui.view,arch_db:pao_sign_sa.sa_primus_standar_scheme_spanish
