msgstr ""

#. module: pao_sign_sa
#: model_terms:ir.ui.view,arch_db:pao_sign_sa.sa_lpo_ue_scheme
msgid ""
"<b>DÉCIMA TERCERA. -ALERTAS SANITARIAS Y SOSPECHA DE INCUMPLIMIENTO. - \"El Cliente\"</b> se obliga a notificar \n"
"                            oportunamente a \"PAOMX\" cuando esté implicado en una alerta sanitaria o recuperación de producto contaminado \n"
"                            (máximo dentro de los siguientes 3 días de presentarse) y las acciones correctivas realizadas. En caso de \n"
