<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="module_category_pao_sales_commission" model="ir.module.category">
        <field name="name">Commissions</field>
        <field name="description">Sales Commission Management</field>
        <field name="sequence">20</field>
    </record>

    <record id="group_pao_sales_commission_read" model="res.groups">
        <field name="name">Commissions / Read (Salesperson and Coordinators)</field>
        <field name="category_id" ref="module_category_pao_sales_commission"/>
        <field name="comment">You can view only the commissions that apply to you.</field>
    </record>

    <record id="group_pao_sales_finance_commission" model="res.groups">
        <field name="name">Commissions / Finances</field>
        <field name="category_id" ref="module_category_pao_sales_commission"/>
        <field name="implied_ids" eval="[(4, ref('group_pao_sales_commission_read'))]"/>
        <field name="comment">Reviews commissions sent for approval by the Commissions Manager: can approve or reject them.</field>
        <field name="users" eval="[(4, ref('base.user_admin'))]"/>
    </record>

    <record id="group_pao_sales_commission_manager" model="res.groups">
        <field name="name">Commissions / Manager</field>
        <field name="category_id" ref="module_category_pao_sales_commission"/>
        <field name="implied_ids" eval="[(4, ref('group_pao_sales_commission_read'))]"/>
        <field name="comment">Can send commissions that are ready ("Submit for Approval") to Finance for approval.</field>
    </record>

    <!-- Reglas de registro: un usuario del grupo "Consulta" sólo ve las
         comisiones donde es el vendedor de la venta o el comisionista
         relacionado. Finanzas ve todo (no se le agrega regla restrictiva). -->
    <record id="rule_pao_sales_commission_my_queries" model="ir.rule">
        <field name="name">Commissions: only one's own (read)</field>
        <field name="model_id" ref="model_pao_sales_commission"/>
        <field name="domain_force">['|', ('user_id', '=', user.id), ('related_user_id', '=', user.id)]</field>
        <field name="groups" eval="[(4, ref('group_pao_sales_commission_read'))]"/>
        <field name="perm_read">1</field>
        <field name="perm_write">0</field>
        <field name="perm_create">0</field>
        <field name="perm_unlink">0</field>
    </record>

    <record id="rule_pao_sales_finance_commission_all" model="ir.rule">
        <field name="name">Committees: Finance oversees them all</field>
        <field name="model_id" ref="model_pao_sales_commission"/>
        <field name="domain_force">[(1, '=', 1)]</field>
        <field name="groups" eval="[(4, ref('group_pao_sales_finance_commission'))]"/>
        <field name="perm_read">1</field>
        <field name="perm_write">1</field>
        <field name="perm_create">1</field>
        <field name="perm_unlink">1</field>
    </record>

    <!-- Mismas reglas que arriba, pero para el detalle de líneas de
         comisión, en caso de que se consulten directamente en vez de a
         través del padre (por ejemplo, vía API/ORM). -->
    <record id="rule_pao_sales_commission_line_my_queries" model="ir.rule">
        <field name="name">Commission lines: only one's own (read)</field>
        <field name="model_id" ref="model_pao_sales_commission_line"/>
        <field name="domain_force">['|', ('commission_id.user_id', '=', user.id), ('commission_id.related_user_id', '=', user.id)]</field>
        <field name="groups" eval="[(4, ref('group_pao_sales_commission_read'))]"/>
        <field name="perm_read">1</field>
        <field name="perm_write">0</field>
        <field name="perm_create">0</field>
        <field name="perm_unlink">0</field>
    </record>

    <record id="rule_pao_sales_finance_commission_line_all" model="ir.rule">
        <field name="name">Commission lines: Finance oversees them all</field>
        <field name="model_id" ref="model_pao_sales_commission_line"/>
        <field name="domain_force">[(1, '=', 1)]</field>
        <field name="groups" eval="[(4, ref('group_pao_sales_finance_commission'))]"/>
        <field name="perm_read">1</field>
        <field name="perm_write">1</field>
        <field name="perm_create">1</field>
        <field name="perm_unlink">1</field>
    </record>

    <!-- El Gerente de Comisiones necesita ver todo para decidir qué enviar
         a aprobación (no solo lo suyo, como el grupo "Consulta"). -->
    <record id="rule_pao_sales_commission_manager_all" model="ir.rule">
        <field name="name">Commissions: Manager oversees them all</field>
        <field name="model_id" ref="model_pao_sales_commission"/>
        <field name="domain_force">[(1, '=', 1)]</field>
        <field name="groups" eval="[(4, ref('group_pao_sales_commission_manager'))]"/>
        <field name="perm_read">1</field>
        <field name="perm_write">1</field>
        <field name="perm_create">0</field>
        <field name="perm_unlink">0</field>
    </record>

    <record id="rule_pao_sales_commission_line_manager_all" model="ir.rule">
        <field name="name">Commission lines: Manager oversees them all</field>
        <field name="model_id" ref="model_pao_sales_commission_line"/>
        <field name="domain_force">[(1, '=', 1)]</field>
        <field name="groups" eval="[(4, ref('group_pao_sales_commission_manager'))]"/>
        <field name="perm_read">1</field>
        <field name="perm_write">0</field>
        <field name="perm_create">0</field>
        <field name="perm_unlink">0</field>
    </record>
</odoo>
