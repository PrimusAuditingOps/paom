<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_pao_sales_commission_pay_wizard_form" model="ir.ui.view">
        <field name="name">pao.sales.commission.pay.wizard.form</field>
        <field name="model">pao.sales.commission.pay.wizard</field>
        <field name="arch" type="xml">
            <form string="Confirm Commission Payment(s)">
                <group>
                    <field name="comision_ids" widget="many2many_tags"
                           readonly="1"/>
                    <field name="payment_date"/>
                    <field name="payment_reference"/>
                    <field name="currency_id" invisible="1"/>
                    <field name="total_amount_mxn"/>
                    <field name="notes"/>
                </group>
                <footer>
                    <button name="action_confirm_payment" type="object"
                            string="Confirm Payment" class="btn-primary"/>
                    <button string="Cancel" class="btn-secondary" special="cancel"/>
                </footer>
            </form>
        </field>
    </record>

    <record id="action_pao_sales_commission_pay_wizard" model="ir.actions.act_window">
        <field name="name">Mark as Paid</field>
        <field name="res_model">pao.sales.commission.pay.wizard</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
        <field name="binding_model_id" ref="model_pao_sales_commission"/>
        <field name="binding_view_types">list,form</field>
    </record>
</odoo>
