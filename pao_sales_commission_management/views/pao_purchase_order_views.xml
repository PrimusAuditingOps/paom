<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_purchase_order_form_pao_sales_commission_management" model="ir.ui.view">
        <field name="name">purchase.order.form.pao_sales_commission_management</field>
        <field name="model">purchase.order</field>
        <field name="inherit_id" ref="purchase.purchase_order_form"/>
        <field name="arch" type="xml">
            <xpath expr="//div[hasclass('oe_button_box')]" position="inside">
                <field name="pao_sales_commission_ids" invisible="1"/>
                <button name="action_view_pao_sales_commissions" type="object"
                        class="oe_stat_button" icon="fa-usd"
                        invisible="not pao_sales_commission_ids">
                    <field name="pao_sales_commission_count" widget="statinfo"
                           string="Commissions"/>
                </button>
            </xpath>
        </field>
    </record>
</odoo>
