<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_order_form_pao_sales_commission_management" model="ir.ui.view">
        <field name="name">sale.order.form.pao_sales_commission_management</field>
        <field name="model">sale.order</field>
        <field name="inherit_id" ref="sale.view_order_form"/>
        <field name="arch" type="xml">
            <xpath expr="//div[hasclass('oe_button_box')]" position="inside">
                <field name="pao_sales_commission_ids" invisible="1"/>
                <button name="action_view_commissions" type="object"
                        class="oe_stat_button" icon="fa-usd"
                        invisible="not pao_sales_commission_ids">
                    <field name="pao_sales_commission_count" widget="statinfo"
                           string="Commission"/>
                </button>
            </xpath>
            <xpath expr="//field[@name='order_line']/tree/field[@name='price_unit']" position="after">
                <field name="pao_commission_payment" column_invisible="1"/>
                <field name="pao_promotor_id"
                       optional="hide"
                       readonly="not pao_commission_payment"
                       options="{'no_create': True, 'no_open': True}"/>
            </xpath>
        </field>
    </record>
</odoo>
