<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <template id="report_pao_payment_check_document">
        <t t-call="web.html_container">
            <t t-foreach="docs" t-as="o">
                <t t-set="lang" t-value="o.partner_id.lang or o.company_id.partner_id.lang"/>
                <t t-set="o" t-value="o.with_context(lang=lang)"/>
                <div class="page"> 
                    
                    <t t-set="current_date" t-value="context_timestamp(datetime.datetime.now())"/>
                    <t t-set="invoices" t-value="o.reconciled_invoice_ids or o.reconciled_bill_ids"/>
                    <t t-set="top_pos" t-value="1.7"/>
                    
                    <t t-foreach="invoices" t-as="inv">
                        
                        <div t-att-style="'position: absolute; top: %scm; left: 0.3cm; font-size: 8pt;' % top_pos">
                            <span t-field="inv.invoice_date"/>
                        </div>
                        <div t-att-style="'position: absolute; top: %scm; left: 2.3cm; font-size: 8pt;' % top_pos">
                            <span t-field="inv.pao_sage_folio_usa"/>
                        </div>
                        <div t-att-style="'position: absolute; top: %scm; left: 5cm; font-size: 8pt;' % top_pos">
                            <span t-field="inv.ref"/>
                        </div>
                        <div t-att-style="'position: absolute; top: %scm; left: 10.8cm; font-size: 8pt;' % top_pos">
                          
                            <span t-esc="'%.2f' % inv.amount_total"/>
                        </div>
                        <div t-att-style="'position: absolute; top:%scm; left: 13.6cm; font-size: 8pt;' % top_pos">
                            <span>0.00</span>
                        </div>
                        <div t-att-style="'position: absolute; top: %scm; left: 16.4cm; font-size: 8pt;' % top_pos">
                            <span t-esc="'%.2f' % inv.amount_total"/>
                        </div>
                        <t t-set="top_pos" t-value="top_pos + 1"/>
                    </t>
                    <!--
                    
                    -->
                    
                    <div style="position: absolute; top: 7.8cm; left: 1cm; font-size: 8pt;">
                        <span t-esc="('Check ' + o.ref.split('Check')[-1].strip().split(' ')[-1].zfill(10))"/>
                    </div>
                    <div style="position: absolute; top: 7.8cm; left: 5cm; font-size: 8pt;">
                        <span t-esc="o.date.strftime('%m/%d/%Y')"/>
                    </div>
                    <div style="position: absolute; top: 7.8cm; left: 7cm; font-size: 8pt;">
                        <span
                            t-attf-style="text-transform:uppercase; display:inline-block; white-space:nowrap; overflow:hidden; text-overflow:ellipsis; max-width:11cm;"
                            t-esc="(o.partner_id.name or '').replace('\n',' ')"/>
                    </div>
                    <div style="position: absolute; top: 7.8cm; left: 19cm; font-size: 8pt;">
                        <span t-esc="'%.2f' % o.amount"/>
                    </div>
                    
                    <!--
                    
                    -->
                    
                    <div style="position: absolute; top: 11.2cm; left: 2cm; font-size: 10pt; max-width: 7cm; word-wrap: break-word; overflow-wrap: anywhere;">
                        <span>*</span><span t-esc="o.pao_amount_to_text_check(o.amount)"/>
                    </div>
                    <div style="position: absolute; top: 12.2cm; left: 12.5cm; font-size: 8pt;">
                        <span t-esc="o.date.strftime('%m/%d/%Y')"/>
                    </div>
                    <div style="position: absolute; top: 12.2cm; left: 16.3cm; font-size: 8pt; ">
                        
                         <span t-esc="(('{:.2f}'.format(o.amount)).rjust(18, '*') + '*')"/>
                    </div>
                    <div style="position: absolute; top: 13.2cm; left: 2.5cm; font-size: 8pt;">
                        <div style="text-transform: uppercase;" t-field="o.partner_id" t-options="{&quot;widget&quot;: &quot;contact&quot;, &quot;fields&quot;: [&quot;address&quot;, &quot;name&quot;], &quot;no_marker&quot;: True}"/>
                    </div>
                    <!--
                    
                    -->
                    <t t-set="top_pos" t-value="18.5"/>
                    <t t-foreach="invoices" t-as="inv">
                        <div t-att-style="'position: absolute; top: %scm; left: 0.3cm; font-size: 8pt;' % top_pos">
                            <span t-field="inv.invoice_date"/>
                        </div>
                        <div t-att-style="'position: absolute; top: %scm; left: 2.3cm; font-size: 8pt;' % top_pos">
                            <span t-field="inv.pao_sage_folio_usa"/>
                        </div>
                        <div t-att-style="'position: absolute; top: %scm; left: 5cm; font-size: 8pt;' % top_pos">
                            <span t-field="inv.ref"/>
                        </div>
                        <div t-att-style="'position: absolute; top: %scm; left: 10.8cm; font-size: 8pt;' % top_pos">
                           <span t-esc="'%.2f' % inv.amount_total"/>
                        </div>
                        <div t-att-style="'position: absolute; top: %scm; left: 13.6cm; font-size: 8pt;' % top_pos">
                            <span>0.00</span>
                        </div>
                        <div t-att-style="'position: absolute; top: %scm; left: 16.4cm; font-size: 8pt;' % top_pos">
                            <span t-esc="'%.2f' % inv.amount_total"/>
                        </div>
                        <t t-set="top_pos" t-value="top_pos + 1"/>
                    </t>
                    <!--
                    
                    -->
                    
                    <div style="position: absolute; top: 24.8cm; left: 1cm; font-size: 8pt;">
                        <span t-esc="('Check ' + o.ref.split('Check')[-1].strip().split(' ')[-1].zfill(10))"/>
                    </div>
                    <div style="position: absolute; top: 24.8cm; left: 5cm; font-size: 8pt;">
                        
                       <span t-esc="o.date.strftime('%m/%d/%Y')"/>
                    </div>
                    <div style="position: absolute; top: 24.8cm; left: 7cm; font-size: 8pt;">
                        <span
                            t-attf-style="text-transform:uppercase; display:inline-block; white-space:nowrap; overflow:hidden; text-overflow:ellipsis; max-width:11cm;"
                            t-esc="(o.partner_id.name or '').replace('\n',' ')"/>
                    </div>
                    <div style="position: absolute; top: 24.8cm; left: 19cm; font-size: 8pt;">
                        <span t-esc="'%.2f' % o.amount"/>
                    </div>
                    
                   
                </div>
            </t>
        </t>
    </template>
</odoo>