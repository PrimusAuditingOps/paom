<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Expone osp_portal_only en la ficha de Usuario (Ajustes > Usuarios y
         Compañías > Usuarios), justo después del campo "login". Se había
         movido temporalmente a su propia pestaña del notebook por
         sospecha de choque con otro módulo del usuario — descartado: la
         causa real de los builds rotos fue la columna faltante en la base
         de datos (ver CONTEXT.md §34), no un conflicto de vistas. Se
         regresa al punto de inserción original a pedido del usuario.
         Solo tiene sentido para usuarios de portal (share = True) — en un
         usuario interno queda oculto, porque no aplica: el ocultamiento
         de /my es exclusivamente para portal. -->
    <record id="view_users_form_osp_portal_only" model="ir.ui.view">
        <field name="name">res.users.form.osp.portal.only</field>
        <field name="model">res.users</field>
        <field name="inherit_id" ref="base.view_users_form"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='login']" position="after">
                <div class="o_row" invisible="not share">
                    <field name="osp_portal_only"/>
                    <label for="osp_portal_only" string="Limited to Organic System Plans"/>
                </div>
            </xpath>
        </field>
    </record>
</odoo>
