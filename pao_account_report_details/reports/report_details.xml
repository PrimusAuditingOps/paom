<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <template id="account_invoice_report_details_inherit" inherit_id="account.report_invoice_document">
        <xpath expr="//th[@name='th_description']" position="after">
            <th name="th_audit_date" t-if="o.sale_order_count &gt; 0 and o.company_id.country_code == 'US' and o.audit_dates_available" class="text-start"><span>Audit Date</span></th>
        </xpath>

        <xpath expr="//td[@name='account_invoice_line_name']" position="after">
            <td name="td_audit_date" t-if="line.move_id.sale_order_count &gt; 0 and line.move_id.company_id.country_code == 'US' and line.move_id.audit_dates_available" class="text-end">
                <span t-field="line.sale_line_ids.audit_date"></span>
            </td>
        </xpath>
    </template>
</odoo>