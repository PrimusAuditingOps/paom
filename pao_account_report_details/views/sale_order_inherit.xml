<?xml version="1.0" encoding="utf-8" ?>
<odoo>
    <record id="sale_order_audit_date_line_view" model="ir.ui.view">
        <field name="name">sale.order.audit.date.line.view</field>
        <field name="model">sale.order</field>
        <field name="type">form</field>
        <field name="inherit_id" ref="servicereferralagreement.sale_order_purchase_view_form"/>
        <field name="arch" type="xml">
            <xpath expr="/form/sheet/notebook/page/field[@name='order_line']/tree/field[@name='service_end_date']" position="after">
                <field name="audit_date" column_invisible="parent.country_code != 'US'"/>
            </xpath>
        </field>
    </record>

    <record id="sale_order_audit_date_tree_view" model="ir.ui.view">
        <field name="name">sale.order.audit.date.tree.view</field>
        <field name="model">sale.order</field>
        <field name="type">tree</field>
        <field name="inherit_id" ref="sale.sale_order_tree"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='company_id']" position="after">
                <field name="audit_date" optional="hide"/>
            </xpath>
        </field>
    </record>
</odoo>