<?xml version="1.0" encoding="utf-8" ?>
<odoo>
    <record id="pao_mailing_contact_tag_view_form" model="ir.ui.view">
        <field name="name">pao.mailing.contact.tag.view.form</field>
        <field name="model">mailing.contact</field>
        <field name="type">form</field>
        <field name="inherit_id" ref="mass_mailing.mailing_contact_view_form"/>
        <field name="arch" type="xml">
            <field name="message_bounce" position="after">
                <field name="pao_tag_ids" widget="many2many_tags" options="{'color_field': 'color', 'no_create_edit': True}" placeholder='e.g. "B2B", "VIP", "Consulting", ...'/>
            </field>
        </field>
    </record>

    
</odoo>