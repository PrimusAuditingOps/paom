<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="account_move_navy_folio_view_form" model="ir.ui.view">
        <field name="name">account.move.navy.folio.view.form</field>
        <field name="model">account.move</field>
        <field name="inherit_id" ref="account.view_move_form"/>
        <field name="arch" type="xml">

            <xpath expr="//field[@name='partner_shipping_id']" position="before">
                <field name="country_code" invisible="1"/>
                <field name="pao_navy_folio" invisible="country_code != 'CR'"/>
            </xpath>

        </field>
    </record>
</odoo>