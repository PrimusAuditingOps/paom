<?xml version="1.0" encoding="utf-8" ?>
<odoo>
     <record id="purchase_order_hub_brc_audit_view_form" model="ir.ui.view">
        <field name="name">purchase.order.hub.brc.audit.view.form</field>
        <field name="model">purchase.order</field>
        <field name="type">form</field>
        <field name="inherit_id" ref="purchase.purchase_order_form"/>
        <field name="arch" type="xml">
            <group name="purchase_location" position="before">
                    <group name="hubbrc">
                        <field name="country_code" invisible="1"/>  
                        <field name="pao_hub_brc_type" invisible="country_code != 'CL'"/> 
                    </group>
            </group>
        </field>
    </record>
</odoo>