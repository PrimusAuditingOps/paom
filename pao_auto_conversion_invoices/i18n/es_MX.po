#. module: pao_auto_conversion_invoices
#. odoo-python
#: code:addons/pao_auto_conversion_invoices/models/account_move.py:0
#, python-format
msgid ""
"The invoice currency has been changed from USD to MXN. Use the \"Convert "
"Prices\" button to automatically apply the exchange rate to the invoice "
"lines."
msgstr ""
"La moneda de la factura ha sido cambiada de USD a MXN. Use el botón "
"\"Convertir precios\" para aplicar automáticamente el tipo de cambio a las "
"líneas de factura."

#. module: pao_auto_conversion_invoices
#: model_terms:ir.ui.view,arch_db:pao_auto_conversion_invoices.pao_account_move_custom_exchange_rate_view
msgid ""
"The invoice line prices will be converted to MXN using the exchange rate for"
" the invoice date. Continue?"
msgstr ""
"Los precios de las líneas de factura serán convertidos a MXN usando el tipo "
"de cambio de la fecha de factura. ¿Continuar?"

#. module: pao_auto_conversion_invoices
#: model_terms:ir.ui.view,arch_db:pao_auto_conversion_invoices.pao_account_move_custom_exchange_rate_view
msgid ""
"The invoice lines prices will be reverted to their original currency. "
"Continue?"
msgstr ""
"Las líneas de factura serán revertidas a su moneda original. ¿Continuar?"

#. module: pao_auto_conversion_invoices
