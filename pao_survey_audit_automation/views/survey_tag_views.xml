<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- ── COMPLIMENT TAGS ── -->

    <record id="view_survey_compliment_tag_tree" model="ir.ui.view">
        <field name="name">survey.compliment.tag.tree</field>
        <field name="model">survey.compliment.tag</field>
        <field name="arch" type="xml">
            <tree string="Compliment Tags" editable="bottom">
                <field name="name"/>
                <field name="color" widget="color_picker"/>
            </tree>
        </field>
    </record>

    <record id="view_survey_compliment_tag_form" model="ir.ui.view">
        <field name="name">survey.compliment.tag.form</field>
        <field name="model">survey.compliment.tag</field>
        <field name="arch" type="xml">
            <form string="Compliment Tag">
                <sheet>
                    <group>
                        <field name="name"/>
                        <field name="color" widget="color_picker"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_survey_compliment_tag" model="ir.actions.act_window">
        <field name="name">Compliment Tags</field>
        <field name="res_model">survey.compliment.tag</field>
        <field name="view_mode">tree,form</field>
    </record>

    <!-- ── COMPLAINT TAGS ── -->

    <record id="view_survey_complaint_tag_tree" model="ir.ui.view">
        <field name="name">survey.complaint.tag.tree</field>
        <field name="model">survey.complaint.tag</field>
        <field name="arch" type="xml">
            <tree string="Complaint Tags" editable="bottom">
                <field name="name"/>
                <field name="color" widget="color_picker"/>
            </tree>
        </field>
    </record>

    <record id="view_survey_complaint_tag_form" model="ir.ui.view">
        <field name="name">survey.complaint.tag.form</field>
        <field name="model">survey.complaint.tag</field>
        <field name="arch" type="xml">
            <form string="Complaint Tag">
                <sheet>
                    <group>
                        <field name="name"/>
                        <field name="color" widget="color_picker"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_survey_complaint_tag" model="ir.actions.act_window">
        <field name="name">Complaint Tags</field>
        <field name="res_model">survey.complaint.tag</field>
        <field name="view_mode">tree,form</field>
    </record>

</odoo>
