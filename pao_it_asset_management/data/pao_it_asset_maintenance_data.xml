<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">
        <!-- Referencia de mantenimientos: MNT/2026/0001 -->
        <record id="seq_pao_it_asset_maintenance" model="ir.sequence">
            <field name="name">IT Asset Maintenance</field>
            <field name="code">pao.it.asset.maintenance</field>
            <field name="prefix">MNT/%(year)s/</field>
            <field name="padding">4</field>
            <field name="company_id" eval="False"/>
        </record>

        <!-- Tarea diaria: asegura el siguiente preventivo de cada activo
             Available/Assigned de las categorías con preventivo. -->
        <record id="ir_cron_pao_it_plan_preventive" model="ir.cron">
            <field name="name">IT Asset Management: plan preventive maintenance</field>
            <field name="model_id" ref="model_pao_it_asset"/>
            <field name="state">code</field>
            <field name="code">model._cron_plan_preventive_maintenance()</field>
            <field name="interval_number">1</field>
            <field name="interval_type">days</field>
            <field name="numbercall">-1</field>
            <field name="doall" eval="False"/>
            <field name="active" eval="True"/>
        </record>
    </data>
</odoo>
