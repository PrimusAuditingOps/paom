<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- ========================================== -->
    <!-- ACTIVO DE HARDWARE                         -->
    <!-- ========================================== -->

    <record id="view_pao_it_asset_tree" model="ir.ui.view">
        <field name="name">pao.it.asset.tree</field>
        <field name="model">pao.it.asset</field>
        <field name="arch" type="xml">
            <tree string="Assets" sample="1">
                <field name="asset_tag"/>
                <field name="category_id"/>
                <field name="brand_id" optional="show"/>
                <field name="model_id" optional="show"/>
                <field name="serial_number" optional="show"/>
                <field name="company_id" optional="show" groups="base.group_multi_company"/>
                <field name="location_id" optional="show"/>
                <field name="location_type" optional="hide"/>
                <field name="employee_id" optional="show"/>
                <field name="department_id" optional="show"/>
                <field name="condition_id" optional="show"/>
                <field name="warranty_end" optional="hide"/>
                <field name="state" widget="badge"
                       decoration-success="state == 'available'"
                       decoration-info="state == 'assigned'"
                       decoration-warning="state in ('in_transit', 'in_repair')"
                       decoration-muted="state == 'retired'"
                       decoration-danger="state == 'lost'"/>
            </tree>
        </field>
    </record>

    <record id="view_pao_it_asset_kanban" model="ir.ui.view">
        <field name="name">pao.it.asset.kanban</field>
        <field name="model">pao.it.asset</field>
        <field name="arch" type="xml">
            <kanban sample="1">
                <field name="id"/>
                <field name="state"/>
                <templates>
                    <t t-name="kanban-box">
                        <div class="oe_kanban_global_click o_kanban_record_has_image_fill">
                            <div class="o_kanban_image_fill_left d-none d-md-block"
                                 t-attf-style="background-image: url(#{kanban_image('pao.it.asset', 'image_128', record.id.raw_value)})"/>
                            <div class="oe_kanban_details">
                                <strong class="o_kanban_record_title"><field name="asset_tag"/></strong>
                                <div><field name="category_id"/></div>
                                <div class="text-muted">
                                    <field name="brand_id"/> <field name="model_id"/>
                                </div>
                                <div t-if="record.employee_id.raw_value"><i class="fa fa-user me-1" title="Employee"/><field name="employee_id"/></div>
                                <div t-elif="record.department_id.raw_value"><i class="fa fa-users me-1" title="Department"/><field name="department_id"/></div>
                                <div class="mt-1">
                                    <field name="state" widget="badge"
                                           decoration-success="state == 'available'"
                                           decoration-info="state == 'assigned'"
                                           decoration-warning="state in ('in_transit', 'in_repair')"
                                           decoration-muted="state == 'retired'"
                                           decoration-danger="state == 'lost'"/>
                                </div>
                            </div>
                        </div>
                    </t>
                </templates>
            </kanban>
        </field>
    </record>

    <record id="view_pao_it_asset_form" model="ir.ui.view">
        <field name="name">pao.it.asset.form</field>
        <field name="model">pao.it.asset</field>
        <field name="arch" type="xml">
            <form string="Asset">
                <header>
                    <field name="state" widget="statusbar"
                           statusbar_visible="available,assigned,in_transit,in_repair"/>
                </header>
                <sheet>
                    <field name="image_1920" widget="image" class="oe_avatar"
                           options="{'preview_image': 'image_128'}"/>
                    <div class="oe_title">
                        <label for="asset_tag"/>
                        <h1><field name="asset_tag" placeholder="e.g. LPT-MX-076"/></h1>
                    </div>
                    <group>
                        <group string="Identification" name="identification">
                            <field name="category_id" options="{'no_create': True}"/>
                            <field name="requires_imei" invisible="1"/>
                            <field name="brand_id" options="{'no_create': True}"/>
                            <field name="model_id" options="{'no_create': True}"/>
                            <field name="condition_id" options="{'no_create': True}"/>
                        </group>
                        <group string="Location &amp; Responsible" name="location">
                            <field name="company_id" groups="base.group_multi_company"
                                   options="{'no_create': True}"/>
                            <field name="company_id" invisible="1" groups="!base.group_multi_company"/>
                            <field name="location_id" options="{'no_create': True}"/>
                            <field name="location_type"/>
                            <field name="employee_id" invisible="not employee_id"/>
                            <field name="assigned_department_id" invisible="not assigned_department_id"/>
                            <field name="department_id" invisible="not employee_id"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Details" name="details">
                            <group>
                                <group>
                                    <field name="serial_number"/>
                                    <field name="product_number"/>
                                    <field name="imei" invisible="not requires_imei"/>
                                </group>
                            </group>
                            <group string="Specifications">
                                <field name="specifications" nolabel="1" colspan="2"
                                       placeholder="e.g. Intel Core i5-1235U 1.30 GHz, 16 GB RAM, 256 GB SSD, 14&quot; FHD display, Windows 11 Pro"/>
                            </group>
                            <group string="Notes">
                                <field name="notes" nolabel="1" colspan="2"/>
                            </group>
                        </page>
                        <page string="Purchase" name="purchase">
                            <group>
                                <group>
                                    <field name="purchase_source" widget="radio"/>
                                    <!-- Con acceso a Compras: se elige la PO y su línea. -->
                                    <field name="purchase_order_id" groups="purchase.group_purchase_user"
                                           invisible="purchase_source != 'purchase_order'"
                                           required="purchase_source == 'purchase_order'"
                                           options="{'no_create': True}"/>
                                    <field name="purchase_line_id" groups="purchase.group_purchase_user"
                                           invisible="purchase_source != 'purchase_order' or not purchase_order_id"
                                           options="{'no_create': True}"/>
                                    <!-- Sin acceso a Compras: solo la referencia. -->
                                    <field name="purchase_order_ref" groups="!purchase.group_purchase_user"
                                           invisible="purchase_source != 'purchase_order'"/>
                                    <field name="vendor_id" invisible="purchase_source != 'purchase_order'"/>
                                    <field name="purchase_method_id" invisible="purchase_source != 'other'"
                                           required="purchase_source == 'other'"
                                           options="{'no_create': True}"/>
                                    <field name="payment_details" invisible="purchase_source != 'other'"/>
                                </group>
                                <group>
                                    <field name="purchase_date"/>
                                    <field name="purchase_cost"/>
                                    <field name="currency_id" options="{'no_create': True}"/>
                                    <field name="account_move_id"
                                           groups="account.group_account_invoice,account.group_account_readonly"
                                           options="{'no_create': True}"/>
                                    <field name="account_move_ref"
                                           groups="!account.group_account_invoice,!account.group_account_readonly"/>
                                </group>
                            </group>
                        </page>
                        <page string="Warranty" name="warranty">
                            <group>
                                <group>
                                    <field name="warranty_start"/>
                                    <field name="warranty_end"/>
                                    <field name="warranty_status" widget="badge"
                                           decoration-success="warranty_status == 'active'"
                                           decoration-warning="warranty_status == 'expiring'"
                                           decoration-danger="warranty_status == 'expired'"/>
                                </group>
                                <group>
                                    <field name="warranty_partner_id"/>
                                </group>
                            </group>
                            <group string="Coverage / Notes">
                                <field name="warranty_notes" nolabel="1" colspan="2"/>
                            </group>
                        </page>
                        <page string="Gallery" name="gallery">
                            <field name="image_ids" mode="kanban" context="{'default_asset_id': id}">
                                <kanban>
                                    <field name="name"/>
                                    <field name="date"/>
                                    <templates>
                                        <t t-name="kanban-box">
                                            <div class="oe_kanban_global_click">
                                                <field name="image_128" widget="image" class="d-block text-center"
                                                       options="{'size': [128, 128]}"/>
                                                <div class="mt-1"><strong><field name="name"/></strong></div>
                                                <div class="text-muted"><field name="date"/></div>
                                            </div>
                                        </t>
                                    </templates>
                                </kanban>
                                <form string="Photo">
                                    <sheet>
                                        <field name="image_1920" widget="image" class="oe_avatar"
                                               options="{'preview_image': 'image_512'}"/>
                                        <group>
                                            <field name="name"/>
                                            <field name="date"/>
                                            <field name="description"/>
                                        </group>
                                    </sheet>
                                </form>
                            </field>
                        </page>
                    </notebook>
                </sheet>
                <div class="oe_chatter">
                    <field name="message_follower_ids"/>
                    <field name="activity_ids"/>
                    <field name="message_ids"/>
                </div>
            </form>
        </field>
    </record>

    <record id="view_pao_it_asset_search" model="ir.ui.view">
        <field name="name">pao.it.asset.search</field>
        <field name="model">pao.it.asset</field>
        <field name="arch" type="xml">
            <search string="Assets">
                <field name="asset_tag"/>
                <field name="serial_number"/>
                <field name="imei"/>
                <field name="employee_id"/>
                <field name="department_id"/>
                <field name="purchase_order_ref" string="Purchase Order"/>
                <field name="category_id"/>
                <field name="brand_id"/>
                <field name="model_id"/>
                <!-- Por defecto se ocultan los estados finales. -->
                <filter string="Active Assets" name="active_assets"
                        domain="[('state', 'not in', ('retired', 'lost'))]"/>
                <separator/>
                <filter string="Available" name="available" domain="[('state', '=', 'available')]"/>
                <filter string="Assigned" name="assigned" domain="[('state', '=', 'assigned')]"/>
                <filter string="In Transit" name="in_transit" domain="[('state', '=', 'in_transit')]"/>
                <filter string="In Repair" name="in_repair" domain="[('state', '=', 'in_repair')]"/>
                <filter string="Retired" name="retired" domain="[('state', '=', 'retired')]"/>
                <filter string="Lost / Stolen" name="lost" domain="[('state', '=', 'lost')]"/>
                <separator/>
                <filter string="Office" name="office" domain="[('location_type', '=', 'office')]"/>
                <filter string="Home Office" name="home_office" domain="[('location_type', '=', 'home_office')]"/>
                <separator/>
                <filter string="Under Warranty" name="warranty_active" domain="[('warranty_status', '=', 'active')]"/>
                <filter string="Warranty Expiring" name="warranty_expiring" domain="[('warranty_status', '=', 'expiring')]"/>
                <filter string="Warranty Expired" name="warranty_expired" domain="[('warranty_status', '=', 'expired')]"/>
                <filter string="No Warranty" name="warranty_none" domain="[('warranty_status', '=', 'none')]"/>
                <separator/>
                <filter string="Unassigned" name="unassigned"
                        domain="[('employee_id', '=', False), ('assigned_department_id', '=', False)]"/>
                <group expand="0" string="Group By">
                    <filter string="Company" name="group_company" context="{'group_by': 'company_id'}"
                            groups="base.group_multi_company"/>
                    <filter string="Category" name="group_category" context="{'group_by': 'category_id'}"/>
                    <filter string="Brand" name="group_brand" context="{'group_by': 'brand_id'}"/>
                    <filter string="Model" name="group_model" context="{'group_by': 'model_id'}"/>
                    <filter string="Status" name="group_state" context="{'group_by': 'state'}"/>
                    <filter string="Condition" name="group_condition" context="{'group_by': 'condition_id'}"/>
                    <filter string="Location" name="group_location" context="{'group_by': 'location_id'}"/>
                    <filter string="Location Type" name="group_location_type" context="{'group_by': 'location_type'}"/>
                    <filter string="Department" name="group_department" context="{'group_by': 'department_id'}"/>
                    <filter string="Employee" name="group_employee" context="{'group_by': 'employee_id'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="action_pao_it_asset" model="ir.actions.act_window">
        <field name="name">Assets</field>
        <field name="res_model">pao.it.asset</field>
        <field name="view_mode">tree,kanban,form</field>
        <field name="context">{'search_default_active_assets': 1}</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">Register your first IT asset</p>
            <p>Laptops, desktops, servers, mobile phones, network equipment and any other device the IT team manages.</p>
        </field>
    </record>
</odoo>
