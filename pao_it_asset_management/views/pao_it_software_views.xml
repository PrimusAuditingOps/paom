<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- ========================================== -->
    <!-- CATÁLOGO DE SOFTWARE                       -->
    <!-- ========================================== -->

    <record id="view_pao_it_software_tree" model="ir.ui.view">
        <field name="name">pao.it.software.tree</field>
        <field name="model">pao.it.software</field>
        <field name="arch" type="xml">
            <tree string="Software Catalog">
                <field name="name"/>
                <field name="software_type_id"/>
                <field name="publisher" optional="show"/>
                <field name="subscription_count" optional="show"/>
            </tree>
        </field>
    </record>

    <record id="view_pao_it_software_form" model="ir.ui.view">
        <field name="name">pao.it.software.form</field>
        <field name="model">pao.it.software</field>
        <field name="arch" type="xml">
            <form string="Software">
                <sheet>
                    <div class="oe_button_box" name="button_box">
                        <button name="action_view_subscriptions" type="object" class="oe_stat_button"
                                icon="fa-key">
                            <field name="subscription_count" widget="statinfo" string="Subscriptions"/>
                        </button>
                    </div>
                    <widget name="web_ribbon" title="Archived" bg_color="text-bg-danger" invisible="active"/>
                    <field name="active" invisible="1"/>
                    <div class="oe_title">
                        <h1><field name="name" placeholder="e.g. Google Workspace"/></h1>
                    </div>
                    <group>
                        <group>
                            <field name="software_type_id" options="{'no_create': True}"/>
                            <field name="publisher"/>
                            <field name="website" widget="url"/>
                        </group>
                    </group>
                    <group string="Description">
                        <field name="description" nolabel="1" colspan="2"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="view_pao_it_software_search" model="ir.ui.view">
        <field name="name">pao.it.software.search</field>
        <field name="model">pao.it.software</field>
        <field name="arch" type="xml">
            <search>
                <field name="name"/>
                <field name="publisher"/>
                <field name="software_type_id"/>
                <filter string="Archived" name="archived" domain="[('active', '=', False)]"/>
                <group expand="0" string="Group By">
                    <filter string="Software Type" name="group_type" context="{'group_by': 'software_type_id'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="action_pao_it_software" model="ir.actions.act_window">
        <field name="name">Software Catalog</field>
        <field name="res_model">pao.it.software</field>
        <field name="view_mode">tree,form</field>
    </record>

    <!-- ========================================== -->
    <!-- PERIODOS                                   -->
    <!-- ========================================== -->

    <record id="view_pao_it_subscription_period_form" model="ir.ui.view">
        <field name="name">pao.it.subscription.period.form</field>
        <field name="model">pao.it.subscription.period</field>
        <field name="arch" type="xml">
            <form string="Subscription Period">
                <sheet>
                    <field name="license_type" invisible="1"/>
                    <field name="increase_comparable" invisible="1"/>
                    <field name="company_id" invisible="1"/>
                    <group>
                        <group string="Period">
                            <field name="subscription_id" readonly="id" options="{'no_create': True}"/>
                            <field name="start_date"/>
                            <field name="end_date" required="license_type != 'perpetual'"/>
                            <field name="contract_number"/>
                            <field name="billing_frequency"/>
                        </group>
                        <group string="Quantities">
                            <field name="licenses_purchased"/>
                            <field name="users_per_license"/>
                            <field name="allowed_users"/>
                        </group>
                    </group>
                    <group>
                        <group string="Cost">
                            <field name="currency_id" options="{'no_create': True}"/>
                            <field name="unit_cost" invisible="license_type != 'per_user'"/>
                            <field name="billing_amount" readonly="license_type == 'per_user'"/>
                            <field name="billing_count"/>
                            <field name="total_amount"/>
                        </group>
                        <group string="Change vs Previous Period" invisible="not increase_comparable">
                            <field name="previous_period_id"/>
                            <field name="unit_increase"/>
                            <field name="unit_increase_pct" string="Unit Price Change (%)"/>
                            <field name="total_increase"/>
                            <field name="total_increase_pct" string="Total Change (%)"/>
                        </group>
                    </group>
                    <group string="Purchase">
                        <group>
                            <field name="purchase_source" widget="radio"/>
                            <field name="purchase_order_id" groups="purchase.group_purchase_user"
                                   invisible="purchase_source != 'purchase_order'"
                                   options="{'no_create': True}"/>
                            <field name="purchase_line_id" groups="purchase.group_purchase_user"
                                   invisible="purchase_source != 'purchase_order' or not purchase_order_id"
                                   options="{'no_create': True}"/>
                            <field name="purchase_order_ref" groups="!purchase.group_purchase_user"
                                   invisible="purchase_source != 'purchase_order'"/>
                            <field name="vendor_id" invisible="purchase_source != 'purchase_order'"/>
                            <field name="purchase_method_id" invisible="purchase_source != 'other'"
                                   options="{'no_create': True}"/>
                            <field name="payment_details" invisible="purchase_source != 'other'"/>
                        </group>
                        <group>
                            <field name="account_move_id" options="{'no_create': True}"
                                   groups="account.group_account_invoice,account.group_account_readonly"
                                   invisible="purchase_source == 'purchase_order'"/>
                            <field name="account_move_ref"
                                   groups="!account.group_account_invoice,!account.group_account_readonly"
                                   invisible="purchase_source == 'purchase_order'"/>
                            <field name="purchase_move_summary"
                                   invisible="purchase_source != 'purchase_order'"/>
                        </group>
                    </group>
                    <group string="Notes &amp; Contract">
                        <field name="notes"/>
                        <field name="attachment_ids" widget="many2many_binary"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <!-- ========================================== -->
    <!-- SUSCRIPCIONES                              -->
    <!-- ========================================== -->

    <record id="view_pao_it_subscription_tree" model="ir.ui.view">
        <field name="name">pao.it.subscription.tree</field>
        <field name="model">pao.it.subscription</field>
        <field name="arch" type="xml">
            <tree string="Subscriptions" decoration-danger="over_capacity"
                  decoration-muted="state == 'cancelled'">
                <field name="over_capacity" column_invisible="True"/>
                <field name="software_id"/>
                <field name="plan"/>
                <field name="company_id" groups="base.group_multi_company"/>
                <field name="software_type_id" optional="hide"/>
                <field name="license_type" optional="show"/>
                <field name="auto_renew" optional="show"/>
                <field name="licenses_purchased" optional="show"/>
                <field name="allowed_users" optional="show"/>
                <field name="assigned_count" optional="show"/>
                <field name="current_end_date" optional="show"/>
                <field name="current_total" optional="show"/>
                <field name="currency_id" column_invisible="True"/>
                <field name="last_increase_unit_pct" optional="show" string="Last Unit Increase (%)"/>
                <field name="review_count" optional="hide"/>
                <field name="state" widget="badge"
                       decoration-success="state == 'active'"
                       decoration-info="state == 'renewing'"
                       decoration-warning="state in ('expiring', 'no_period')"
                       decoration-danger="state == 'expired'"
                       decoration-muted="state == 'cancelled'"/>
            </tree>
        </field>
    </record>

    <record id="view_pao_it_subscription_form" model="ir.ui.view">
        <field name="name">pao.it.subscription.form</field>
        <field name="model">pao.it.subscription</field>
        <field name="arch" type="xml">
            <form string="Subscription">
                <header>
                    <button name="action_renew" type="object" string="Renew" class="btn-primary"
                            invisible="cancelled or license_type == 'perpetual' or not period_ids"
                            groups="pao_it_asset_management.group_it_asset_admin"/>
                    <button name="action_cancel_subscription" type="object" string="Cancel Subscription"
                            invisible="cancelled or not id"
                            groups="pao_it_asset_management.group_it_asset_admin"/>
                    <button name="action_reactivate" type="object" string="Reactivate"
                            invisible="not cancelled"
                            groups="pao_it_asset_management.group_it_asset_admin"/>
                    <field name="state" widget="statusbar" statusbar_visible="active,renewing,expiring,expired"/>
                </header>
                <!-- Textos en <span> de una sola línea: así el término a
                     traducir queda limpio (sin saltos ni signos sueltos). -->
                <div class="alert alert-danger" role="alert" invisible="not over_capacity">
                    <span>More users are assigned than allowed by the current period:</span>
                    <field name="assigned_count" class="oe_inline" readonly="1"/> / <field name="allowed_users" class="oe_inline" readonly="1"/>
                </div>
                <div class="alert alert-warning" role="alert" invisible="not review_count">
                    <span>Assignments of archived employees to review (free those licenses):</span>
                    <field name="review_count" class="oe_inline" readonly="1"/>
                </div>
                <div class="alert alert-secondary" role="alert" invisible="not cancelled">
                    <span>Cancelled on</span>
                    <field name="cancel_date" class="oe_inline" readonly="1"/> — <field name="cancel_reason" class="oe_inline" readonly="1"/>
                </div>
                <sheet>
                    <field name="cancelled" invisible="1"/>
                    <field name="over_capacity" invisible="1"/>
                    <div class="oe_title">
                        <label for="software_id"/>
                        <h1><field name="software_id" options="{'no_create': True}" readonly="id"/></h1>
                        <h3><field name="plan" placeholder="Plan / Edition, e.g. Business Plus"/></h3>
                    </div>
                    <group>
                        <group>
                            <field name="company_id" groups="base.group_multi_company"
                                   readonly="id" options="{'no_create': True}"/>
                            <field name="company_id" invisible="1" groups="!base.group_multi_company"/>
                            <field name="software_type_id"/>
                            <field name="license_type"/>
                            <field name="auto_renew"/>
                            <field name="expected_increase_pct" invisible="not auto_renew"/>
                        </group>
                        <group string="Current Period">
                            <field name="current_start_date"/>
                            <field name="current_end_date"/>
                            <field name="current_total"/>
                            <field name="currency_id" invisible="1"/>
                            <field name="licenses_purchased"/>
                            <field name="allowed_users" string="Allowed Users"/>
                            <field name="assigned_count"/>
                            <field name="available_count"/>
                            <field name="last_increase_unit_pct" string="Last Unit Increase (%)"/>
                            <field name="last_increase_total_pct" string="Last Total Increase (%)"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Periods" name="periods">
                            <field name="period_ids" context="{'default_subscription_id': id}">
                                <tree>
                                    <field name="start_date"/>
                                    <field name="end_date"/>
                                    <field name="billing_frequency"/>
                                    <field name="licenses_purchased"/>
                                    <field name="users_per_license" optional="show"/>
                                    <field name="allowed_users"/>
                                    <field name="unit_cost"/>
                                    <field name="billing_amount"/>
                                    <field name="total_amount"/>
                                    <field name="currency_id"/>
                                    <field name="unit_increase_pct" string="Unit Δ %"/>
                                    <field name="total_increase_pct" string="Total Δ %"/>
                                    <button name="action_price_change" type="object" string="Price Change"
                                            icon="fa-line-chart"
                                            groups="pao_it_asset_management.group_it_asset_admin"/>
                                </tree>
                            </field>
                        </page>
                        <page string="Assignments" name="assignments">
                            <field name="assignment_ids" context="{'pao_it_show_company': True}">
                                <tree editable="bottom" decoration-muted="state == 'closed'"
                                      decoration-danger="to_review">
                                    <field name="assignee_type"/>
                                    <field name="employee_id" options="{'no_create': True}"
                                           context="{'pao_it_show_company': True}"
                                           invisible="assignee_type != 'employee'"
                                           required="assignee_type == 'employee'"
                                           readonly="state == 'closed'"/>
                                    <!-- Una sola columna de departamento: en renglones de
                                         empleado muestra el de RR. HH. (solo lectura); en
                                         renglones de departamento es el que se captura. -->
                                    <field name="department_id" column_invisible="True"/>
                                    <field name="effective_department_id" string="Department"
                                           options="{'no_create': True}"
                                           context="{'pao_it_show_company': True}"
                                           required="assignee_type == 'department'"
                                           readonly="state == 'closed' or assignee_type == 'employee'"/>
                                    <field name="date_start" readonly="state == 'closed'"/>
                                    <field name="date_end" readonly="state == 'closed'"/>
                                    <field name="notes"/>
                                    <field name="to_review"/>
                                    <field name="state" widget="badge"
                                           decoration-success="state == 'active'"
                                           decoration-muted="state == 'closed'"/>
                                    <button name="action_close" type="object" string="Close" icon="fa-times-circle"
                                            invisible="state != 'active'"
                                            groups="pao_it_asset_management.group_it_asset_admin"/>
                                </tree>
                            </field>
                        </page>
                        <page string="Analytic &amp; Justification" name="analytic">
                            <group>
                                <field name="analytic_precision" invisible="1"/>
                                <field name="analytic_distribution" widget="analytic_distribution"
                                       groups="analytic.group_analytic_accounting"
                                       options="{'business_domain': 'general'}"/>
                                <field name="description"/>
                                <field name="justification"/>
                            </group>
                        </page>
                        <page string="License Keys" name="license_keys"
                              groups="pao_it_asset_management.group_it_asset_admin">
                            <field name="license_keys" placeholder="Activation / license keys. Never store passwords here."/>
                        </page>
                        <page string="Notes" name="notes">
                            <field name="notes"/>
                        </page>
                    </notebook>
                </sheet>
                <div class="oe_chatter">
                    <field name="message_follower_ids"/>
                    <field name="activity_ids"/>
                    <field name="message_ids"/>
                </div>
            </form>
        </field>
    </record>

    <record id="view_pao_it_subscription_search" model="ir.ui.view">
        <field name="name">pao.it.subscription.search</field>
        <field name="model">pao.it.subscription</field>
        <field name="arch" type="xml">
            <search string="Subscriptions">
                <field name="software_id"/>
                <field name="plan"/>
                <field name="software_type_id"/>
                <filter string="Active" name="active_state" domain="[('state', '=', 'active')]"/>
                <filter string="Renewing Soon" name="renewing" domain="[('state', '=', 'renewing')]"/>
                <filter string="Expiring Soon" name="expiring" domain="[('state', '=', 'expiring')]"/>
                <filter string="Expired" name="expired" domain="[('state', '=', 'expired')]"/>
                <filter string="Cancelled" name="cancelled" domain="[('state', '=', 'cancelled')]"/>
                <filter string="No Period" name="no_period" domain="[('state', '=', 'no_period')]"/>
                <separator/>
                <filter string="Not Cancelled" name="not_cancelled" domain="[('cancelled', '=', False)]"/>
                <separator/>
                <filter string="Auto-Renew" name="auto_renew" domain="[('auto_renew', '=', True)]"/>
                <filter string="Over Capacity" name="over_capacity" domain="[('over_capacity', '=', True)]"/>
                <filter string="Assignments to Review" name="to_review" domain="[('review_count', '>', 0)]"/>
                <filter string="Price Increased" name="price_increased" domain="[('has_price_increase', '=', True)]"/>
                <separator/>
                <filter string="Per User" name="per_user" domain="[('license_type', '=', 'per_user')]"/>
                <filter string="Flat Fee" name="flat_fee" domain="[('license_type', '=', 'flat_fee')]"/>
                <filter string="Perpetual" name="perpetual" domain="[('license_type', '=', 'perpetual')]"/>
                <group expand="0" string="Group By">
                    <filter string="Company" name="group_company" context="{'group_by': 'company_id'}"
                            groups="base.group_multi_company"/>
                    <filter string="Software" name="group_software" context="{'group_by': 'software_id'}"/>
                    <filter string="Software Type" name="group_type" context="{'group_by': 'software_type_id'}"/>
                    <filter string="License Type" name="group_license_type" context="{'group_by': 'license_type'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="action_pao_it_subscription" model="ir.actions.act_window">
        <field name="name">Subscriptions</field>
        <field name="res_model">pao.it.subscription</field>
        <field name="view_mode">tree,form</field>
        <field name="context">{'search_default_not_cancelled': 1, 'pao_it_show_company': True}</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">Register your first software subscription</p>
            <p>One subscription per software, plan and company. Its costs are registered by period (contract cycle).</p>
        </field>
    </record>

    <!-- ========================================== -->
    <!-- ASIGNACIONES DE LICENCIAS                  -->
    <!-- ========================================== -->

    <record id="view_pao_it_license_assignment_tree" model="ir.ui.view">
        <field name="name">pao.it.license.assignment.tree</field>
        <field name="model">pao.it.license.assignment</field>
        <field name="arch" type="xml">
            <tree string="License Assignments" create="0" decoration-muted="state == 'closed'"
                  decoration-danger="to_review">
                <field name="subscription_id"/>
                <field name="software_id" optional="hide"/>
                <field name="responsible"/>
                <field name="effective_department_id" optional="show"/>
                <field name="company_id" optional="show" groups="base.group_multi_company"/>
                <field name="date_start"/>
                <field name="date_end"/>
                <field name="to_review"/>
                <field name="state" widget="badge"
                       decoration-success="state == 'active'"
                       decoration-muted="state == 'closed'"/>
                <button name="action_close" type="object" string="Close" icon="fa-times-circle"
                        invisible="state != 'active'"
                        groups="pao_it_asset_management.group_it_asset_admin"/>
            </tree>
        </field>
    </record>

    <record id="view_pao_it_license_assignment_search" model="ir.ui.view">
        <field name="name">pao.it.license.assignment.search</field>
        <field name="model">pao.it.license.assignment</field>
        <field name="arch" type="xml">
            <search string="License Assignments">
                <field name="employee_id"/>
                <field name="effective_department_id"/>
                <field name="subscription_id"/>
                <field name="software_id"/>
                <filter string="Active" name="active_state" domain="[('state', '=', 'active')]"/>
                <filter string="Closed" name="closed" domain="[('state', '=', 'closed')]"/>
                <separator/>
                <filter string="To Review" name="to_review" domain="[('to_review', '=', True)]"/>
                <group expand="0" string="Group By">
                    <filter string="Employee" name="group_employee" context="{'group_by': 'employee_id'}"/>
                    <filter string="Department" name="group_department"
                            context="{'group_by': 'effective_department_id'}"/>
                    <filter string="Subscription" name="group_subscription" context="{'group_by': 'subscription_id'}"/>
                    <filter string="Software" name="group_software" context="{'group_by': 'software_id'}"/>
                    <filter string="Company" name="group_company" context="{'group_by': 'company_id'}"
                            groups="base.group_multi_company"/>
                </group>
            </search>
        </field>
    </record>

    <record id="action_pao_it_license_assignment" model="ir.actions.act_window">
        <field name="name">License Assignments</field>
        <field name="res_model">pao.it.license.assignment</field>
        <field name="view_mode">tree</field>
        <field name="context">{'search_default_active_state': 1, 'pao_it_show_company': True}</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_empty_folder">No license assignments yet</p>
            <p>Assignments are registered from each subscription (Assignments tab).</p>
        </field>
    </record>

    <!-- ========================================== -->
    <!-- VENTANAS                                   -->
    <!-- ========================================== -->

    <record id="view_pao_it_subscription_price_wizard_form" model="ir.ui.view">
        <field name="name">pao.it.subscription.price.wizard.form</field>
        <field name="model">pao.it.subscription.price.wizard</field>
        <field name="arch" type="xml">
            <form string="Price Change">
                <p class="text-muted">The period will be split at the effective date: the previous part keeps its price, the new part takes the new price.</p>
                <group>
                    <field name="period_id" readonly="1"/>
                    <field name="license_type" invisible="1"/>
                    <field name="currency_id" invisible="1"/>
                    <field name="effective_date"/>
                    <field name="new_unit_cost" invisible="license_type != 'per_user'"/>
                    <field name="new_billing_amount" invisible="license_type == 'per_user'"/>
                </group>
                <footer>
                    <button name="action_confirm" type="object" string="Confirm" class="btn-primary"
                            data-hotkey="q"/>
                    <button string="Cancel" class="btn-secondary" special="cancel" data-hotkey="x"/>
                </footer>
            </form>
        </field>
    </record>

    <record id="view_pao_it_subscription_cancel_wizard_form" model="ir.ui.view">
        <field name="name">pao.it.subscription.cancel.wizard.form</field>
        <field name="model">pao.it.subscription.cancel.wizard</field>
        <field name="arch" type="xml">
            <form string="Cancel Subscription">
                <p class="text-muted">Its open license assignments will be closed on the cancellation date. Its periods are kept as spending history.</p>
                <group>
                    <field name="subscription_id" readonly="1"/>
                    <field name="cancel_date"/>
                    <field name="reason"/>
                </group>
                <footer>
                    <button name="action_confirm" type="object" string="Confirm" class="btn-primary"
                            data-hotkey="q"/>
                    <button string="Cancel" class="btn-secondary" special="cancel" data-hotkey="x"/>
                </footer>
            </form>
        </field>
    </record>
</odoo>
