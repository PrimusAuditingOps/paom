<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="resource_calendar_form_inherit_attendance_restriction" model="ir.ui.view">
        <field name="name">resource.calendar.form.inherit.attendance.restriction</field>
        <field name="model">resource.calendar</field>
        <field name="inherit_id" ref="resource.resource_calendar_form"/>
        <field name="arch" type="xml">
            <xpath expr="//notebook" position="inside">
                <page string="Attendance Restriction" name="attendance_restriction">
                    <group>
                        <group>
                            <field name="attendance_restrict_schedule"/>
                            <field name="attendance_checkin_tolerance" invisible="not attendance_restrict_schedule"/>
                            <field name="attendance_checkout_tolerance" invisible="not attendance_restrict_schedule"/>
                        </group>
                    </group>
                </page>
            </xpath>
        </field>
    </record>
</odoo>
