<?xml version="1.0" encoding="utf-8" ?>
<odoo>


    <record id="pao_sat_cfdi_xml_view_form" model="ir.ui.view">
        <field name="name">pao.sat.cfdi.xml.view.form</field>
        <field name="model">pao.sat.cfdi.xml</field>
        <field name="arch" type="xml">
            <form string="SAT CFDI XML">
               <header>
                    <field name="state" widget="statusbar" />
                </header>
                <sheet>
                    <group>
                         <group>
                            <field name="name"/>
                        </group>
                        <group>
                            <field name="vendor_vat"/>
                        </group>
                        <group>
                            <field name="vendor_name"/>
                        </group>
                        <group>
                            <field name="customer_name"/>
                        </group>
                        <group>
                            <field name="cfdi_date"/>
                        </group>
                        <group>
                            <field name="total"/>
                        </group>
                         <group>
                            <field name="subtotal"/>
                        </group>
                        <group>
                            <field name="currency"/>
                        </group>
                        <group>
                            <field name="type_of_receipt"/>
                        </group>
                        <group>
                            <field name="xml_file" readonly="1"/>
                        </group>
                        
                    </group>
                    <notebook>
                        <page string="Products/Services">
                            <field name="pao_line_ids" widget="many2many">
                                <tree string="Products/Services">
                                    <field name="prod_serv_key"/>
                                    <field name="description"/>
                                    <field name="quantity"/>
                                    <field name="unity_key"/>
                                    <field name="unity"/>
                                    <field name="unit_value"/>
                                    <field name="amount"/>
                                    <field name="tax_object"/>
                                    <field name="output_tax"/>
                                    <field name="withholding_tax"/>
                                </tree>
                            </field>
                        </page>
                    </notebook>
                    <notebook>
                        <page string="XML">
                            <group>
                                <field name="xml_text" widget="text" nolabel="1" readonly="1" style="font-family: monospace; height: 400px;"/>
                            </group>
                            
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <record id="pao_sat_cfdi_xml_view_tree" model="ir.ui.view">
        <field name="name">pao.sat.cfdi.xml.view.tree</field>
        <field name="model">pao.sat.cfdi.xml</field>
        <field name="arch" type="xml">
            <tree string="SAT CFDI XML">
                    <field name="cfdi_date"/>
                    <field name="name"/>
                    <field name="vendor_vat"/>
                    <field name="vendor_name"/>
                    <field name="customer_name"/>
                    <field name="subtotal"/>
                    <field name="total"/>
            </tree>
        </field>
    </record>


    <record id="pao_sat_cfdi_xml_action" model="ir.actions.act_window">
        <field name="name">SAT CFDI XML</field>
        <field name="res_model">pao.sat.cfdi.xml</field>
        <field name="view_mode">tree,form</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">Create first SAT CFDI XML
            </p>
        </field>
    </record>

    <menuitem id="pao_sat_cfdi_xml_option"
            name="SAT CFDI XML"
            parent="account.menu_finance_payables"
            action="pao_sat_cfdi_xml_action"
            sequence="80"/>

</odoo>