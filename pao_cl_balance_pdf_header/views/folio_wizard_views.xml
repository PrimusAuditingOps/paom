<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="pao_cl_balance_folio_wizard_form" model="ir.ui.view">
        <field name="name">pao.cl.balance.folio.wizard.form</field>
        <field name="model">pao.cl.balance.folio.wizard</field>
        <field name="arch" type="xml">
            <form>
                <group>
                    <field name="folio" placeholder="Opcional: si lo dejas vacío no aparece en el PDF"/>
                </group>
                <footer>
                    <button name="action_print_pdf" type="object" string="Imprimir PDF" class="btn-primary"/>
                    <button special="cancel" string="Cancelar" class="btn-secondary"/>
                </footer>
            </form>
        </field>
    </record>
</odoo>
