<odoo>
    <record id="ir_cron_qa_assessment" model="ir.cron">
        <field name="name">QA: Generate upcoming assessments</field>
        <field name="model_id" ref="model_pao_qa_assessments"/>
        <field name="state">code</field>
        <field name="code">model._cron_generate_due_assessments()</field>
        <field name="interval_number">1</field>
        <field name="interval_type">days</field>
        <field name="numbercall">-1</field>
        <field name="active">True</field>
    </record>
</odoo>
