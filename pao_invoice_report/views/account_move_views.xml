<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_move_form_custom_rate" model="ir.ui.view">
        <field name="name">account.move.form.l10n.cl.custom.rate</field>
        <field name="model">account.move</field>
        <field name="inherit_id" ref="account.view_move_form"/>
        <field name="arch" type="xml">
            <!-- Se inserta justo después del bloque Diario/Moneda del
            encabezado de la factura. Solo tiene sentido cuando la
            factura está en una moneda distinta a la de la compañía. -->
            <div name="journal_div" position="after">
                <field name="pao_use_custom_rate" groups="base.group_multi_currency" invisible="currency_id == company_currency_id or country_code != 'CL'" readonly="state != 'draft'"/>
                <field name="pao_custom_rate" groups="base.group_multi_currency" invisible="not pao_use_custom_rate or currency_id == company_currency_id or country_code != 'CL'" required="pao_use_custom_rate" readonly="state != 'draft'"/>
            </div>

        </field>
    </record>

</odoo>
